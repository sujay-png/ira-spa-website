<section class="sanctuary">

    <div class="container">

        <span class="small-title">
            SANCTUARY ETIQUETTE
        </span>

        <h2>
            The Art of Relaxing
        </h2>

        <p class="intro">
            To honor the sanctity of your time with us, we suggest complete presence.
            Unless specified otherwise, undress comfortably and wear the provided spa
            garments. Our therapists are masters of discreet draping, ensuring your
            dignity and comfort are preserved at every stage of your treatment.
        </p>

        <div class="quote-card">

            <div class="icon">
                ❀
            </div>

            <blockquote  style="color: var(--text-color, #ffffff)">
                "Close your eyes and allow your mind and body to be quiet.
                Breathe deeply and let tension slip away with each breath."
            </blockquote>

            <span class="footer">
                THIS TIME IS SACRED. THIS TIME IS YOURS.
            </span>

        </div>

    </div>

</section>

<style>

/*
  This section is an intentional fixed gold "callout band" — it keeps
  the same gold background and white/light text regardless of theme,
  the same way the badge and photo-overlay text elsewhere on this site
  stay fixed. Don't swap these for --bg-color/--text-color, or white
  text could end up on a background that's no longer gold.
*/
.sanctuary{

   
    color:--var(--text-color, #ffffff);
    padding:120px 20px;
}

.container{

    width:90%;
    max-width:1100px;
    margin:auto;
    text-align:center;
}

.small-title{

    display:block;

    color:#cfa23c;

    letter-spacing:6px;

    font-size:13px;

    font-weight:600;

    margin-bottom:25px;
}

h2{

    font-size:70px;

    font-family:Georgia, serif;

    font-style:italic;

    font-weight:500;

    margin-bottom:30px;
    background-color:var(--bg-color, #ffffff);
}

.intro{

    max-width:720px;

    margin:auto;

    color:--var(--text-color, #1a1a1a);

    line-height:1.8;

    font-size:19px;

    margin-bottom:80px;
}

.quote-card{

    background:--var(--accent-color,   #181818);

    padding:80px 60px;

    max-width:900px;

    margin:auto;

    transition:.4s;

    border:1px solid rgba(255,255,255,.05);
}

.quote-card:hover{

    transform:translateY(-8px);

    box-shadow:0 25px 60px rgba(0,0,0,.35);
}

.icon{

    color:#cfa23c;

    font-size:48px;

    margin-bottom:35px;
}

blockquote{

    font-size:52px;

    font-family:Georgia, serif;

    font-style:italic;

    line-height:1.35;

    color:#fff;

    margin:0 auto 45px;

    max-width:700px;
}

.footer{

    display:block;

    color:#cfa23c;

    letter-spacing:6px;

    font-size:14px;

    font-weight:600;
}

@media(max-width:900px){

h2{

    font-size:48px;
}

blockquote{

    font-size:36px;
}

.quote-card{

    padding:60px 30px;
}

}

@media(max-width:600px){

.sanctuary{

    padding:80px 20px;
}

h2{

    font-size:38px;
}

.intro{

    font-size:16px;
}

blockquote{

    font-size:28px;
}

.footer{

    letter-spacing:3px;

    font-size:12px;
}

}

</style>