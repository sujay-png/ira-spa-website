---

<section class="origin">
	<div class="container origin__grid">
		<div class="origin__content">
			<span class="eyebrow reveal">The Story Of Ira
				
			</span>

			<blockquote class="reveal">
				"The original Sanskrit word <strong>Ira</strong> translates to
				<strong> the earth.</strong>"
			</blockquote>

			<p class="reveal">
		 IRA offers natural well-being experiences in a calm atmosphere,
			 allowing you to slow down and balance the wellness of your soul. As a trusted Mangalore Massage Centre, 
			</p>

			<p class="reveal">
		 IRA Spa has been a well-known destination since 2014, serving over a million customers across India.
		  Our premium quality attracts people worldwide, and that is our promise to you.
		   At IRA, you can choose from a variety of organic spa treatments, including facials, massage therapy, body treatments, and hair care services. 
		   We focus on natural and organic treatments that are gentle, ensuring long-term health, beauty, and holistic wellness.

			</p>

			
		</div>

		<div class="origin__media reveal">
			<img src="/images/spa-salon.jpg" alt="Ira Spa treatment room" width="640" height="760" loading="lazy" />
		</div>
	</div>
</section>

<style>
	.origin {
		padding-block: var(--space-2xl);
	}

	.origin__grid {
		display: grid;
		grid-template-columns: 1fr 0.9fr;
		gap: clamp(2.5rem, 6vw, 5rem);
		align-items: center;
	}

	.origin__content blockquote {
		font-family: var(--font-display);
		font-style: italic;
		font-size: clamp(1.4rem, 2.6vw, 2rem);
		color: var(--color-accent-soft);
		line-height: 1.5;
		margin: var(--space-sm) 0 var(--space-md);

		strong {
			font-style: normal;
			color: var(--color-text);
		}
	}

	.origin__content p {
		margin-bottom: var(--space-sm);
	}

	.origin__content .link-arrow {
		margin-top: var(--space-xs);
	}

	.origin__media img {
		width: 100%;
		height: clamp(320px, 42vw, 560px);
		object-fit: cover;
		border-radius: var(--radius-md);
	}

	@media (max-width: 900px) {
		.origin__grid {
			grid-template-columns: 1fr;
		}
		.origin__media {
			order: -1;
		}
	}
</style>

<script>
	function initReveal() {
		const items = document.querySelectorAll(".origin .reveal");
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry, ) => {
					if (entry.isIntersecting) {
						const index = [...items].indexOf(entry.target as Element);
						setTimeout(() => entry.target.classList.add("is-visible"), index * 120);
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.2 },
		);
		items.forEach((item) => observer.observe(item));
	}
	initReveal();
	document.addEventListener("astro:page-load", initReveal);
</script>
