<section class="origin-section">
  <div class="container">

    <div class="left-content">

      <span class="subtitle animate">THE ORIGIN</span>

      <h1>Rooted in the Earth</h1>

      <h2 class="animated">
        "The original Sanskrit word <strong>IRA</strong>
        translates to <strong>THE EARTH.</strong>"
      </h2>

      <p class="animate">
        Since our inception in 2014, IRA Wellness has stood as a
        sanctuary of peace and holistic healing. We offer natural
        wellness experiences that invite you to slow down,
        reconnect with yourself, and discover the balance of
        mind, body, and soul.
      </p>

      <p class="animate">
        Located in Mangalore, IRA has welcomed thousands of guests
        seeking premium spa treatments, rejuvenating therapies,
        and restorative wellness rituals. Every experience is
        designed to nurture relaxation and lasting wellbeing.
      </p>

       <a href="/services" class="btn animate">
    Explore Rituals
    <span>→</span>
  </a>

    </div>

   <div class="right-image animate">
  <img src="src/images/Aboutus_story.webp" alt="Spa Therapy" />
</div>

  </div>
</section>

<style>

    .animate{
    opacity:0;
    transform:translateY(60px);
    transition:
        opacity .8s ease,
        transform .8s ease;
}

.animate.show{
    opacity:1;
    transform:translateY(0);
}

.right-image.animate{
    transform:translateX(80px);
}

.right-image.animate.show{
    transform:translateX(0);
}

.origin-section{
    background:var(--bg-color, #ffffff);
    padding:90px 0;
}

.container{
    width:90%;
    max-width:1300px;
    margin:auto;

    display:grid;
    grid-template-columns:1fr 1fr;
    gap:70px;
    align-items:center;
}

.subtitle{
    display:block;
    color:var(--accent-color, #cfa23c);
    letter-spacing:5px;
    font-size:14px;
    font-weight:600;
    margin-bottom:25px;
}

h1{
    font-size:72px;
    color:var(--text-color, #1a1a1a);
    line-height:1.1;
    margin-bottom:35px;
    font-family:Georgia, serif;
    font-weight:500;
}

h2{
    font-size:30px;
    line-height:1.6;
    color:var(--accent-color, #cfa23c);
    font-family:Georgia, serif;
    font-style:italic;
    font-weight:400;
    margin-bottom:35px;
}

h2 strong{
    color:var(--text-color, #1a1a1a);
    font-style:normal;
}

p{
    color:var(--text-color, #1a1a1a);
    font-size:18px;
    line-height:1.9;
    margin-bottom:28px;
}

.btn{
    display:inline-flex;
    align-items:center;
    gap:20px;

    margin-top:25px;

    text-decoration:none;
    text-transform:uppercase;
    letter-spacing:4px;

    color:var(--accent-color, #cfa23c);
    font-size:15px;
    font-weight:600;

    transition:.3s;
}

.btn span{
    font-size:24px;
    transition:.3s;
}

.btn:hover span{
    transform:translateX(8px);
}

.right-image img{
    width:100%;
    height:700px;
    object-fit:cover;
    border-radius:8px;
    display:block;
    box-shadow:0 20px 45px rgba(0,0,0,.08);
}

@media(max-width:991px){

.container{
    grid-template-columns:1fr;
}

.right-image{
    order:-1;
}

h1{
    font-size:48px;
}

h2{
    font-size:24px;
}

.right-image img{
    height:500px;
}

}

@media(max-width:600px){

.origin-section{
    padding:60px 0;
}

.container{
    width:92%;
    gap:40px;
}

h1{
    font-size:38px;
}

h2{
    font-size:21px;
}

p{
    font-size:16px;
}

.right-image img{
    height:380px;
}

}

</style>

<script>
document.addEventListener("DOMContentLoaded", () => {

  const items = document.querySelectorAll(".animate");

  const observer = new IntersectionObserver((entries) => {

    entries.forEach((entry) => {

      if (entry.isIntersecting) {

        const index = [...items].indexOf(entry.target);

        setTimeout(() => {
          entry.target.classList.add("show");
        }, index * 150);

        observer.unobserve(entry.target);
      }

    });

  }, {
    threshold: 0.2
  });

  items.forEach(item => observer.observe(item));

});
</script>