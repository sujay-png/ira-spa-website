---
const pillars = [
	{
		title: "Our Vision",
		text: "IRA SPA being the best option for people to achieve optimal attention and care for their body and needs we promotes healthy lifestyle where body, mind and spirit have a harmonious fusion of rejuvenation and revitalization.",
	},
	{
		title: "Our Mission",
		text: "Our mission is to create all natural, luxurious experiences for you to relax and achieve wellbeing health and beauty. We provide exceptional spa experiences and we strive to create a warm and welcoming environment, where our guests feel valued, relaxed, and rejuvenated. We are well known for the ancient techniques and steps of services with modern touch. Experienced therapists’ services and hygienic atmosphere will make you feel like you are a new person.",
	},
	{
		title: "Our Promise",
		text: "Every guest leaves feeling valued, relaxed and renewed — that is the standard we hold ourselves to at every visit, at every location.",
	},
];
---

<section class="pillars">
	<div class="container">
		<div class="section-heading">
			<span class="eyebrow">Our Foundation</span>
			<h2>Vision &amp; Mission</h2>
			<div class="ornament" aria-hidden="true"><span></span></div>
		</div>

		<div class="pillars__grid">
			{
				pillars.map((p) => (
					<div class="pillar">
						<h3>{p.title}</h3>
						<p>{p.text}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.pillars {
		padding-block: var(--space-2xl);
		background: var(--color-bg-alt);
	}

	.pillars__grid {
		margin-top: var(--space-xl);
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-md);
	}

	.pillar {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: var(--space-lg) var(--space-md);
		text-align: center;
		transition: transform 0.35s var(--ease-soft), border-color 0.35s ease;
	}

	.pillar:hover {
		transform: translateY(-6px);
		border-color: var(--color-border-strong);
	}

	.pillar h3 {
		font-size: var(--font-size-xl);
		color: var(--color-accent-soft);
		margin-bottom: var(--space-sm);
	}

	.pillar p {
		font-size: 0.95rem;
	}

	@media (max-width: 860px) {
		.pillars__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
