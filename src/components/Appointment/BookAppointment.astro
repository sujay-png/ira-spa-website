---
// src/components/Appointment.astro
---

<section class="appointment">
	<div class="container container--narrow">
		<form class="appointment-form" id="appointment-form">
			<div class="form-group">
				<label for="name">Name</label>
				<input
					type="text"
					id="name"
					name="name"
					placeholder="Your full name"
					required
				/>
			</div>

			<div class="form-group">
				<label for="phone">Ph. No</label>
				<input
					type="tel"
					id="phone"
					name="phone"
					placeholder="+91 00000 00000"
					required
				/>
			</div>

			<div class="form-group">
				<label for="location">Location</label>
				<select id="location" name="location" required>
					<option value="" disabled selected hidden
						>Select branch location</option
					>
					<option value="mangalore">Mangalore</option>
					<option value="kalaburagi">Kalaburagi</option>
				</select>
			</div>

			<div class="form-group">
				<label for="date">Appointment Date</label>
				<input type="date" id="date" name="date" required />
			</div>

			<div class="form-group">
				<label for="services">Select Service</label>
				<select id="services" name="services" required>
					<option value="" disabled selected hidden
						>Choose your experience</option
					>
					<option value="massage">Body Massage</option>
					<option value="herbal">Herbal Therapy</option>
					<option value="polishing">Body Polishing</option>
					<option value="facial-essentials"
						>Clean-Ups And Facial-Essential</option
					>
					<option value="thai">Thai Therapy</option>
					<option value="quick-massage">Quick Massage</option>
					<option value="facial-premium">Facial Premium </option>
					<option value="foot-spa">Foot-Spa</option>
				</select>
			</div>

			<div class="form-group">
				<label for="time">Preferred Time</label>
				<select id="time" name="time" required>
					<option value="" disabled selected hidden
						>Select a time slot</option
					>
					<option value="10:00">10:00 AM - 11:00 AM</option>
					<option value="11:00">11:00 AM - 12:00 PM</option>
					<option value="12:00">12:00 PM - 1:00 PM</option>
					<option value="13:00">1:00 PM - 2:00 PM</option>
					<option value="14:00">2:00 PM - 3:00 PM</option>
					<option value="15:00">3:00 PM - 4:00 PM</option>
					<option value="16:00">4:00 PM - 5:00 PM</option>
					<option value="17:00">5:00 PM - 6:00 PM</option>
				</select>
			</div>

			<div class="form-group">
				<label for="duration">DURATION</label>
				<select id="duration" name="duration" required>
					<option value="" disabled selected hidden
						>Select duration</option
					>
					<option value="60 min">60 min</option>
					<option value="90 min">90 min</option>
					<option value="120 min">120 min</option>
				</select>
			</div>

			<div class="form-group">
				<label for="reason">SELECT REASON</label>
				<select id="reason" name="reason" required>
					<option value="" disabled selected hidden
						>Select your reason</option
					>
					<option value="Back pain">Back pain</option>
					<option value="Decompress muscle tension"
						>Decompress muscle tension</option
					>
					<option value="Promote deeper sleep"
						>Promote deeper sleep</option
					>
					<option value="Pain relief">Pain relief</option>
					<option value="Others">Others</option>
				</select>

				<input type="hidden" id="other-reason" name="other_reason" value="" />

				<!-- Saved Reason Display under Dropdown -->
				<div class="saved-reason-preview" id="saved-reason-preview" style="display: none;">
					<span class="saved-reason-text">Reason: &ldquo;<span id="saved-reason-val"></span>&rdquo;</span>
					<button type="button" class="saved-reason-edit" id="edit-other-reason-btn">Edit</button>
				</div>
			</div>

			<button
				type="submit"
				class="btn-primary reserve-btn"
				id="submit-btn">Reserve My Session</button
			>
		
			<p
				id="form-error"
				style="grid-column: 1 / -1; text-align: center; display: none; margin-top: 1rem; color: red;"
			>
			</p>
		</form>
	</div>
</section>

<!-- Other Reason Popup Modal -->
<div id="reason-modal" class="reason-modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="reason-modal-title">
	<div class="reason-modal-card">
		<button type="button" class="reason-modal-close" id="reason-modal-close" aria-label="Close popup">&times;</button>
		<h3 id="reason-modal-title" class="reason-modal-title">Tell us your reason</h3>
		<textarea
			id="reason-modal-textarea"
			class="reason-modal-textarea"
			rows="3"
			placeholder="Please type your reason here"
		></textarea>
		<div class="reason-modal-actions">
			<button type="button" id="reason-modal-cancel" class="btn-secondary reason-modal-btn">Cancel</button>
			<button type="button" id="reason-modal-save" class="btn-primary reason-modal-btn" disabled>Save</button>
		</div>
	</div>
</div>

<!-- Success Popup Modal -->
<div id="success-modal" class="modal-overlay" style="display: none;">
	<div class="modal-content">
		<div class="modal-icon">✨</div>
		<h3>Booking Successful!</h3>
		<p>
			Thank you for choosing us. Your reservation has been received and we
			look forward to seeing you.
		</p>
		<button type="button" id="close-modal" class="btn-primary"
			>Awesome</button
		>
	</div>
</div>

<style>
	.appointment {
		padding-block: var(--space-xl);
	}

	.appointment-form {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-md) var(--space-lg);
		background: var(--color-surface, #1a1a1a);
		border: 1px solid var(--color-border, #333);
		border-radius: var(--radius-lg, 12px);
		padding: clamp(1.75rem, 5vw, 3.25rem);
	}

	.form-group {
		display: flex;
		flex-direction: column;
	}

	/* Saved Reason Preview under Dropdown */
	.saved-reason-preview {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.6rem;
		font-size: 0.85rem;
		color: var(--color-accent, #cfa23c);
		line-height: 1.4;
	}

	.saved-reason-text {
		word-break: break-word;
	}

	.saved-reason-edit {
		background: transparent;
		border: none;
		color: #ffffff;
		text-decoration: underline;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
		padding: 2px 4px;
		transition: color 0.2s ease;
	}

	.saved-reason-edit:hover {
		color: var(--color-accent, #cfa23c);
	}

	/* Reason Popup Modal */
	.reason-modal-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.75);
		backdrop-filter: blur(4px);
		z-index: 1000;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.reason-modal-card {
		position: relative;
		background: var(--color-surface, #1a1a1a);
		border: 1px solid rgba(207, 162, 60, 0.4);
		border-radius: 16px;
		padding: 24px;
		max-width: 420px;
		width: 90%;
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
		animation: reasonModalIn 0.25s ease-out forwards;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	@keyframes reasonModalIn {
		0% {
			opacity: 0;
			transform: scale(0.92);
		}
		100% {
			opacity: 1;
			transform: scale(1);
		}
	}

	.reason-modal-close {
		position: absolute;
		top: 12px;
		right: 14px;
		background: transparent;
		border: none;
		color: var(--color-text-faint, #888);
		font-size: 1.6rem;
		line-height: 1;
		cursor: pointer;
		padding: 4px 8px;
		border-radius: 4px;
		transition: color 0.2s ease;
	}

	.reason-modal-close:hover {
		color: var(--color-accent, #cfa23c);
	}

	.reason-modal-title {
		font-family: var(--font-heading, inherit);
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--color-accent, #cfa23c);
		margin: 0;
		padding-right: 1.75rem;
	}

	.reason-modal-textarea {
		width: 100%;
		padding: 0.85rem 1rem;
		font-family: var(--font-body, inherit);
		font-size: 0.95rem;
		border: 1px solid var(--color-border-strong, #333);
		border-radius: var(--radius-sm, 6px);
		background-color: var(--color-surface, #1a1a1a);
		color: var(--color-text, #fff);
		resize: vertical;
		min-height: 85px;
		transition: border-color 0.25s ease, box-shadow 0.25s ease;
	}

	.reason-modal-textarea:focus {
		outline: none;
		border-color: var(--color-accent, #cfa23c);
		box-shadow: 0 0 0 3px rgba(207, 162, 60, 0.15);
	}

	.reason-modal-textarea::placeholder {
		color: var(--color-text-faint, #777);
	}

	.reason-modal-actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
		margin-top: 0.25rem;
	}

	.reason-modal-btn {
		padding: 0.65rem 1.4rem;
		min-height: 42px;
		font-size: 0.8rem;
		letter-spacing: 0.1em;
	}

	.reason-modal-btn:disabled {
		opacity: 0.45;
		cursor: not-allowed;
		pointer-events: none;
		transform: none !important;
		box-shadow: none !important;
	}

	.reserve-btn {
		grid-column: 1 / -1;
		margin-top: var(--space-xs);
		justify-self: center;
		min-width: 260px;
	}

	/* Modal Styles */
	.modal-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.75);
		backdrop-filter: blur(4px);
		z-index: 1000;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.modal-content {
		background: var(--color-surface, #1a1a1a);
		border: 1px solid var(--color-border, #333);
		border-radius: var(--radius-lg, 12px);
		padding: 2.5rem 2rem;
		text-align: center;
		max-width: 400px;
		width: 90%;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
		animation: popIn 0.3s ease-out forwards;
	}

	.modal-icon {
		font-size: 3rem;
		margin-bottom: 1rem;
	}

	.modal-content h3 {
		margin-bottom: 1rem;
		color: #eab308; /* Adapting a gold-like color assuming it fits your theme */
	}

	.modal-content p {
		margin-bottom: 2rem;
		color: #ccc;
		line-height: 1.5;
	}

	.modal-content button {
		width: 100%;
	}

	@keyframes popIn {
		0% {
			transform: scale(0.9);
			opacity: 0;
		}
		100% {
			transform: scale(1);
			opacity: 1;
		}
	}

	@media (max-width: 700px) {
		.appointment-form {
			grid-template-columns: 1fr;
			padding: 1.5rem 1rem;
			gap: 1.25rem;
		}
		.reserve-btn {
			width: 100%;
		}
	}
</style>

<script>
	const form = document.getElementById("appointment-form") as HTMLFormElement;
	const submitBtn = document.getElementById(
		"submit-btn",
	) as HTMLButtonElement;
	const formError = document.getElementById(
		"form-error",
	) as HTMLParagraphElement;

	// Modal Elements
	const successModal = document.getElementById(
		"success-modal",
	) as HTMLDivElement;
	const closeModalBtn = document.getElementById(
		"close-modal",
	) as HTMLButtonElement;

	// Close modal logic
	if (closeModalBtn) {
		closeModalBtn.addEventListener("click", () => {
			successModal.style.display = "none";
		});
	}

	// Auto-select service from URL query param
	const urlParams = new URLSearchParams(window.location.search);
	const serviceQuery = urlParams.get("service")?.toLowerCase().trim();
	const servicesSelect = document.getElementById("services") as HTMLSelectElement | null;
	if (serviceQuery && servicesSelect) {
		const treatmentCategoryMap: Record<string, string> = {
			"traditional-thai-therapy": "thai",
			"bamboo-therapy": "thai",
			"classic-swedish-therapy": "massage",
			"deep-tissue-therapy": "massage",
			"aroma-therapy": "massage",
			"balinese-therapy": "massage",
			"ira-signature-therapy": "massage",
			"tandem-fourhands-therapy": "massage",
			"lomi-lomi-massage": "massage",
			"herbal-potli": "herbal",
			"hot-stone-therapy": "herbal",
			"full-body-black-currant": "polishing",
			"full-body-chocolate": "polishing",
			"full-body-orange": "polishing",
			"watermelon-cleanup": "facial-essentials",
			"strawberry-cleanup": "facial-essentials",
			"hydra-dew": "facial-essentials",
			"rejuvenating-facial": "facial-essentials",
			"herbal-pearl": "facial-essentials",
			"deep-pore-cleansing": "facial-premium",
			"whitening-facial": "facial-premium",
			"herbal-gold": "facial-premium",
			"classic-paraffin-wax-pedicure": "foot-spa",
			"anti-oxidant-pedicure": "foot-spa",
			"moisturizing-exotic-pedicure": "foot-spa",
			"brightening-de-tan-pedicure": "foot-spa",
			"de-stress-refreshment": "foot-spa",
			"foot-reflexology": "quick-massage",
			"back-massage": "quick-massage",
			"head-neck-shoulder": "quick-massage",
			"massage": "massage",
			"herbal": "herbal",
			"polishing": "polishing",
			"thai": "thai",
			"facial-essentials": "facial-essentials",
			"facial-premium": "facial-premium",
			"foot-spa": "foot-spa",
			"quick-massage": "quick-massage",
		};
		const targetCategory = treatmentCategoryMap[serviceQuery];
		if (targetCategory && Array.from(servicesSelect.options).some(o => o.value === targetCategory)) {
			servicesSelect.value = targetCategory;
		}
	}

	// "Others" Reason Modal Logic
	const reasonSelect = document.getElementById("reason") as HTMLSelectElement | null;
	const otherReasonHidden = document.getElementById("other-reason") as HTMLInputElement | null;
	const reasonModal = document.getElementById("reason-modal") as HTMLDivElement | null;
	const reasonModalClose = document.getElementById("reason-modal-close") as HTMLButtonElement | null;
	const reasonModalCancel = document.getElementById("reason-modal-cancel") as HTMLButtonElement | null;
	const reasonModalSave = document.getElementById("reason-modal-save") as HTMLButtonElement | null;
	const reasonModalTextarea = document.getElementById("reason-modal-textarea") as HTMLTextAreaElement | null;
	const savedReasonPreview = document.getElementById("saved-reason-preview") as HTMLDivElement | null;
	const savedReasonVal = document.getElementById("saved-reason-val") as HTMLSpanElement | null;
	const editOtherReasonBtn = document.getElementById("edit-other-reason-btn") as HTMLButtonElement | null;

	function openReasonModal() {
		if (!reasonModal || !reasonModalTextarea || !reasonModalSave) return;
		const currentText = otherReasonHidden ? otherReasonHidden.value : "";
		reasonModalTextarea.value = currentText;
		reasonModalSave.disabled = currentText.trim().length === 0;

		reasonModal.style.display = "flex";
		document.body.style.overflow = "hidden";
		setTimeout(() => {
			reasonModalTextarea.focus();
		}, 50);
	}

	function closeReasonModal() {
		if (!reasonModal) return;
		reasonModal.style.display = "none";
		document.body.style.overflow = "";
	}

	function cancelReasonModal() {
		closeReasonModal();
		// Reset dropdown to default option
		if (reasonSelect) {
			reasonSelect.value = "";
		}
		// Clear text and hidden input
		if (reasonModalTextarea) reasonModalTextarea.value = "";
		if (otherReasonHidden) otherReasonHidden.value = "";
		if (savedReasonVal) savedReasonVal.textContent = "";
		if (savedReasonPreview) savedReasonPreview.style.display = "none";
		if (reasonModalSave) reasonModalSave.disabled = true;
	}

	function saveReasonModal() {
		if (!reasonModalTextarea || !reasonModalSave) return;
		const text = reasonModalTextarea.value.trim();
		if (!text) return;

		// Save text in hidden input
		if (otherReasonHidden) otherReasonHidden.value = text;
		// Display saved reason
		if (savedReasonVal) savedReasonVal.textContent = text;
		if (savedReasonPreview) savedReasonPreview.style.display = "flex";

		closeReasonModal();
	}

	function clearOtherReason() {
		if (otherReasonHidden) otherReasonHidden.value = "";
		if (reasonModalTextarea) reasonModalTextarea.value = "";
		if (savedReasonVal) savedReasonVal.textContent = "";
		if (savedReasonPreview) savedReasonPreview.style.display = "none";
		if (reasonModalSave) reasonModalSave.disabled = true;
	}

	if (reasonSelect) {
		reasonSelect.addEventListener("change", () => {
			if (reasonSelect.value === "Others") {
				openReasonModal();
			} else {
				clearOtherReason();
			}
		});
	}

	if (reasonModalTextarea && reasonModalSave) {
		reasonModalTextarea.addEventListener("input", () => {
			const hasText = reasonModalTextarea.value.trim().length > 0;
			reasonModalSave.disabled = !hasText;
		});
	}

	if (reasonModalSave) {
		reasonModalSave.addEventListener("click", saveReasonModal);
	}

	if (reasonModalCancel) {
		reasonModalCancel.addEventListener("click", cancelReasonModal);
	}

	if (reasonModalClose) {
		reasonModalClose.addEventListener("click", cancelReasonModal);
	}

	if (editOtherReasonBtn) {
		editOtherReasonBtn.addEventListener("click", openReasonModal);
	}

	if (reasonModal) {
		reasonModal.addEventListener("click", (e) => {
			if (e.target === reasonModal) {
				cancelReasonModal();
			}
		});
	}

	window.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && reasonModal && reasonModal.style.display === "flex") {
			cancelReasonModal();
		}
	});

	if (form) {
		form.addEventListener("submit", async (e) => {
			e.preventDefault();

			// Set loading state
			submitBtn.textContent = "Reserving...";
			submitBtn.disabled = true;
			formError.style.display = "none";

			const formData = new FormData(form);
			const data = Object.fromEntries(formData.entries());

			// -------------------------------------------------------------
			// PRINT STATEMENT / LOGGING
			// -------------------------------------------------------------
			console.log("📌 Form Submission Data:", {
				name: data.name,
				phone: data.phone,
				location: data.location,
				date: data.date,
				time: data.time,
				services: data.services,
				duration: data.duration,
				reason: data.reason,
				other_reason: data.other_reason,
				start_time: data.start_time,
				STORE_ID: data.STORE_ID,
			});
			// -------------------------------------------------------------

			try {
				const response = await fetch("/api/book/", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(data),
				});

				const result = await response.json();

				if (!response.ok || !result.success) {
					throw new Error(result.error || "Failed to submit booking");
				}

				// Success State: Show Modal & Reset Form
				form.reset();
				clearOtherReason();
				successModal.style.display = "flex";
			} catch (error: any) {
				// Error State: Show inline error message
				console.error("❌ Submission Error Details:", error);
				formError.style.display = "block";
				formError.textContent =
					error.message || "Something went wrong. Please try again.";
			} finally {
				// Reset Button UI
				submitBtn.textContent = "Reserve My Session";
				submitBtn.disabled = false;
			}
		});
	}
</script>
