---
// src/components/Appointment.astro
---

<section class="appointment">
	<div class="container container--narrow">
		<form class="appointment-form" id="appointment-form">
			<div class="form-group">
				<label for="name">Name</label>
				<input type="text" id="name" name="name" placeholder="Your full name" required />
			</div>

			<div class="form-group">
				<label for="phone">Ph. No</label>
				<input type="tel" id="phone" name="phone" placeholder="+91 00000 00000" required />
			</div>

			<div class="form-group">
				<label for="location">Location</label>
				<select id="location" name="location" required>
					<option value="" disabled selected hidden>Select branch location</option>
					<option value="mangalore">Mangalore</option>
					<option value="kalaburagi">Kalaburagi</option>
				</select>
			</div>

			<div class="form-group">
				<label for="date">Appointment Date</label>
				<input type="date" id="date" name="date" required />
			</div>

			<div class="form-group">
				<label for="services">Select Service</label>
				<select id="services" name="services" required>
					<option value="" disabled selected hidden>Choose your experience</option>
						<option value="massage">Body Massage</option>
						<option value="herbal">Herbal Therapy</option>
						<option value="polishing">Body Polishing</option>
						<option value="facial-essentials">Clean-Ups And Facial-Essential</option>
						<option value="thai">Thai Therapy</option>
						<option value="quick-massage">Quick Massage</option>
						<option value="facial-premium">Facial Premium </option>
						<option value="foot-spa">Foot-Spa</option>
				</select>
			</div>

			<div class="form-group">
				<label for="time">Preferred Time</label>
				<select id="time" name="time" required>
					<option value="" disabled selected hidden>Select a time slot</option>
					<option value="10:00">10:00 AM - 11:00 AM</option>
						<option value="11:00">11:00 AM - 12:00 PM</option>
						<option value="12:00">12:00 PM - 1:00 PM</option>
						<option value="1:00">1:00 PM - 2:00 PM</option>
						<option value="2:00">2:00 PM - 3:00 PM</option>
						<option value="3:00">3:00 PM - 4:00 PM</option>
						<option value="4:00">4:00 PM - 5:00 PM</option>
						<option value="5:00">5:00 PM - 6:00 PM</option>
				</select>
			</div>

			<button type="submit" class="btn-primary reserve-btn" id="submit-btn">Reserve My Session</button>
            <!-- Error message will display here -->
            <p id="form-error" style="grid-column: 1 / -1; text-align: center; display: none; margin-top: 1rem; color: red;"></p>
		</form>
	</div>
</section>

<!-- Success Popup Modal -->
<div id="success-modal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
        <div class="modal-icon">✨</div>
        <h3>Booking Successful!</h3>
        <p>Thank you for choosing us. Your reservation has been received and we look forward to seeing you.</p>
        <button type="button" id="close-modal" class="btn-primary">Awesome</button>
    </div>
</div>

<style>
	.appointment {
		padding-block: var(--space-2xl);
	}

	.appointment-form {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-md) var(--space-lg);
		background: var(--color-surface, #1a1a1a);
		border: 1px solid var(--color-border, #333);
		border-radius: var(--radius-lg, 12px);
		padding: clamp(1.75rem, 5vw, 3.25rem);
	}

	.form-group {
		display: flex;
		flex-direction: column;
	}

	.reserve-btn {
		grid-column: 1 / -1;
		margin-top: var(--space-xs);
		justify-self: center;
		min-width: 260px;
	}

    /* Modal Styles */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(4px);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-content {
        background: var(--color-surface, #1a1a1a);
        border: 1px solid var(--color-border, #333);
        border-radius: var(--radius-lg, 12px);
        padding: 2.5rem 2rem;
        text-align: center;
        max-width: 400px;
        width: 90%;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        animation: popIn 0.3s ease-out forwards;
    }

    .modal-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    .modal-content h3 {
        margin-bottom: 1rem;
        color: #eab308; /* Adapting a gold-like color assuming it fits your theme */
    }

    .modal-content p {
        margin-bottom: 2rem;
        color: #ccc;
        line-height: 1.5;
    }

    .modal-content button {
        width: 100%;
    }

    @keyframes popIn {
        0% { transform: scale(0.9); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }

	@media (max-width: 700px) {
		.appointment-form {
			grid-template-columns: 1fr;
		}
		.reserve-btn {
			width: 100%;
		}
	}
</style>

