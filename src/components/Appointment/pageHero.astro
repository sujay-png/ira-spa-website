---
---

<section class="hero-section">
	<div class="hero-bg"></div>

	<div class="hero-container">
		<span class="eyebrow">Reservation</span>
		<h1 class="hero-title">Your Sanctuary Awaits</h1>
		<p class="hero-description">
			Step into a world of curated tranquility. Experience restorative rituals designed to
			harmonize mind, body and spirit.
		</p>

		<div class="stats-banner">
			<div class="stat-item">
				<div class="stat-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
						<path d="M12 22C12 22 17 17.5 17 13C17 9.5 14.5 9 12 5C9.5 9 7 9.5 7 13C7 17.5 12 22 12 22Z" stroke-linecap="round" stroke-linejoin="round" />
						<path d="M12 22C12 22 21 18.5 20 12.5C19 6.5 15.5 8.5 12 5M12 22C12 22 3 18.5 4 12.5C5 6.5 8.5 8.5 12 5" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</div>
				<h2 class="stat-number">12+</h2>
				<span class="stat-label">Years Experience</span>
			</div>

			<div class="stat-item">
				<div class="stat-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
						<path d="M12 21V10M12 10C10.5 10 7.5 11 6 13M12 10C13.5 10 16.5 11 18 13" stroke-linecap="round" />
						<path d="M3 21C3 13 7.02944 6 12 6C16.9706 6 21 13 21 21" stroke-linecap="round" />
					</svg>
				</div>
				<h2 class="stat-number">2</h2>
				<span class="stat-label">Locations</span>
			</div>

			<div class="stat-item">
				<div class="stat-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
						<path d="M12 2v20M8 5h8M6 10h12M9 15h6" stroke-linecap="round" stroke-linejoin="round" />
						<circle cx="12" cy="5" r="1.5" />
						<circle cx="12" cy="10" r="1.5" />
						<circle cx="12" cy="15" r="1.5" />
					</svg>
				</div>
				<h2 class="stat-number">40+</h2>
				<span class="stat-label">Herbal Treatments</span>
			</div>

			<div class="stat-item">
				<div class="stat-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
						<path d="M12 14a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM5 20v-1a7 7 0 0 1 14 0v1" stroke-linecap="round" stroke-linejoin="round" />
						<path d="M12 2v2M4.22 4.22l1.42 1.42M19.78 4.22l-1.42 1.42" stroke-linecap="round" />
					</svg>
				</div>
				<h2 class="stat-number">10,000+</h2>
				<span class="stat-label">Happy Clients</span>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-section {
		position: relative;
		width: 100%;
		min-height: 90vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		overflow: hidden;
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		background:
			linear-gradient(to bottom, rgba(11, 11, 10, 0.6) 0%, rgba(11, 11, 10, 0.5) 50%, rgba(11, 11, 10, 0.92) 100%),
			url("/images/ira-spa.png") no-repeat center center/cover;
	}

	.hero-container {
		position: relative;
		z-index: 1;
		max-width: 1300px;
		width: 100%;
		margin: auto;
		padding: clamp(3rem, 8vw, 5rem) clamp(1.25rem, 5vw, 3rem) clamp(2rem, 5vw, 2.5rem);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.hero-title {
		font-size: clamp(2.4rem, 6vw, 4.6rem);
		color: #fff;
		max-width: 900px;
		margin: var(--space-sm) 0 var(--space-md);
	}

	.hero-description {
		font-size: var(--font-size-lg);
		color: rgba(255, 255, 255, 0.72);
		max-width: 560px;
		margin-bottom: var(--space-2xl);
	}

	.stats-banner {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		width: 100%;
		max-width: 1100px;
		background: rgba(255, 255, 255, 0.04);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: var(--space-md) var(--space-sm);
	}

	.stat-item {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0 0.5rem;
	}

	.stat-item:not(:last-child)::after {
		content: "";
		position: absolute;
		right: 0;
		top: 15%;
		height: 70%;
		width: 1px;
		background: var(--color-border);
	}

	.stat-icon {
		width: 28px;
		height: 28px;
		color: var(--color-accent);
		margin-bottom: var(--space-sm);
	}

	.stat-number {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		color: #fff;
		margin-bottom: 0.4rem;
	}

	.stat-label {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-text-faint);
	}

	@media (max-width: 768px) {
		.stats-banner {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--space-md) 0;
		}
		.stat-item:nth-child(odd)::after {
			content: "";
			position: absolute;
			right: 0;
			top: 10%;
			height: 80%;
			width: 1px;
			background: var(--color-border);
		}
		.stat-item:nth-child(even)::after {
			display: none;
		}
	}
</style>
