---
const stats = [
    {
        number: "12+",
        label: "Years of Experience",
        icon: "experience",
    },
    {
        number: "2",
        label: "Spa Locations",
        icon: "location",
    },
    {
        number: "40+",
        label: "Herbal Treatments",
        icon: "herbal",
    },
    {
        number: "10,000+",
        label: "Happy Clients",
        icon: "clients",
    },
];
---

<section
    class="hero-section"
    aria-labelledby="reservation-title"
>
    <div
        class="hero-bg"
        role="img"
        aria-label="Luxury spa interior creating a relaxing and peaceful wellness atmosphere"
    ></div>

    <div class="hero-container">

        <span class="eyebrow">
            Spa Reservation
        </span>

        <h1
            id="reservation-title"
            class="hero-title"
        >
            Book Your Spa Appointment
        </h1>

        <p class="hero-description">
            Step into a world of curated tranquility at IRA SPA.
            Experience restorative spa treatments designed to
            harmonize mind, body and spirit in a calm and luxurious
            wellness environment.
        </p>


        <div
            class="stats-banner"
            aria-label="IRA SPA at a glance"
        >

            {
                stats.map((stat) => (
                    <article class="stat-item">

                        <div
                            class="stat-icon"
                            aria-hidden="true"
                        >
                            {stat.icon === "experience" && (
                                <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                >
                                    <path
                                        d="M12 22C12 22 17 17.5 17 13C17 9.5 14.5 9 12 5C9.5 9 7 9.5 7 13C7 17.5 12 22 12 22Z"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                    <path
                                        d="M12 22C12 22 21 18.5 20 12.5C19 6.5 15.5 8.5 12 5M12 22C12 22 3 18.5 4 12.5C5 6.5 8.5 8.5 12 5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            )}

                            {stat.icon === "location" && (
                                <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                >
                                    <path
                                        d="M12 21V10M12 10C10.5 10 7.5 11 6 13M12 10C13.5 10 16.5 11 18 13"
                                        stroke-linecap="round"
                                    />
                                    <path
                                        d="M3 21C3 13 7.02944 6 12 6C16.9706 6 21 13 21 21"
                                        stroke-linecap="round"
                                    />
                                </svg>
                            )}

                            {stat.icon === "herbal" && (
                                <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                >
                                    <path
                                        d="M12 2v20M8 5h8M6 10h12M9 15h6"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                    <circle cx="12" cy="5" r="1.5" />
                                    <circle cx="12" cy="10" r="1.5" />
                                    <circle cx="12" cy="15" r="1.5" />
                                </svg>
                            )}

                            {stat.icon === "clients" && (
                                <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                >
                                    <path
                                        d="M12 14a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM5 20v-1a7 7 0 0 1 14 0v1"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                    <path
                                        d="M12 2v2M4.22 4.22l1.42 1.42M19.78 4.22l-1.42 1.42"
                                        stroke-linecap="round"
                                    />
                                </svg>
                            )}
                        </div>

                        <strong class="stat-number">
                            {stat.number}
                        </strong>

                        <span class="stat-label">
                            {stat.label}
                        </span>

                    </article>
                ))
            }

        </div>

    </div>
</section>


<style>
    /* =========================================
       HERO SECTION
       ========================================= */

    .hero-section {
        position: relative;

        width: 100%;
        min-height: 90vh;

        display: flex;
        flex-direction: column;

        justify-content: center;
        align-items: center;

        overflow: hidden;

        isolation: isolate;
    }


    /* =========================================
       BACKGROUND IMAGE
       ========================================= */

    .hero-bg {
        position: absolute;

        inset: 0;

        z-index: -1;

        background:
            linear-gradient(
                to bottom,
                rgba(11, 11, 10, 0.6) 0%,
                rgba(11, 11, 10, 0.5) 50%,
                rgba(11, 11, 10, 0.92) 100%
            ),
            url("/images/ira-spa.png")
            no-repeat
            center center / cover;
    }


    /* =========================================
       HERO CONTENT
       ========================================= */

    .hero-container {
        position: relative;

        z-index: 1;

        max-width: 1300px;

        width: 100%;

        margin: auto;

        padding:
            clamp(3rem, 8vw, 5rem)
            clamp(1.25rem, 5vw, 3rem)
            clamp(2rem, 5vw, 2.5rem);

        display: flex;

        flex-direction: column;

        align-items: center;

        text-align: center;
    }


    /* =========================================
       EYEBROW
       ========================================= */

    .hero-container .eyebrow {
        display: inline-block;

        margin-bottom: var(--space-sm);
    }


    /* =========================================
       H1
       ========================================= */

    .hero-title {
        font-size:
            clamp(2.4rem, 6vw, 4.6rem);

        line-height: 1.05;

        color: #fff;

        max-width: 900px;

        margin:
            var(--space-sm)
            0
            var(--space-md);
    }


    /* =========================================
       DESCRIPTION
       ========================================= */

    .hero-description {
        font-size: var(--font-size-lg);

        line-height: 1.7;

        color:
            rgba(255, 255, 255, 0.72);

        max-width: 600px;

        margin:
            0
            auto
            var(--space-2xl);
    }


    /* =========================================
       STATS
       ========================================= */

    .stats-banner {
        display: grid;

        grid-template-columns:
            repeat(4, 1fr);

        width: 100%;

        max-width: 1100px;

        background:
            rgba(255, 255, 255, 0.04);

        backdrop-filter: blur(14px);

        -webkit-backdrop-filter: blur(14px);

        border:
            1px solid
            var(--color-border);

        border-radius:
            var(--radius-md);

        padding:
            var(--space-md)
            var(--space-sm);
    }


    /* =========================================
       STAT ITEM
       ========================================= */

    .stat-item {
        position: relative;

        display: flex;

        flex-direction: column;

        align-items: center;

        justify-content: center;

        padding:
            0
            0.5rem;

        text-align: center;
    }


    /* =========================================
       VERTICAL DIVIDER
       ========================================= */

    .stat-item:not(:last-child)::after {
        content: "";

        position: absolute;

        right: 0;

        top: 15%;

        height: 70%;

        width: 1px;

        background:
            var(--color-border);
    }


    /* =========================================
       ICON
       ========================================= */

    .stat-icon {
        width: 28px;

        height: 28px;

        color:
            var(--color-accent);

        margin-bottom:
            var(--space-sm);
    }


    .stat-icon svg {
        width: 100%;

        height: 100%;
    }


    /* =========================================
       NUMBER
       ========================================= */

    .stat-number {
        display: block;

        font-size:
            clamp(1.6rem, 3vw, 2.2rem);

        line-height: 1.2;

        color: #fff;

        margin-bottom: 0.4rem;
    }


    /* =========================================
       LABEL
       ========================================= */

    .stat-label {
        font-size: 0.68rem;

        font-weight: 600;

        line-height: 1.4;

        letter-spacing: 0.1em;

        text-transform: uppercase;

        color:
            var(--color-text-faint);
    }


    /* =========================================
       TABLET / MOBILE
       ========================================= */

    @media (max-width: 768px) {

        .hero-section {
            min-height: auto;
        }

        .hero-container {
            padding-top: 5rem;
            padding-bottom: 3rem;
        }

        .hero-title {
            max-width: 600px;
        }

        .hero-description {
            font-size:
                var(--font-size-base);

            max-width: 520px;

            margin-bottom:
                var(--space-xl);
        }

        .stats-banner {
            grid-template-columns:
                repeat(2, 1fr);

            gap:
                var(--space-md)
                0;
        }


        /* Vertical dividers */

        .stat-item:nth-child(odd)::after {
            content: "";

            position: absolute;

            right: 0;

            top: 10%;

            height: 80%;

            width: 1px;

            background:
                var(--color-border);
        }

        .stat-item:nth-child(even)::after {
            display: none;
        }
    }


    /* =========================================
       SMALL MOBILE
       ========================================= */

    @media (max-width: 480px) {

        .hero-container {
            padding-inline: 1rem;
        }

        .hero-title {
            font-size:
                clamp(2rem, 11vw, 3rem);
        }

        .hero-description {
            font-size: 0.95rem;

            line-height: 1.65;
        }

        .stats-banner {
            padding:
                1.25rem 0.5rem;
        }

        .stat-item {
            padding-inline: 0.35rem;
        }

        .stat-icon {
            width: 24px;
            height: 24px;
        }

        .stat-number {
            font-size: 1.5rem;
        }

        .stat-label {
            font-size: 0.6rem;

            letter-spacing: 0.07em;
        }
    }


    /* =========================================
       REDUCED MOTION
       ========================================= */

    @media (prefers-reduced-motion: reduce) {

        * {
            scroll-behavior: auto;
        }
    }
</style>