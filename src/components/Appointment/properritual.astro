---
const rituals = [
	{
		name: "Swedish Serenity Massage",
		duration: "60 min",
		price: "3,500",
		icon: "M4 13c0-3.5 2.5-6 5-8 .5 1.5-.5 3-1 4 2-1 4-1 5 1 1.5-1 3 0 3.5 1.5.8 2.3-1 5-4.5 6.5-4 1.7-8-1-8-5z",
	},
	{
		name: "Traditional Ayurvedic Abhyanga",
		duration: "90 min",
		price: "4,800",
		icon: "M12 3c3 3 5 6.5 5 10a5 5 0 0 1-10 0c0-3.5 2-7 5-10z",
	},
	{
		name: "Deep Tissue Muscle Release",
		duration: "60 min",
		price: "4,200",
		icon: "M9 12h6M12 9v6",
		circle: true,
	},
	{
		name: "Signature Gold Botanical Facial",
		duration: "",
		price: "5,500",
		icon: "M12 4c1.8 2 2.8 4 2.8 6a2.8 2.8 0 1 1-5.6 0c0-2 1-4 2.8-6z",
	},
];
---

<section class="popular-rituals">
	<div class="container container--narrow">
		<div class="section-heading">
			<span class="eyebrow">The Ledger</span>
			<h2>Popular Rituals</h2>
			<div class="ornament" aria-hidden="true"><span></span></div>
		</div>

		<div class="popular-rituals__list">
			{
				rituals.map((r) => (
					<div class="ritual-row">
						<span class="ritual-row__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
								{r.circle && <circle cx="12" cy="12" r="7.5" />}
								<path d={r.icon} />
							</svg>
						</span>
						<span class="ritual-row__name">
							{r.name} {r.duration && <span class="ritual-row__duration">({r.duration})</span>}
						</span>
						<span class="ritual-row__leader" aria-hidden="true" />
						<span class="ritual-row__price">₹{r.price}</span>
					</div>
				))
			}
		</div>

		<div class="popular-rituals__action">
			<a href="/ourservice" class="link-arrow">View Full Treatment Menu <span>&rarr;</span></a>
		</div>
	</div>
</section>

<style>
	.popular-rituals {
		padding-block: var(--space-2xl);
	}

	.popular-rituals__list {
		margin-top: var(--space-xl);
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.ritual-row {
		display: flex;
		align-items: baseline;
		gap: var(--space-sm);
		padding: 0.85rem 0.75rem;
		border-radius: var(--radius-sm);
		transition: background-color 0.3s ease;
	}

	.ritual-row:hover {
		background-color: rgba(207, 162, 60, 0.06);
	}

	.ritual-row__icon {
		align-self: center;
		flex-shrink: 0;
		width: 32px;
		height: 32px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: rgba(207, 162, 60, 0.12);
		color: var(--color-accent);

		svg {
			width: 16px;
			height: 16px;
		}
	}

	.ritual-row__name {
		font-size: 1.05rem;
		color: var(--color-text);
		white-space: nowrap;
	}

	.ritual-row__duration {
		color: var(--color-text-faint);
		font-size: 0.85rem;
	}

	.ritual-row__leader {
		flex-grow: 1;
		border-bottom: 1px dotted var(--color-border-strong);
		align-self: center;
	}

	.ritual-row__price {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--color-accent-soft);
		white-space: nowrap;
	}

	.popular-rituals__action {
		margin-top: var(--space-md);
		text-align: center;
	}

	@media (max-width: 600px) {
		.ritual-row {
			gap: 0.6rem;
			padding: 0.6rem 0.3rem;
		}
		.ritual-row__name,
		.ritual-row__price {
			font-size: 0.85rem;
		}
	}
</style>
