---
interface Props {
  imageSrc?: string;
}

const { imageSrc = "/src/images/spa.png" } = Astro.props;
---

<section class="expect-section">
  <div class="expect-container">
    
    <!-- Left Column: Image with Decorative Overlapping Border Box -->
    <div class="image-wrapper">
      <div class="decorative-box"></div>
      <img src={imageSrc} alt="Spa experience" class="spa-image" />
    </div>

    <!-- Right Column: Text Content & Luxury List -->
    <div class="content-wrapper">
      <span class="subtitle">EXPERIENCE</span>
      <h2 class="title">What to Expect</h2>

      <div class="experience-list">
        
        <!-- Step 1 -->
        <div class="experience-item">
          <span class="step-number">01</span>
          <div class="item-text">
            <h3>Arrival & Sanctuary</h3>
            <p>Please arrive 15 minutes prior to your session. Enjoy our signature botanical infusion in the quiet lounge as you begin your transition into stillness.</p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="experience-item">
          <span class="step-number">02</span>
          <div class="item-text">
            <h3>Curated Consultation</h3>
            <p>Your therapist will tailor the pressure and aromatic oils to your specific needs, ensuring a bespoke restorative journey.</p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="experience-item">
          <span class="step-number">03</span>
          <div class="item-text">
            <h3>Mindful Silence</h3>
            <p>We maintain a digital-free environment. Kindly switch off all mobile devices to preserve the sanctuary of Ira Spa for all guests.</p>
          </div>
        </div>

      </div>

      <!-- Bottom Cancellation Banner -->
      <footer class="policy-footer">
        <p><em>Cancellation Policy: Please provide 24-hour notice for any rescheduling or cancellations.</em></p>
      </footer>
    </div>

  </div>
</section>

<style>
  /* ===== Section Base Layout ===== */
  .expect-section {
    /* background-color: rgb(231, 222, 222); */
    padding: 120px 0;
    width: 100%;
    color:--var(color:black)
    font-family: 'Plus Jakarta Sans', sans-serif;
    
  }

  .expect-container {
    max-width: 1200px;
    margin: 0 auto;
    width: 90%;
    display: grid;
    /* Cleaned up layout columns mapping */
    grid-template-columns: 1fr 1.1fr; 
    /* Increased gap from 80px to 100px for luxurious spacing */
    gap: 100px; 
    align-items: center;
  }

  /* ===== Left Side: Luxury Image + Decorative Frame ===== */
  .image-wrapper {
 position: relative;
    /* Add padding to the left and bottom so the decorative box has room to display outside the image layout bounds */
    padding-left: 30px;
    padding-bottom: 30px;
    display: block;
    width: 100%;
  }

  .spa-image {
   width: 100%;
    height: 440px; 
    display: flex;
    position: relative;
    /* z-index: 2 keeps the image clearly layered on top of the wireframe box */
    z-index: 5;
    object-fit: cover;
    object-position: center;
    padding-right: 50;
  }

  /* Restored the missing gold wireframe style rules */
 

  /* ===== Right Side: Content ===== */
  .content-wrapper {
    display: flex;
    flex-direction: column;
  }

  .subtitle {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #D4A63A;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .title {
    font-family: 'Playfair Display', serif;
    font-size: 48px;
    font-weight: 400;
    color: --var(color:black);
    margin-bottom: 48px;
  }

  /* ===== List Styling ===== */
  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 36px;
    margin-bottom: 48px;
  }

  .experience-item {
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }

  .step-number {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    color: --var(color:#443c2c);
    font-weight: 600;
    line-height: 1.2;
    padding-top: 2px;
  }

  .item-text h3 {
    font-size: 16px;
    font-weight: 600;
    color: --var(color:black);
    margin-bottom: 8px;
    letter-spacing: 0.3px;
  }

  .item-text p {
    font-size: 14px;
    color: --var(color:#424040);
    line-height: 1.6;
    font-weight: 400;
  }

  /* ===== Bottom Policy Footer ===== */
  .policy-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 24px;
  }

  .policy-footer p {
    font-size: 13px;
    color: #a0a0a0;
    letter-spacing: 0.5px;
    line-height: 1.5;
  }

  /* ===== Responsive Breakpoints ===== */
  @media (max-width: 1024px) {
    .expect-container {
      /* Drop down the gap on smaller desktop viewports */
      gap: 50px; 
    }
  }

  @media (max-width: 992px) {
    .expect-container {
      grid-template-columns: 1fr;
      gap: 60px;
    }
    .image-wrapper {
      max-width: 550px;
      margin: 0 auto;
    }
    .title {
      font-size: 40px;
      margin-bottom: 36px;
    }
  }

  @media (max-width: 576px) {
    .expect-section {
      padding: 80px 0;
    }
    .image-wrapper {
      padding-bottom: 20px;
      padding-left: 20px;
    }
    .title {
      font-size: 32px;
    }
    .experience-item {
      flex-direction: column;
      gap: 8px;
    }
    .step-number {
      font-size: 20px;
    }
  }
</style>