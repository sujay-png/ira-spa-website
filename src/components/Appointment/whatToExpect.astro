---
interface Props {
	imageSrc?: string;
}

const { imageSrc = "/images/spa.png" } = Astro.props;

const steps = [
	{
		number: "01",
		title: "Arrival & Sanctuary",
		text: "Please arrive 15 minutes prior to your session. Enjoy our signature botanical infusion in the quiet lounge as you begin your transition into stillness.",
	},
	{
		number: "02",
		title: "Curated Consultation",
		text: "Your therapist will tailor the pressure and aromatic oils to your specific needs, ensuring a bespoke restorative journey.",
	},
	{
		number: "03",
		title: "Mindful Silence",
		text: "We maintain a digital-free environment. Kindly switch off mobile devices to preserve the sanctuary of Ira Spa for all guests.",
	},
];
---

<section class="expect">
	<div class="container expect__grid">
		<div class="expect__media">
			<img src={imageSrc} alt="Ira Spa treatment room" width="560" height="440" loading="lazy" />
		</div>

		<div class="expect__content">
			<span class="eyebrow">Experience</span>
			<h2>What to Expect</h2>

			<div class="expect__list">
				{
					steps.map((s) => (
						<div class="expect__item">
							<span class="expect__number">{s.number}</span>
							<div>
								<h3>{s.title}</h3>
								<p>{s.text}</p>
							</div>
						</div>
					))
				}
			</div>

			<p class="expect__policy">
				<em>Cancellation Policy: please provide 24-hour notice for any rescheduling or cancellations.</em>
			</p>
		</div>
	</div>
</section>

<style>
	.expect {
		padding-block: var(--space-2xl);
		background: var(--color-bg-alt);
	}

	.expect__grid {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: clamp(2.5rem, 6vw, 5rem);
		align-items: center;
	}

	.expect__media img {
		width: 100%;
		height: clamp(280px, 34vw, 440px);
		object-fit: cover;
		border-radius: var(--radius-md);
	}

	.expect__content h2 {
		margin: var(--space-2xs) 0 var(--space-lg);
	}

	.expect__list {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
		margin-bottom: var(--space-lg);
	}

	.expect__item {
		display: flex;
		gap: var(--space-sm);
	}

	.expect__number {
		font-family: var(--font-display);
		font-size: 1.4rem;
		color: var(--color-accent);
		flex-shrink: 0;
	}

	.expect__item h3 {
		font-size: 1.05rem;
		font-family: var(--font-body);
		font-weight: 600;
		margin-bottom: 0.4rem;
	}

	.expect__item p {
		font-size: 0.92rem;
	}

	.expect__policy {
		border-top: 1px solid var(--color-border);
		padding-top: var(--space-sm);
		font-size: 0.85rem;
		color: var(--color-text-faint);
	}

	@media (max-width: 900px) {
		.expect__grid {
			grid-template-columns: 1fr;
		}
		.expect__media {
			order: -1;
		}
	}
</style>
