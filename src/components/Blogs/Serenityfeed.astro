---
const categories = ["All Posts", "Wellness", "Mindfulness", "Treatments"];

const posts = [
	{
		title: "Sacred Stones: The Rebirth of Lithotherapy",
		excerpt:
			"Exploring the geological energy and thermal benefits of our signature basalt massage treatments, designed for deep cellular recovery.",
		image: "/images/sacred-stone.jpg",
		category: "Treatments",
		date: "October 12, 2026",
		readTime: "8 min read",
		size: "large",
	},
	{
		title: "Botanical Infusions and the Art of Sleep",
		excerpt: "",
		image: "/images/spa-reception.jpg",
		category: "Wellness",
		date: "September 28, 2026",
		readTime: "",
		size: "small",
	},
	{
		title: "Morning Rituals: Creating Your Private Sanctuary",
		excerpt: "",
		image: "/images/tea.jpg",
		category: "Mindfulness",
		date: "September 15, 2026",
		readTime: "",
		size: "small",
	},
];
---

<section class="feed" id="feed">
	<div class="container">
		<div class="feed__header">
			<h2>The Serenity Feed</h2>
			<nav class="feed__categories" aria-label="Blog categories">
				{categories.map((c, i) => <a href="#feed" class={`feed__category ${i === 0 ? "active" : ""}`}>{c}</a>)}
			</nav>
		</div>

		<div class="feed__grid">
			<article class="post post--large">
				<div class="post__image">
					<span class="post__badge">{posts[0].category}</span>
					<img src={posts[0].image} alt={posts[0].title} loading="lazy" />
				</div>
				<div class="post__body">
					<h3>{posts[0].title}</h3>
					<p>{posts[0].excerpt}</p>
					<div class="post__meta">
						<span>{posts[0].date}</span>
						<span class="dot">&bull;</span>
						<span>{posts[0].readTime}</span>
					</div>
				</div>
			</article>

			<div class="feed__side">
				{
					posts.slice(1).map((post) => (
						<article class="post post--small">
							<div class="post__image">
								<span class="post__badge">{post.category}</span>
								<img src={post.image} alt={post.title} loading="lazy" />
							</div>
							<div class="post__body">
								<h3>{post.title}</h3>
								<div class="post__meta">
									<span>{post.date}</span>
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.feed {
		padding-block: var(--space-2xl);
	}

	.feed__header {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
		border-bottom: 1px solid var(--color-border);
		padding-bottom: var(--space-md);
		margin-bottom: var(--space-xl);
	}

	@media (min-width: 768px) {
		.feed__header {
			flex-direction: row;
			align-items: flex-end;
			justify-content: space-between;
		}
	}

	.feed__categories {
		display: flex;
		gap: var(--space-md);
		flex-wrap: wrap;
	}

	.feed__category {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-text-faint);
	}

	.feed__category.active,
	.feed__category:hover {
		color: var(--color-accent);
	}

	.feed__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-xl);
	}

	@media (min-width: 992px) {
		.feed__grid {
			grid-template-columns: 7fr 5fr;
			gap: var(--space-lg);
		}
	}

	.feed__side {
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
	}

	.post__image {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-md);
		background: var(--color-surface);
		margin-bottom: var(--space-sm);
	}

	.post--large .post__image {
		aspect-ratio: 16 / 10;
	}

	.post--small .post__image {
		aspect-ratio: 16 / 9;
	}

	.post__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.7s var(--ease-soft), filter 0.5s ease;
		filter: brightness(0.92);
	}

	.post:hover .post__image img {
		transform: scale(1.04);
		filter: brightness(1);
	}

	.post__badge {
		position: absolute;
		top: 1rem;
		left: 1rem;
		z-index: 1;
		background: rgba(11, 11, 10, 0.75);
		color: var(--color-accent-soft);
		font-size: 0.62rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		padding: 0.45rem 0.9rem;
		border-radius: var(--radius-sm);
	}

	.post__body h3 {
		font-size: clamp(1.1rem, 2.2vw, 1.6rem);
		margin-bottom: 0.6rem;
		transition: color 0.3s ease;
	}

	.post:hover .post__body h3 {
		color: var(--color-accent-soft);
	}

	.post__body p {
		font-size: 0.9rem;
		max-width: 520px;
	}

	.post__meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.68rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-faint);
		margin-top: 0.6rem;
	}

	.dot {
		opacity: 0.5;
	}
</style>
