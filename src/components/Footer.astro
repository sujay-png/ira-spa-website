---
import { Icon } from 'astro-icon/components';
---

<footer class="site-footer">
	<div class="footer-container">
		<div class="footer-logo">
			<img
				src="https://iraspa.in/wp-content/uploads/2025/04/cropped-Ira-spa-4-e1754647926834.png"
				alt="Ira Spa"
			/>
		</div>

		<div class="footer-column">
			<h4>Useful Links</h4>
			<ul>
				<li><a href="/">Home</a></li>
				<li><a href="/about-us">About Us</a></li>
				<li><a href="/our-services">Our Services</a></li>
				<li><a href="/book-an-appointment">Book An Apointment</a></li>
				<li><a href="/contact">Contact</a></li>
				<li><a href="/site-map">Sitemap</a></li>
				<li><a href="/terms-conditions">Terms & Conditons</a></li>
				<li><a href="/refund_returns">Refund & Returns Policy</a></li>
				<li><a href="/privacy-policy">Privacy Policy</a></li>
			</ul>
			<a href="/brochure" class="brochure-btn">Download brochure</a>
		</div>

		<div class="footer-column">
			<h4>Kalaburgi &ndash; Gulbarga</h4>
			<p>
				1st floor , Tulips inn by Vkg hotel,<br />
				Sedam Rd, opp. ESIC Hospital,<br />
				Kalaburagi, Karnataka 585106, India
			</p>
			<p class="phone">+91 7022865999</p>
			<h5>Timing</h5>
			<p class="timing">
				Monday: 9:00 AM to 9:30 PM<br />
				Saturday: 9:00 AM to 9:30 PM
			</p>
		</div>

		<div class="footer-column">
			<h4>Kodialbail &ndash; Mangalore</h4>
			<p>
				#301, 3rd Floor, Lotus Paradise Elite,<br />
				Opp AJ Grand Hotel,<br />
				Kodialbail, Mangalore 575003
			</p>
			<p class="phone">+91 89716 67199</p>
			<h5>Timing</h5>
			<p class="timing">
				Monday: 9:00 AM to 9:30 PM<br />
				Saturday: 9:00 AM to 9:30 PM
			</p>

			<div class="social-icons">
				<a href="https://www.instagram.com/the_ira_spa/" aria-label="Instagram">
					<Icon name="mdi:instagram" width="20" height="20" />
				</a>
				<a href="https://www.facebook.com/share/1BW2YTGEVW/" aria-label="Facebook">
					<Icon name="mdi:facebook" width="20" height="20" />
				</a>
				<a href="http://www.linkedin.com/in/ira-spa-a3a618382" aria-label="LinkedIn">
					<Icon name="mdi:linkedin" width="20" height="20" />
				</a>
				<a href="https://www.youtube.com/@IraSpa-n5f" aria-label="YouTube">
					<Icon name="mdi:youtube" width="20" height="20" />
				</a>
			</div>
		</div>
	</div>

	<div class="footer-bottom">
		<p>Copyright &copy; Ira Spa 2025 | All Rights Reserved</p>
	</div>
</footer>

<style>
	.site-footer {
		background: linear-gradient(135deg, #1c1c1c, #0f0f0f);
		padding: clamp(2.5rem, 6vw, 3.75rem) clamp(1rem, 5vw, 2.5rem) 0 clamp(1rem, 5vw, 2.5rem);
		margin-top: 3rem;
	}

	.footer-container {
		display: grid;
		grid-template-columns: 1fr 1.3fr 1.3fr 1.3fr;
		gap: 2.5rem;
		max-width: 1400px;
		margin: 0 auto;
		padding-bottom: 2.5rem;
	}

	@media (max-width: 1100px) {
		.footer-container {
			grid-template-columns: repeat(2, 1fr);
			gap: 2rem;
		}
	}

	@media (max-width: 768px) {
		.footer-container {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}

	.footer-logo {
		display: flex;
		align-items: flex-start;
	}

	@media (max-width: 1100px) {
		.footer-logo {
			grid-column: 1 / -1;
			margin-bottom: 1rem;
		}
	}

	.footer-logo img {
		width: clamp(120px, 15vw, 160px);
		height: auto;
		object-fit: contain;
	}

	.footer-column {
		display: flex;
		flex-direction: column;
	}

	.footer-column h4 {
		font-family: "Georgia", serif;
		font-size: clamp(1rem, 2vw, 1.2rem);
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 1.5rem 0;
		letter-spacing: -0.5px;
	}

	.footer-column h5 {
		font-family: "Poppins", sans-serif;
		font-size: clamp(0.95rem, 1.5vw, 1.05rem);
		font-weight: 700;
		color: #ffffff;
		margin: 1.5rem 0 0.75rem 0;
	}

	.footer-column p {
		font-family: "Poppins", sans-serif;
		font-size: clamp(0.85rem, 1.5vw, 0.95rem);
		color: #cfcfcf;
		line-height: 1.7;
		margin: 0 0 1rem 0;
	}

	.footer-column .timing {
		color: #999;
		font-size: 0.85rem;
	}

	.footer-column .phone {
		color: #cfa23c;
		font-weight: 600;
	}

	.footer-column ul {
		list-style: none;
		padding: 0;
		margin: 0 0 1.5rem 0;
	}

	.footer-column ul li {
		margin-bottom: 0.75rem;
	}

	.footer-column ul li a {
		font-family: "Poppins", sans-serif;
		font-size: clamp(0.85rem, 1.5vw, 0.95rem);
		font-weight: 500;
		color: #e5e5e5;
		text-decoration: none;
		letter-spacing: 0.3px;
		transition: color 0.3s ease;
	}

	.footer-column ul li a:hover {
		color: #cfa23c;
	}

	.brochure-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, #cfa23c, #e8b950);
		color: #ffffff;
		font-family: "Poppins", sans-serif;
		font-size: clamp(0.85rem, 1.5vw, 0.95rem);
		font-weight: 700;
		text-decoration: none;
		padding: 0.75rem 1.5rem;
		border-radius: 4px;
		transition: all 0.3s ease;
		box-shadow: 0 4px 12px rgba(207, 162, 60, 0.2);
		width: fit-content;
		letter-spacing: 0.5px;
	}

	.brochure-btn:hover {
		background: linear-gradient(135deg, #e8b950, #cfa23c);
		box-shadow: 0 6px 16px rgba(207, 162, 60, 0.3);
		transform: translateY(-2px);
	}

	.social-icons {
		display: flex;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.social-icons a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		background-color: #cfa23c;
		border-radius: 6px;
		color: #1c1c1c;
		transition: all 0.3s ease;
	}

	.social-icons a:hover {
		background-color: #e8b950;
		transform: translateY(-3px);
		box-shadow: 0 4px 12px rgba(207, 162, 60, 0.3);
	}

	.footer-bottom {
		border-top: 1px solid #333;
		padding: 1.5rem clamp(1rem, 5vw, 2.5rem);
		text-align: center;
	}

	.footer-bottom p {
		font-family: "Poppins", sans-serif;
		font-size: clamp(0.8rem, 1.5vw, 0.9rem);
		color: #999;
		margin: 0;
		letter-spacing: 0.3px;
	}

	@media (max-width: 768px) {
		.site-footer {
			padding: 2rem 1rem 0 1rem;
		}
	}
</style>