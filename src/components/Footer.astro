---
import { Icon } from "astro-icon/components";
import logo from "../images/logo.webp";
---

<footer class="site-footer">
	<div class="container footer-container">
		<div class="footer-logo">
			<a href="/" aria-label="Ira Spa Home"
				><img
					src={logo.src}
					alt="Ira Spa"
					width="120"
					height="120"
					loading="lazy"
				/></a
			>
			<p class="footer-tagline">
				A sanctuary for holistic massage &amp; wellness in Karnataka.
			</p>
			<a
				href="/download-brochure/"
				class="btn-primary footer-brochure-btn">Download Brochure</a
			>
			<div class="social-icons">
				<a
					href="https://www.instagram.com/the_ira_spa/"
					aria-label="Instagram"
					target="_blank"
					rel="noopener noreferrer"
				>
					<Icon name="mdi:instagram" width="20" height="20" />
				</a>
				<a
					href="https://www.facebook.com/share/1BW2YTGEVW/"
					aria-label="Facebook"
					target="_blank"
					rel="noopener noreferrer"
				>
					<Icon name="mdi:facebook" width="20" height="20" />
				</a>
				<a
					href="http://www.linkedin.com/in/ira-spa-a3a618382"
					aria-label="LinkedIn"
					target="_blank"
					rel="noopener noreferrer"
				>
					<Icon name="mdi:linkedin" width="20" height="20" />
				</a>
				<a
					href="https://www.youtube.com/@IraSpa-n5f"
					aria-label="YouTube"
					target="_blank"
					rel="noopener noreferrer"
				>
					<Icon name="mdi:youtube" width="20" height="20" />
				</a>
			</div>
		</div>

		<div class="footer-column footer-column--explore">
			<h4>Explore</h4>
			<ul class="explore-list">
				<li><a href="/">Home</a></li>
				<li><a href="/about/">Our Story</a></li>
				<li><a href="/ourservice/">Rituals</a></li>
				<li><a href="/book-an-appointment/">Book An Appointment</a></li>
				<li><a href="/Contactus/Mangalore/">Contact</a></li>
				<li><a href="/sitemap/">Sitemap</a></li>
				<li><a href="/blogs/">Blogs</a></li>
				<li><a href="/terms-and-conditions/">Terms & Conditions</a></li>
				<li>
					<a href="/refund-and-return-policy/"
						>Refund & Return Policy</a
					>
				</li>
				<li><a href="/privacy-policy/">Privacy Policy</a></li>
			</ul>
		</div>

		<div class="footer-column footer-card footer-card--gulbarga">
			<h4>Kalaburagi &ndash; Gulbarga</h4>
			<p>
				1st floor, Tulips Inn,<br />
				by Vkg Hotel, Sedam Rd,<br />
				opp. ESIC Hospital,<br />
				Kalaburagi, Karnataka 585106
			</p>
			<a class="phone" href="tel:+917022865999">+91 7022865999</a>
			<h5>Timing</h5>
			<p class="timing">Mon &ndash; Sun: 9:00 AM to 9:30 PM</p>
		</div>

		<div class="footer-column footer-card footer-card--mangalore">
			<h4>Kodialbail &ndash; Mangalore</h4>
			<p>
				#301, 3rd Floor,<br />
				Lotus Paradise Elite,<br />
				Opp AJ Grand Hotel,<br />
				Kodialbail, Mangalore 575003
			</p>
			<a class="phone" href="tel:+918971667199">+91 89716 67199</a>
			<h5>Timing</h5>
			<p class="timing">Mon &ndash; Sun: 9:00 AM to 9:30 PM</p>
		</div>
	</div>

	<div class="footer-bottom">
		<p>&copy; {new Date().getFullYear()} Ira Spa. All rights reserved.</p>
	</div>
</footer>

<style>
	/* -------------------------------------------------------------
	   1) DESKTOP LAYOUT (1025px and above)
	   ------------------------------------------------------------- */
	.site-footer {
		background: var(--color-bg-alt);
		border-top: 1px solid var(--color-border);
		padding-top: 64px;
		overflow-x: hidden;
	}

	.footer-container {
		width: 100%;
		max-width: 1200px;
		margin-inline: auto;
		padding-inline: 24px;
		box-sizing: border-box;
		display: grid;
		grid-template-columns: 1.1fr 1.5fr 1.2fr 1.2fr;
		gap: 48px;
		padding-bottom: 48px;
	}

	.footer-logo {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: flex-start;
		height: auto;
		margin: 0;
		padding: 0;
		gap: 0;
	}

	.footer-logo > a:first-child {
		display: inline-flex;
		align-items: flex-start;
		margin: 0;
		padding: 0;
		line-height: 1;
		height: auto;
	}

	.footer-logo img {
		width: 120px;
		height: auto;
		display: block;
		object-fit: contain;
		margin: 0;
		padding: 0;
	}

	.footer-tagline {
		font-family: var(--font-body);
		font-size: 0.88rem;
		color: var(--color-text-faint);
		max-width: 260px;
		width: 100%;
		height: auto;
		line-height: 1.6;
		margin: 12px 0 0 0;
		padding: 0;
		text-align: left;
		overflow: visible;
	}

	.footer-brochure-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		height: auto;
		min-height: 52px;
		flex-shrink: 0;
		align-self: flex-start;
		width: auto;
		padding: 18px 40px;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		line-height: 1.5;
		white-space: nowrap;
		margin: 20px 0px 0px 0px !important;
		box-sizing: border-box;
		background: linear-gradient(
			135deg,
			var(--color-accent),
			var(--color-accent-strong)
		);
		color: var(--color-on-accent);
		border-radius: var(--radius-sm);
		border: 1px solid transparent;
		text-decoration: none;
		box-shadow: 0 8px 24px rgba(207, 162, 60, 0.22);
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease;
	}

	.footer-brochure-btn:hover {
		color: var(--color-on-accent);
		transform: translateY(-2px);
		box-shadow: 0 14px 32px rgba(207, 162, 60, 0.32);
	}

	.social-icons {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 12px;
		width: auto;
		height: auto;
		margin: 16px 0 0 0;
		padding: 0;
		box-sizing: border-box;
	}

	.social-icons a {
	display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background-color: rgba(207, 162, 60, 0.08);          /* 👈 Soft golden glass tint */
    border: 1px solid rgba(207, 162, 60, 0.25);
    color: var(--color-accent);
    transition: all 0.3s ease; 
	}

	.social-icons a:hover {
	   background-color: var(--color-accent);
    color: var(--color-on-accent);
    transform: translateY(-3px);
	}

	.social-icons a svg {
		display: block;
		flex-shrink: 0;
	}

	.footer-column h4 {
		font-family: var(--font-display);
		font-size: 1.05rem;
		color: var(--color-text);
		position: relative;
		padding-bottom: 10px;
		margin: 0 0 1.25rem 0;
		line-height: 1.2;
	}

	.footer-column h4::after {
		content: "";
		position: absolute;
		left: 0;
		bottom: 0;
		width: 40px;
		height: 2px;
		background: var(--color-accent);
		border-radius: 1px;
	}

	.footer-column h5 {
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--color-text);
		margin: var(--space-sm) 0 0.5rem;
	}

	.footer-column p {
		font-size: 0.88rem;
		color: var(--color-text-muted);
		line-height: 1.7;
		margin-bottom: var(--space-sm);
	}

	.footer-column .timing {
		color: #dedad2;
		font-size: 0.9rem;
		line-height: 1.5;
		margin-bottom: 0;
	}

	.footer-column .phone {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		color: var(--color-accent);
		font-weight: 600;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-column .phone:hover {
		color: var(--color-accent-soft);
		text-decoration: underline;
	}

	.explore-list {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 24px;
		row-gap: 6px;
	}

	.footer-column ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.footer-column ul li a {
		display: inline-flex;
		align-items: center;
		min-height: unset;
		padding-block: 2px;
		font-size: 0.88rem;
		font-weight: 500;
		color: var(--color-text-muted);
		white-space: nowrap;
		text-decoration: none;
		transition:
			color 0.2s ease,
			transform 0.2s ease;
	}

	.footer-column ul li a:hover {
		color: var(--color-accent);
		transform: translateX(4px);
	}

	.footer-bottom {
		border-top: 1px solid var(--color-border);
		padding: 20px 24px;
		text-align: center;
	}

	.footer-bottom p {
		font-size: 0.78rem;
		color: var(--color-text-faint);
		margin: 0;
	}

	/* -------------------------------------------------------------
	   2) TABLET LAYOUT (769px to 1024px)
	   Top row: Brand and Explore side by side.
	   Bottom row: Gulbarga and Mangalore cards side by side.
	   ------------------------------------------------------------- */
	@media (min-width: 769px) and (max-width: 1024px) {
		.footer-container {
			grid-template-columns: 1fr 1fr;
			gap: 40px 32px;
			padding-inline: 24px;
			padding-bottom: 40px;
		}

		.footer-column.footer-card {
			background: #171715;
			border: 1px solid rgba(207, 162, 60, 0.25);
			border-radius: 14px;
			padding: 20px;
			box-sizing: border-box;
		}

		.footer-column.footer-card h4::after {
			display: none !important;
		}
	}

	/* -------------------------------------------------------------
	   3) MOBILE LAYOUT (<= 768px)
	   Single column layout, centered brand, cards with thin gold borders.
	   ------------------------------------------------------------- */
	@media (max-width: 768px) {
		.site-footer {
			padding-top: 0;
		}

		.footer-container {
			display: flex;
			flex-direction: column;
			gap: 0;
			padding-inline: 16px;
			padding-bottom: 0;
			max-width: 100%;
		}

		/* Brand block centered on the same center line */
		.footer-logo {
			align-items: center;
			text-align: center;
			width: 100%;
			padding-top: 40px;
			padding-bottom: 28px;
			border-bottom: 1px solid rgba(207, 162, 60, 0.2);
			margin: 0 0 28px 0;
		}

		.footer-logo > a:first-child {
			margin: 0;
		}

		.footer-tagline {
			max-width: 280px;
			text-align: center;
			margin: 12px auto 0 auto !important;
		}

		/* Brochure button: centered, clear 20px space above, comfortable padding */
		.footer-brochure-btn {
			align-self: center;
			width: 100%;
			min-width: unset;
			max-width: 200px;
			height: auto;
			min-height: 48px;
			padding: 14px 24px;
			font-size: 0.88rem;
			letter-spacing: 0.12em;
			line-height: 1.2;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			text-align: center;
			margin: 20px auto 20px auto !important;
		}

		/* Social icons: centered row under button */
		.social-icons {
			display: flex;
			justify-content: center;
			align-items: center;
			width: auto;
			gap: 12px;
			margin: 0 auto 0 auto !important;
		}

		.social-icons a {
			width: 44px;
			height: 44px;
			flex: 0 0 44px;
		}

		/* Explore section: centered heading with short gold underline */
		.footer-column--explore {
			width: 100%;
			padding-bottom: 28px;
			border-bottom: 1px solid rgba(207, 162, 60, 0.2);
			margin: 0 0 28px 0;
		}

		.footer-column--explore h4 {
			text-align: center;
			margin: 0 0 1.25rem 0;
		}

		.footer-column--explore h4::after {
			left: 50%;
			transform: translateX(-50%);
			width: 40px;
			height: 2px;
		}

		/* Explore links in 2 columns; Refund & Return Policy fits on one line */
		.explore-list {
			grid-template-columns: 1fr 1fr;
			justify-items: center;
			column-gap: 12px;
			row-gap: 12px;
			width: 100%;
		}

		.footer-column ul li a {
			font-size: 0.85rem;
			justify-content: center;
			text-align: center;
			white-space: nowrap;
			min-height: 40px;
		}

		/* Branch cards: Kalaburagi & Kodialbail are 100% identical in style, border and spacing */
		.footer-column.footer-card {
			background: #171715 !important;
			border: 1px solid rgba(207, 162, 60, 0.25) !important;
			border-radius: 14px !important;
			padding: 20px !important;
			box-sizing: border-box;
			width: 100%;
		}

		.footer-column.footer-card--gulbarga {
			margin-bottom: 16px !important;
		}

		.footer-column.footer-card--mangalore {
			margin-bottom: 28px !important;
		}

		.footer-column.footer-card h4 {
			font-size: 1rem;
			font-weight: 600;
			text-align: left;
			margin: 0 0 10px 0;
			padding-bottom: 0;
		}

		.footer-column.footer-card h4::after {
			display: none !important;
		}

		.footer-column.footer-card p:not(.timing) {
			font-size: 0.84rem;
			line-height: 1.6;
			color: var(--color-text-muted);
			margin: 0 0 10px 0;
			text-align: left;
		}

		.footer-column.footer-card .phone {
			display: inline-flex;
			align-items: center;
			min-height: 40px;
			font-size: 0.9rem;
			color: var(--color-accent);
			font-weight: 600;
			margin: 0 0 10px 0;
			text-decoration: none;
		}

		.footer-column.footer-card h5 {
			font-size: 0.85rem;
			font-weight: 700;
			color: var(--color-text);
			margin: 0 0 6px 0;
			text-align: left;
		}

		.footer-column.footer-card .timing {
			font-size: 0.82rem;
			color: #dedad2;
			margin: 0;
			text-align: left;
		}

		/* Divider line & copyright */
		.footer-bottom {
			padding: 24px 16px !important;
			border-top: 1px solid rgba(207, 162, 60, 0.25) !important;
		}
	}

	/* -------------------------------------------------------------
	   4) SMALL PHONES (480px and below)
	   Slightly smaller text and compact padding so nothing feels cramped.
	   ------------------------------------------------------------- */
	@media (max-width: 480px) {
		.footer-container {
			padding-inline: 12px;
		}

		.footer-tagline {
			font-size: 0.82rem;
			max-width: 260px;
		}

		.footer-brochure-btn {
			padding: 16px 32px;
			font-size: 0.76rem;
		}

		.explore-list {
			column-gap: 8px;
		}

		.footer-column ul li a {
			font-size: 0.8rem;
			min-height: 38px;
		}

		.footer-column.footer-card {
			padding: 16px !important;
		}

		.footer-column.footer-card p:not(.timing) {
			font-size: 0.8rem;
		}

		.footer-bottom {
			padding: 20px 12px !important;
		}

		.footer-bottom p {
			font-size: 0.75rem;
		}
	}
</style>
