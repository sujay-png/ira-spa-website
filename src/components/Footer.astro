---
import { Icon } from "astro-icon/components";
import logo from "../images/logo.webp";
---

<footer class="site-footer">
	<div class="container footer-container">
		<div class="footer-logo">
			<a href="/"><img src={logo.src} alt="Ira Spa" width="140" height="46" loading="lazy" /></a>
			<p class="footer-tagline">A sanctuary for holistic massage &amp; wellness in Karnataka.</p>
		</div>

		<div class="footer-column">
			<h4>Explore</h4>
			<ul>
				<li><a href="/">Home</a></li>
				<li><a href="/about">Our Story</a></li>
				<li><a href="/ourservice">Rituals</a></li>
				<li><a href="/BookAnAppointment">Book An Appointment</a></li>
				<li><a href="/Contactus">Contact</a></li>
				<li><a href="/blogs">blogs</a></li>
			</ul>
		</div>

		<div class="footer-column">
			<h4>Kalaburagi &ndash; Gulbarga</h4>
			<p>
				1st floor, Tulips Inn by Vkg Hotel,<br />
				Sedam Rd, opp. ESIC Hospital,<br />
				Kalaburagi, Karnataka 585106
			</p>
			<a class="phone" href="tel:+917022865999">+91 7022865999</a>
			<h5>Timing</h5>
			<p class="timing">Mon &ndash; Sun: 9:00 AM to 9:30 PM</p>
		</div>

		<div class="footer-column">
			<h4>Kodialbail &ndash; Mangalore</h4>
			<p>
				#301, 3rd Floor, Lotus Paradise Elite,<br />
				Opp AJ Grand Hotel,<br />
				Kodialbail, Mangalore 575003
			</p>
			<a class="phone" href="tel:+918971667199">+91 89716 67199</a>
			<h5>Timing</h5>
			<p class="timing">Mon &ndash; Sun: 9:00 AM to 9:30 PM</p>

			<div class="social-icons">
				<a href="https://www.instagram.com/the_ira_spa/" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
					<Icon name="mdi:instagram" width="20" height="20" />
				</a>
				<a href="https://www.facebook.com/share/1BW2YTGEVW/" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
					<Icon name="mdi:facebook" width="20" height="20" />
				</a>
				<a href="http://www.linkedin.com/in/ira-spa-a3a618382" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
					<Icon name="mdi:linkedin" width="20" height="20" />
				</a>
				<a href="https://www.youtube.com/@IraSpa-n5f" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
					<Icon name="mdi:youtube" width="20" height="20" />
				</a>
			</div>
		</div>
	</div>

	<div class="footer-bottom">
		<p>&copy; {new Date().getFullYear()} Ira Spa. All rights reserved.</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-bg-alt);
		border-top: 1px solid var(--color-border);
		padding-top: var(--space-xl);
	}

	.footer-container {
		display: grid;
		grid-template-columns: 1fr 1.1fr 1.2fr 1.2fr;
		gap: var(--space-xl);
		padding-bottom: var(--space-xl);
	}

	.footer-logo {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-sm);
	}

	.footer-logo img {
		width: clamp(110px, 12vw, 140px);
		height: auto;
	}

	.footer-tagline {
		font-size: 0.85rem;
		color: var(--color-text-faint);
		max-width: 220px;
	}

	.footer-column h4 {
		font-family: var(--font-display);
		font-size: 1.05rem;
		color: var(--color-text);
		margin-bottom: var(--space-sm);
	}

	.footer-column h5 {
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--color-text);
		margin: var(--space-sm) 0 0.5rem;
	}

	.footer-column p {
		font-size: 0.88rem;
		color: var(--color-text-muted);
		line-height: 1.7;
		margin-bottom: var(--space-sm);
	}

	.footer-column .timing {
		color: var(--color-text-faint);
		font-size: 0.82rem;
		margin-bottom: 0;
	}

	.footer-column .phone {
		display: inline-block;
		color: var(--color-accent);
		font-weight: 600;
	}

	.footer-column .phone:hover {
		color: var(--color-accent-soft);
	}

	.footer-column ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.footer-column ul li {
		margin-bottom: 0.65rem;
	}

	.footer-column ul li a {
		font-size: 0.88rem;
		font-weight: 500;
		color: var(--color-text-muted);
	}

	.footer-column ul li a:hover {
		color: var(--color-accent);
	}

	.social-icons {
		display: flex;
		gap: 0.75rem;
		margin-top: var(--space-sm);
	}

	.social-icons a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		background-color: var(--color-accent);
		color: var(--color-on-accent);
		border-radius: var(--radius-sm);
		transition: all 0.3s ease;
	}

	.social-icons a:hover {
		background-color: var(--color-accent-soft);
		transform: translateY(-2px);
	}

	.footer-bottom {
		border-top: 1px solid var(--color-border);
		padding: var(--space-sm) clamp(1.25rem, 4vw, 2.5rem);
		text-align: center;
	}

	.footer-bottom p {
		font-size: 0.78rem;
		color: var(--color-text-faint);
		margin: 0;
	}

	@media (max-width: 1000px) {
		.footer-container {
			grid-template-columns: repeat(2, 1fr);
		}
		.footer-logo {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 620px) {
		.footer-container {
			grid-template-columns: 1fr;
			gap: var(--space-lg);
		}
	}
</style>
