---
---

<section class="about-spa">
	<div class="container about-spa__grid">
		<div class="about-spa__media reveal">
			<img
				src="/src/images/aboutspa.webp"
				alt="Therapist performing a relaxing massage at Ira Spa"
				width="640"
				height="760"
				loading="lazy"
			/>
			<div class="badge">
				<span class="badge__number">12+</span>
				<span class="badge__caption">Years of Bliss</span>
			</div>
		</div>

		<div class="about-spa__content reveal">
			<span class="eyebrow">Get to Know Us</span>
			<h2>A Sanctuary Rooted in the Earth</h2>
			<p>
				Welcome to Ira Spa — your destination for restorative massage in
				Mangalore and Kalaburagi. Every ritual is designed to release tension
				from the shoulders, neck, back and feet, calming the nervous system
				and easing the mind alongside the body.
			</p>
			<p>
				Our interiors are shaped around stillness — from the moment you
				arrive, the pace slows. Whether you're seeking deep therapeutic
				relief or a quiet beauty ritual, our therapists tailor every session
				to you.
			</p>
			<a href="/about" class="btn-secondary">Discover Our Story</a>
		</div>
	</div>
</section>

<style>
	.about-spa {
		padding-block: var(--space-2xl);
	}

	.about-spa__grid {
		display: grid;
		grid-template-columns: 0.85fr 1fr;
		gap: clamp(2.5rem, 6vw, 5rem);
		align-items: center;
	}

	.about-spa__media {
		position: relative;
	}

	.about-spa__media img {
		width: 100%;
		height: clamp(320px, 40vw, 480px);
		object-fit: cover;
		border-radius: var(--radius-md);
	}

	.badge {
		position: absolute;
		bottom: clamp(-1rem, -2vw, -1.5rem);
		right: clamp(-0.75rem, -2vw, -1.25rem);
		background: linear-gradient(135deg, var(--color-accent-soft), var(--color-accent-strong));
		padding: 1.25rem 1.75rem;
		border-radius: var(--radius-sm);
		display: flex;
		flex-direction: column;
		box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4);
	}

	.badge__number {
		font-family: var(--font-display);
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		font-weight: 600;
		color: var(--color-on-accent);
		line-height: 1;
	}

	.badge__caption {
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-on-accent);
		margin-top: 0.4rem;
	}

	.about-spa__content h2 {
		margin: var(--space-sm) 0 var(--space-md);
	}

	.about-spa__content p {
		margin-bottom: var(--space-sm);
	}

	.about-spa__content .btn-secondary {
		margin-top: var(--space-xs);
	}

	@media (max-width: 900px) {
		.about-spa__grid {
			grid-template-columns: 1fr;
		}

		.about-spa__media {
			order: -1;
		}
	}
</style>

<script>
	function initReveal() {
		const els = document.querySelectorAll(".about-spa .reveal");
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 },
		);
		els.forEach((el) => observer.observe(el));
	}
	initReveal();
	document.addEventListener("astro:page-load", initReveal);
</script>
