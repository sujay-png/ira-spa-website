---
const steps = [
	{
		number: "01",
		title: "Meeting",
		icon: `<svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
		description: "Upon arrival, you’ll be warmly greeted by our friendly staff, who will guide you through a brief check-in process. We’ll take the time to understand your needs, preferences, and any areas you’d like us to focus on during your session.",
		tags: ["Welcome", "Consultation", "Preferences"]
	},
	{
		number: "02",
		title: "Treatment",
		icon: `<svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>`,
		description: "Your customized massage session begins in a serene, private room with soothing music and aromatherapy. Our skilled therapist will apply techniques best suited to your preferences—be it Swedish, deep tissue, We focus on providing a healing, tranquil experience that aligns with your comfort level and wellness goals.",
		tags: ["Aromatherapy", "Privacy", "Relaxation"]
	},
	{
		number: "03",
		title: "Finalizing",
		icon: `<svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`,
		description: "After your massage, you’ll have a moment to relax and rehydrate. Our staff will check in with you to ensure your satisfaction and offer aftercare tips for prolonged benefits. If you enjoyed your experience, we’ll be happy to help you schedule your next visit",
		tags: ["Aftercare", "Hydration", "Feedback"]
	},
];
---

<section class="how-it-works-modern">
	<div class="process-container">
		
		<div class="process-header">
			<div class="eyebrow-pill">
				<span class="dot"></span> HOW WE WORK
			</div>
			<h2>Treatment  <span class="highlight">Process</span></h2>
		
		</div>

		<div class="process-grid">
			{
				steps.map((step) => (
					<div class="process-card">
						<div class="process-card__top">
							<div class="icon-box" set:html={step.icon} />
							<span class="step-num">{step.number}</span>
						</div>
						
						<h3>{step.title}</h3>
						<p>{step.description}</p>
						
						<div class="process-card__tags">
							{step.tags.map(tag => (
								<span class="tag">{tag}</span>
							))}
						</div>

						<div class="watermark" aria-hidden="true">{step.number}</div>
					</div>
				))
			}
		</div>
		
	</div>
</section>

<style>
	/* I renamed the main class to .how-it-works-modern to prevent conflicts with your old CSS */
	.how-it-works-modern {
		background-color: #0f0f0f;
		padding: 4rem 0;
		color: #ffffff;
		font-family: system-ui, -apple-system, sans-serif;
	}

	.how-it-works-modern * {
		box-sizing: border-box;
	}

	.process-container {
		/* Using 92% width guarantees there will always be a 4% margin on both sides */
		width: 92%; 
		max-width: 1200px;
		margin: 0 auto;
	}

	.process-header {
		/* Updated to cleanly align left to match your screenshot */
		text-align: left;
		max-width: 800px;
		margin: 0 0 4rem 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.eyebrow-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		border: 1px solid #333333;
		border-radius: 100px;
		padding: 0.4rem 1rem;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color:  --color-accent; /* Red accent matching your reference */
		margin-bottom: 1.5rem;
	}

	.eyebrow-pill .dot {
		width: 6px;
		height: 6px;
		background-color:  --color-accent;
		border-radius: 50%;
	}

	.process-header h2 {
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 700;
		margin: 0 0 1rem 0;
		line-height: 1.1;
		color: #ffffff;
	}

	.process-header .highlight {
		color:  --color-accent;
	}

	.process-header .subtitle {
		color: #888888;
		font-size: 1.1rem;
		line-height: 1.6;
		margin: 0;
	}

	.process-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.process-card {
		position: relative;
		background: #141414;
		border: 1px solid #222222;
		border-radius: 16px;
		padding: 2.5rem;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transition: border-color 0.3s ease;
		min-height: 380px;
	}

	.process-card:hover {
		border-color: #444444;
	}

	.process-card__top {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 2rem;
		position: relative;
		z-index: 2;
	}

	.icon-box {
		width: 48px;
		height: 48px;
		border: 1px solid #333333;
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		color:  --color-accent;
		background: rgba(229, 57, 89, 0.05);
	}

	.step-num {
		font-size: 0.85rem;
		font-family: monospace;
		color: #555555;
	}

	.process-card h3 {
		font-size: 1.5rem;
		font-weight: 600;
		margin: 0 0 1rem 0;
		color: #ffffff;
		position: relative;
		z-index: 2;
	}

	.process-card p {
		color: #888888;
		font-size: 0.95rem;
		line-height: 1.6;
		margin: 0 0 2rem 0;
		position: relative;
		z-index: 2;
	}

	.process-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: auto;
		position: relative;
		z-index: 2;
	}

	.tag {
		border: 1px solid #333333;
		border-radius: 100px;
		padding: 0.3rem 0.8rem;
		font-size: 0.75rem;
		color: #777777;
		background: transparent;
	}

	.watermark {
		position: absolute;
		bottom: -20px;
		right: 10px;
		font-size: 10rem;
		font-weight: 800;
		line-height: 1;
		color: rgba(255, 255, 255, 0.02);
		pointer-events: none;
		z-index: 1;
		letter-spacing: -0.05em;
	}

	@media (max-width: 1024px) {
		.process-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {
		.process-grid {
			grid-template-columns: 1fr;
		}
		.process-card {
			padding: 2rem;
			min-height: auto;
		}
	}
</style>