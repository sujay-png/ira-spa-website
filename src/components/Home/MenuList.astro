---
const bodyMassage = [
	{ name: "Classic Swedish Therapy", price: "₹2,200 / 3,300 / 4,000", sessions: "60 / 90 / 120 minute sessions" },
	{ name: "Deep Tissue Therapy", price: "₹2,750 / 4,000 / 5,500", sessions: "60 / 90 / 120 minute sessions" },
	{ name: "Aroma Therapy", price: "₹2,400 / 3,600 / 4,800", sessions: "60 / 90 / 120 minute sessions" },
	{ name: "Balinese Therapy", price: "₹2,750 / 4,000 / 5,500", sessions: "60 / 90 / 120 minute sessions" },
];

const pedicure = [
	{ name: "Classic Paraffin Wax Pedicure", price: "₹800", sessions: "45 minute session" },
	{ name: "Anti-Oxidant Pedicure", price: "₹800", sessions: "60 minute session" },
	{ name: "Moisturizing Exotic Pedicure", price: "₹800", sessions: "60 minute session" },
	{ name: "Brightening De-Tan Pedicure", price: "₹1,200", sessions: "60 minute session" },
	{ name: "De-Stress Refreshment", price: "₹1,000", sessions: "60 minute session" },
];
---

<section class="menu">
	<div class="container">
		<div class="section-heading">
			<span class="eyebrow">Invest in Yourself</span>
			<h2>The Wellness Menu</h2>
		</div>

		<div class="menu__card">
			<div class="menu__columns">
				<div class="menu__column">
					<p class="menu__category">Body Massage</p>
					<ul class="menu__list">
						{
							bodyMassage.map((item, i) => (
								<li class="menu__item" style={`--i: ${i}`}>
									<div class="menu__item-top">
										<span class="menu__item-name">{item.name}</span>
										<span class="menu__item-line" />
										<span class="menu__item-price">{item.price}</span>
									</div>
									<p class="menu__item-sessions">{item.sessions}</p>
								</li>
							))
						}
					</ul>
				</div>

				<div class="menu__column">
					<p class="menu__category">Pedicure</p>
					<ul class="menu__list">
						{
							pedicure.map((item, i) => (
								<li class="menu__item" style={`--i: ${i}`}>
									<div class="menu__item-top">
										<span class="menu__item-name">{item.name}</span>
										<span class="menu__item-line" />
										<span class="menu__item-price">{item.price}</span>
									</div>
									<p class="menu__item-sessions">{item.sessions}</p>
								</li>
							))
						}
					</ul>
				</div>
			</div>

			<div class="menu__cta">
				<a href="/ourservice" class="btn-secondary">View Full Menu</a>
			</div>
		</div>
	</div>
</section>

<style>
	.menu {
		padding-block: var(--space-2xl);
		background: var(--color-bg-alt);
	}

	.menu__card {
		margin-top: var(--space-xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: clamp(2rem, 5vw, 3.5rem);
	}

	.menu__columns {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
	}

	.menu__category {
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin: 0 0 var(--space-md);
		text-align: center;
	}

	.menu__list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.menu__item {
		margin-bottom: var(--space-sm);
		opacity: 0;
		transform: translateY(24px);
		transition: opacity 0.6s ease, transform 0.6s ease;
		transition-delay: calc(var(--i, 0) * 0.1s);
	}

	.menu__item.in-view {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.menu__item {
			opacity: 1;
			transform: none;
		}
	}

	.menu__item-top {
		display: flex;
		align-items: baseline;
		justify-content: center;
		gap: 0.85rem;
	}

	.menu__item-name {
		font-size: 1rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		white-space: nowrap;
	}

	.menu__item-line {
		flex: 1;
		height: 1px;
		background: var(--color-border-strong);
		min-width: 16px;
		max-width: 50px;
	}

	.menu__item-price {
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-accent-soft);
		white-space: nowrap;
	}

	.menu__item-sessions {
		font-size: 0.82rem;
		color: var(--color-text-faint);
		text-align: center;
		margin: 0.5rem 0 0;
	}

	.menu__cta {
		display: flex;
		justify-content: center;
		margin-top: var(--space-lg);
	}

	@media (max-width: 700px) {
		.menu__columns {
			grid-template-columns: 1fr;
			gap: var(--space-lg);
		}
	}
</style>

<script>
	function initMenuScrollAnimation() {
		const columns = document.querySelectorAll(".menu__column");
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.querySelectorAll(".menu__item").forEach((item) => item.classList.add("in-view"));
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.2, rootMargin: "0px 0px -60px 0px" },
		);
		columns.forEach((column) => observer.observe(column));
	}
	initMenuScrollAnimation();
	document.addEventListener("astro:page-load", initMenuScrollAnimation);
</script>
