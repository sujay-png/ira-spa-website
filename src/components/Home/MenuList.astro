<section class="menu">
    <div class="container">

        <!-- Section Heading -->
        <div class="section-heading">
            <span class="eyebrow">Best Deals</span>
            <h2>SPECIAL PRICING</h2>
        </div>

        <div class="menu__card">

            <div class="carousel" data-carousel>

                <!-- =========================
                     LEFT ARROW
                     ========================= -->
                <button
                    class="carousel__btn carousel__btn--prev"
                    data-carousel-prev
                    aria-label="Previous category"
                    type="button"
                >
                    &#10094;
                </button>


                <!-- =========================
                     MENU CAROUSEL
                     ========================= -->
                <div
                    class="carousel__track"
                    data-carousel-track
                >
                    {
                        categories.map((category) => (
                            <div
                                class="carousel__slide"
                                data-carousel-slide
                            >
                                <p class="menu__category">
                                    {category.title}
                                </p>

                                <ul class="menu__list">
                                    {category.items.map((item, i) => (
                                        <li
                                            class="menu__item"
                                            style={`--i: ${i}`}
                                        >
                                            <div class="menu__item-top">

                                                <span class="menu__item-name">
                                                    {item.name}
                                                </span>

                                                <span class="menu__item-line"></span>

                                                <span class="menu__item-price">
                                                    {item.price}
                                                </span>

                                            </div>

                                            <p class="menu__item-sessions">
                                                {item.sessions}
                                            </p>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))
                    }
                </div>


                <!-- =========================
                     RIGHT ARROW
                     ========================= -->
                <button
                    class="carousel__btn carousel__btn--next"
                    data-carousel-next
                    aria-label="Next category"
                    type="button"
                >
                    &#10095;
                </button>



            </div>


            <!-- =========================
                 CTA
                 ========================= -->
            <div class="menu__cta">
                <a
                    href="/ourservice"
                    class="btn-secondary"
                >
                    View Full Menu
                </a>
            </div>

        </div>
    </div>
</section>


<style>
    /* =========================================
       MENU SECTION
       ========================================= */

    .menu {
        padding-block: var(--space-xl);
        background: var(--color-bg-alt);
    }


    /* =========================================
       MENU CARD
       ========================================= */

    .menu__card {
        margin-top: var(--space-xl);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);

        padding: clamp(2rem, 5vw, 3.5rem);
    }


    /* =========================================
       CAROUSEL
       ========================================= */

    .carousel {
        position: relative;
        width: 100%;
        max-width: 900px;
        margin-inline: auto;
    }


    /* =========================================
       CAROUSEL TRACK
       ========================================= */

    .carousel__track {
        display: flex;

        overflow-x: auto;

        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;

        scrollbar-width: none;
        -ms-overflow-style: none;

        /*
         * Creates space for the
         * left/right arrows.
         */
        padding-inline: 4.5rem;
    }


    .carousel__track::-webkit-scrollbar {
        display: none;
    }


    /* =========================================
       CAROUSEL SLIDE
       ========================================= */

    .carousel__slide {
          flex: 0 0 100%;
    min-width: 107%;
    scroll-snap-align: start;
    padding-inline: -21rem;
    box-sizing: border-box;
    }


    /* =========================================
       CATEGORY TITLE
       ========================================= */

    .menu__category {
        font-size: 1.1rem;
        font-weight: 600;

        letter-spacing: 0.14em;
        text-transform: uppercase;

        color: var(--color-text-muted);

        margin: 0 0 var(--space-md);

        text-align: center;
    }


    /* =========================================
       MENU LIST
       ========================================= */

    .menu__list {
        list-style: none;

        margin: 0 auto;
        padding: 0;

        max-width: 600px;
    }


    /* =========================================
       MENU ITEM
       ========================================= */

    .menu__item {
        margin-bottom: var(--space-md);
    }


    /* =========================================
       ITEM TOP
       ========================================= */

    .menu__item-top {
        display: flex;

        align-items: baseline;

        justify-content: space-between;

        gap: 0.85rem;
    }


    /* =========================================
       ITEM NAME
       ========================================= */

    .menu__item-name {
        font-size: 1rem;
        font-weight: 600;

        text-transform: uppercase;

        letter-spacing: 0.02em;
    }


    /* =========================================
       DOTTED / LINE SEPARATOR
       ========================================= */

    .menu__item-line {
        flex: 1;

        height: 1px;

        background: var(--color-border-strong);

        min-width: 16px;
    }


    /* =========================================
       PRICE
       ========================================= */

    .menu__item-price {
        font-size: 1rem;

        font-weight: 600;

        color: var(--color-accent-soft);

        white-space: nowrap;
    }


    /* =========================================
       SESSION TEXT
       ========================================= */

    .menu__item-sessions {
        font-size: 0.82rem;

        color: var(--color-text-faint);

        margin: 0.25rem 0 0;
    }


    /* =========================================
       SIDE ARROWS
       ========================================= */

    .carousel__btn {
        position: absolute;

        top: 50%;

        transform: translateY(-50%);

        width: 40px;
        height: 40px;

        border-radius: 50%;

        border: 1px solid var(--color-border);

        background: transparent;

        color: var(--color-accent-soft);

        cursor: pointer;

        display: flex;

        align-items: center;

        justify-content: center;

        z-index: 10;

        font-size: 1rem;

        transition:
            background 0.3s ease,
            border-color 0.3s ease,
            transform 0.3s ease;
    }


    .carousel__btn:hover {
        background: var(--color-border);

        transform: translateY(-50%) scale(1.05);
    }


    /* LEFT ARROW */

    .carousel__btn--prev {
        left: 0.5rem;
    }


    /* RIGHT ARROW */

    .carousel__btn--next {
        right: 0.5rem;
    }


    /* =========================================
       DOTS
       ========================================= */

    .carousel__dots {
        display: flex;

        justify-content: center;

        align-items: center;

        gap: 0.5rem;

        margin-top: var(--space-lg);
    }


    .carousel__dot {
        width: 9px;
        height: 9px;

        padding: 0;

        border: none;

        border-radius: 50%;

        background: var(--color-border-strong);

        cursor: pointer;

        transition:
            background 0.3s ease,
            transform 0.3s ease;
    }


    .carousel__dot.is-active {
        background: var(--color-accent-soft);

        transform: scale(1.2);
    }


    /* =========================================
       CTA
       ========================================= */

    .menu__cta {
        display: flex;

        justify-content: center;

        margin-top: var(--space-lg);
    }


    /* =========================================
       TABLET
       ========================================= */

    @media (max-width: 900px) {

        .carousel__track {
            padding-inline: 3.5rem;
        }

        .carousel__btn--prev {
            left: 0;
        }

        .carousel__btn--next {
            right: 0;
        }
    }


    /* =========================================
       MOBILE
       ========================================= */

    @media (max-width: 768px) {

        .menu__card {
            padding: 2rem 1rem;
        }


        .carousel__track {
            padding-inline: 2.8rem;
        }


        .carousel__slide {
            padding-inline: 0.5rem;
        }


        .carousel__btn {
            width: 36px;
            height: 36px;

            font-size: 0.85rem;
        }


        .carousel__btn--prev {
            left: 0;
        }


        .carousel__btn--next {
            right: 0;
        }


        .menu__category {
            font-size: 0.95rem;

            letter-spacing: 0.1em;
        }


        .menu__item-top {
            gap: 0.5rem;
        }


        .menu__item-name {
            font-size: 0.82rem;
        }


        .menu__item-price {
            font-size: 0.78rem;
        }


        .menu__item-sessions {
            font-size: 0.75rem;
        }
    }


    /* =========================================
       SMALL MOBILE
       ========================================= */

    @media (max-width: 480px) {

        .menu__card {
            padding-inline: 0.75rem;
        }


        .carousel__track {
            padding-inline: 2.5rem;
        }


        .carousel__btn {
            width: 34px;
            height: 34px;
        }


        .menu__item-name {
            font-size: 0.75rem;
        }


        .menu__item-price {
            font-size: 0.72rem;
        }


        .menu__item-sessions {
            font-size: 0.7rem;
        }
    }
</style>


<script>
    function initMenuCarousel() {
        const carousel =
            document.querySelector("[data-carousel]");

        if (!carousel) return;

        const track =
            carousel.querySelector("[data-carousel-track]");

        const slides =
            carousel.querySelectorAll("[data-carousel-slide]");

        const prevBtn =
            carousel.querySelector("[data-carousel-prev]");

        const nextBtn =
            carousel.querySelector("[data-carousel-next]");

        const dots =
            carousel.querySelectorAll("[data-dot-index]");


        if (!track || !slides.length) return;


        let currentIndex = 0;


        /* =========================================
           UPDATE CAROUSEL
           ========================================= */

        function updateCarousel(index: number) {

            const slideWidth =
                slides[0].getBoundingClientRect().width;

            track.scrollTo({
                left: slideWidth * index,
                behavior: "smooth"
            });

            updateDots(index);

            currentIndex = index;
        }


        /* =========================================
           UPDATE DOTS
           ========================================= */

        function updateDots(index: number) {

            dots.forEach((dot, i) => {

                dot.classList.toggle(
                    "is-active",
                    i === index
                );

            });
        }


        /* =========================================
           PREVIOUS BUTTON
           ========================================= */

        prevBtn?.addEventListener("click", () => {

            const newIndex =
                currentIndex === 0
                    ? slides.length - 1
                    : currentIndex - 1;

            updateCarousel(newIndex);

        });


        /* =========================================
           NEXT BUTTON
           ========================================= */

        nextBtn?.addEventListener("click", () => {

            const newIndex =
                currentIndex === slides.length - 1
                    ? 0
                    : currentIndex + 1;

            updateCarousel(newIndex);

        });


        /* =========================================
           DOT BUTTONS
           ========================================= */

        dots.forEach((dot) => {

            dot.addEventListener("click", (event) => {

                const target =
                    event.currentTarget as HTMLElement;

                const index =
                    parseInt(
                        target.getAttribute(
                            "data-dot-index"
                        ) || "0"
                    );

                updateCarousel(index);

            });

        });


        /* =========================================
           MANUAL SWIPE / SCROLL
           ========================================= */

        track.addEventListener("scroll", () => {

            const slideWidth =
                slides[0].getBoundingClientRect().width;

            if (!slideWidth) return;

            const newIndex =
                Math.round(
                    track.scrollLeft / slideWidth
                );

            if (
                newIndex !== currentIndex &&
                newIndex >= 0 &&
                newIndex < slides.length
            ) {

                currentIndex = newIndex;

                updateDots(currentIndex);
            }

        });
    }


    /* Initial load */
    initMenuCarousel();


    /* Astro View Transitions */
    document.addEventListener(
        "astro:page-load",
        initMenuCarousel
    );
</script>