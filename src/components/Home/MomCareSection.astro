---
import MomToBeCare from "./MomToBeCare.astro";
import MomCare from "./MomCare.astro";
---

<section class="mom-care-section" aria-label="Mom and Maternity Care Services">
  <div class="container">
    <div class="mom-care-stack">
      <div class="mom-care-stack__section">
        <MomToBeCare />
      </div>

      <div class="mom-care-divider" role="separator" aria-orientation="horizontal"></div>

      <div class="mom-care-stack__section mom-care-stack__section--mom-care">
        <MomCare />
      </div>
    </div>
  </div>
</section>

<style>
  .mom-care-section {
    position: relative;
    padding-block: clamp(4rem, 6vw, 5.5rem);
    background-color: var(--color-bg);
  }

  .mom-care-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2rem, 3.5vw, 3rem);
    max-width: 1160px;
    margin-inline: auto;
    width: 100%;
  }

  .mom-care-stack__section {
    width: 100%;
  }

  .mom-care-stack__section--mom-care {
    display: flex;
    justify-content: center;
  }

  .mom-care-section :global(ul),
  .mom-care-section :global(li) {
    list-style: none !important;
    list-style-type: none !important;
    padding: 0;
    margin: 0;
  }

  .mom-care-divider {
    width: 100%;
    max-width: 1160px;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(207, 162, 60, 0.35) 15%,
      rgba(207, 162, 60, 0.45) 50%,
      rgba(207, 162, 60, 0.35) 85%,
      transparent
    );
  }
</style>
