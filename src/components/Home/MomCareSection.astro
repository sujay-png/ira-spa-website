---
import MomToBeCare from "./MomToBeCare.astro";
import MomCare from "./MomCare.astro";
---

<section class="mom-care-section" aria-label="Mom and Maternity Care Services">
  <div class="container">
    <div class="mom-care-grid">
      <div class="mom-care-grid__col mom-care-grid__col--left">
        <MomToBeCare />
      </div>

      <div class="mom-care-divider" role="separator" aria-orientation="vertical"></div>

      <div class="mom-care-grid__col mom-care-grid__col--right">
        <MomCare />
      </div>
    </div>
  </div>
</section>

<style>
  .mom-care-section {
    position: relative;
    padding-block: clamp(4rem, 6vw, 5.5rem);
    background-color: var(--color-bg);
  }

  .mom-care-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
    justify-content: center;
    max-width: 960px;
    margin-inline: auto;
    width: 100%;
  }

  .mom-care-grid__col {
    min-width: 0;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .mom-care-section :global(ul),
  .mom-care-section :global(li) {
    list-style: none !important;
    list-style-type: none !important;
    padding: 0;
    margin: 0;
  }

  .mom-care-divider {
    width: 1px;
    align-self: stretch;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(207, 162, 60, 0.35) 15%,
      rgba(207, 162, 60, 0.45) 50%,
      rgba(207, 162, 60, 0.35) 85%,
      transparent
    );
  }

  @media (max-width: 900px) {
    .mom-care-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .mom-care-divider {
      width: 100%;
      height: 1px;
      margin-block: clamp(2.5rem, 5vw, 3.5rem);
      background: linear-gradient(
        to right,
        transparent,
        rgba(207, 162, 60, 0.35) 15%,
        rgba(207, 162, 60, 0.45) 50%,
        rgba(207, 162, 60, 0.35) 85%,
        transparent
      );
    }
  }
</style>
