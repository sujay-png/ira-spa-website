---
import {
  momToBeCareData,
  type MomToBeCareData,
  type MomToBeCareItem,
} from "../../data/momToBeCare";

const { title, subtitle, items }: MomToBeCareData = momToBeCareData;
---

<div class="mom-to-be-section" id="mom-to-be-care">
  <div class="mom-to-be-header">
    <h2 class="mom-to-be-title">{title}</h2>
    <p class="mom-to-be-subtitle">{subtitle}</p>
  </div>

  <div class="mom-to-be-grid">
    {items.map((item: MomToBeCareItem) => (
      <div class="mom-to-be-card">
        <div class="mom-to-be-card__icon-box">
          <img
            src={item.icon.src}
            alt=""
            aria-hidden="true"
            width={item.icon.width || 42}
            height={item.icon.height || 42}
            loading="lazy"
          />
        </div>
        <h4 class="mom-to-be-card__title">{item.title}</h4>
        <p class="mom-to-be-card__desc">{item.description}</p>
        <a href="/book-an-appointment/" class="mom-to-be-card__btn">Book Now</a>
      </div>
    ))}
  </div>
</div>

<style>
  .mom-to-be-section {
    width: 100%;
    max-width: 1160px;
    margin-inline: auto;
  }

  .mom-to-be-header {
    text-align: center;
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
    width: 100%;
  }

  .mom-to-be-title {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: clamp(2.2rem, 3.8vw, 3rem);
    font-weight: 500;
    color: #ffffff !important;
    line-height: 1.2;
    text-align: center;
    margin: 0;
  }

  .mom-to-be-subtitle {
    font-family: var(--font-body, "Poppins", sans-serif);
    font-size: clamp(0.95rem, 1.2vw, 1.15rem);
    font-weight: 500;
    color: #cf9e3c !important;
    letter-spacing: 0.08em;
    text-align: center;
    margin: 0.65rem 0 0 0;
    text-transform: uppercase;
  }

  .mom-to-be-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    width: 100%;
    align-items: stretch;
  }

  .mom-to-be-card {
    background: #171715;
    border: 1px solid rgba(207, 162, 60, 0.22);
    border-radius: 16px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    height: 100%;
    box-sizing: border-box;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .mom-to-be-card:hover {
    transform: translateY(-4px);
    border-color: rgba(232, 185, 80, 0.55);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.5), 0 0 24px rgba(232, 185, 80, 0.2);
  }

  .mom-to-be-card__icon-box {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(232, 185, 80, 0.08);
    border: 1.5px solid rgba(232, 185, 80, 0.38);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    flex-shrink: 0;
    transition: transform 0.3s ease, background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .mom-to-be-card:hover .mom-to-be-card__icon-box {
    transform: scale(1.06);
    background: rgba(232, 185, 80, 0.16);
    border-color: rgba(232, 185, 80, 0.65);
    box-shadow: 0 0 16px rgba(232, 185, 80, 0.25);
  }

  .mom-to-be-card__icon-box img {
    width: 40px;
    height: 40px;
    object-fit: contain;
    filter: brightness(1.2) drop-shadow(0 2px 6px rgba(232, 185, 80, 0.3));
  }

  .mom-to-be-card__title {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: clamp(1.2rem, 0.3vw + 1.15rem, 1.35rem);
    font-weight: 500;
    color: #ffffff !important;
    line-height: 1.3;
    margin: 0 0 0.85rem 0;
  }

  .mom-to-be-card__desc {
    font-family: var(--font-body, "Poppins", sans-serif);
    font-size: 0.9rem;
    color: #a0a09c !important;
    line-height: 1.6;
    margin: 0 0 1.75rem 0;
    line-height: 1.6;
  }

  .mom-to-be-card__btn,
  a.mom-to-be-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    align-self: center;
    margin-top: auto;
    background: #cf9e3c !important;
    color: #0b0b0a !important;
    font-family: var(--font-body, "Poppins", sans-serif);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 12px 28px;
    border-radius: var(--radius-sm, 6px);
    border: 1px solid transparent;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(207, 158, 60, 0.25);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
  }

  .mom-to-be-card__btn:hover,
  a.mom-to-be-card__btn:hover {
    background: #dfb04c !important;
    color: #0b0b0a !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(207, 158, 60, 0.4);
  }

  .mom-to-be-card__btn:active,
  a.mom-to-be-card__btn:active {
    transform: translateY(0);
  }

  @media (max-width: 960px) {
    .mom-to-be-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }
  }

  @media (max-width: 600px) {
    .mom-to-be-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .mom-to-be-card {
      padding: 24px 20px;
    }
  }
</style>
