---
const services = [
	{
		title: "Deep Tissue Reset",
		description:
			"Intense therapy designed to release chronic muscle tension and promote long-term recovery.",
		price: "₹4,000 / 90 min",
		image:
			"/src/images/homepage_image.jpg",
		featured: true,
	},
	{
		title: "Aromatherapy Ritual",
		description: "",
		price: "₹3,700 / 60 min",
		image: "/images/serviceimg2.jpg",
		featured: false,
	},
	{
		title: "Reflexology",
		description: "",
		price: "₹2,400 / 45 min",
		image: "/images/image1.jpg",
		featured: false,
	},
	{
		title: "Facial Glow",
		description: "",
		price: "₹2,750 / 50 min",
		image:
			"/src/images/homepage_image1.jpg",
		featured: false,
	},
];
---

<section class="services">
	<div class="container">
		<div class="services__header">
			<div>
				<span class="eyebrow">Exclusive Treatments</span>
				<h2>Signature Rituals</h2>
			</div>
			<a href="/ourservice" class="link-arrow">View All Services <span>&rarr;</span></a>
		</div>

		<div class="services__grid">
			<div class="service-card service-card--featured reveal">
				<img src={services[0].image} alt={services[0].title} loading="lazy" />
				<div class="card-overlay"></div>
				<div class="card-info">
					<h3>{services[0].title}</h3>
					<p class="description">{services[0].description}</p>
					<p class="price">{services[0].price}</p>
				</div>
			</div>

			<div class="service-card reveal">
				<img src={services[1].image} alt={services[1].title} loading="lazy" />
				<div class="card-overlay"></div>
				<div class="card-info">
					<h3>{services[1].title}</h3>
					<p class="price">{services[1].price}</p>
				</div>
			</div>

			<div class="service-pair">
				<div class="service-card reveal">
					<img src={services[2].image} alt={services[2].title} loading="lazy" />
					<div class="card-overlay"></div>
					<div class="card-info">
						<h3>{services[2].title}</h3>
						<p class="price">{services[2].price}</p>
					</div>
				</div>

				<div class="service-card reveal">
					<img src={services[3].image} alt={services[3].title} loading="lazy" />
					<div class="card-overlay"></div>
					<div class="card-info">
						<h3>{services[3].title}</h3>
						<p class="price">{services[3].price}</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.services {
		padding-block: var(--space-2xl);
	}

	.services__header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 2rem;
		flex-wrap: wrap;
		margin-bottom: var(--space-xl);
	}

	.services__header h2 {
		margin-top: var(--space-2xs);
	}

	.services__grid {
		display: grid;
		grid-template-columns: 1.05fr 1fr;
		gap: 1.5rem;
	}

	.service-card {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-md);
		min-height: clamp(220px, 32vw, 380px);
	}

	.service-card--featured {
		grid-row: span 2;
	}

	.service-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.6s var(--ease);
	}

	.service-card:hover img {
		transform: scale(1.08);
	}

	.card-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(11, 11, 10, 0.92) 0%, rgba(11, 11, 10, 0.35) 45%, rgba(11, 11, 10, 0) 100%);
	}

	.card-info {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: clamp(1.25rem, 3vw, 2rem);
		color: #fff;
	}

	.card-info h3 {
		font-size: clamp(1.1rem, 2.2vw, 1.5rem);
		margin-bottom: 0.5rem;
	}

	.card-info .description {
		font-size: 0.9rem;
		color: rgba(255, 255, 255, 0.75);
		max-width: 300px;
		margin-bottom: 0.75rem;
	}

	.card-info .price {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-accent-soft);
		margin: 0;
	}

	.service-pair {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
	}

	@media (max-width: 900px) {
		.services__grid {
			grid-template-columns: 1fr;
		}
		.service-card--featured {
			grid-row: auto;
		}
	}

	@media (max-width: 560px) {
		.service-pair {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	function initReveal() {
		const revealEls = document.querySelectorAll(".services .reveal");
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 },
		);
		revealEls.forEach((el) => observer.observe(el));
	}
	initReveal();
	document.addEventListener("astro:page-load", initReveal);
</script>
