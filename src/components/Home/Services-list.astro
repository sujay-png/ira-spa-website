---
// src/components/Services.astro
---

<section class="services">
	<div class="services-header">
		<div>
			<span class="services-label">Exclusive Treatments</span>
			<h2>Signature Rituals</h2>
		</div>
		<a href="/ourservice/OurService" class="view-all">View All Services &rarr;</a>
	</div>

	<div class="services-grid">
		<div class="service-card featured reveal">
			<img
				src="https://iraspa.in/wp-content/uploads/2025/10/woman-receiving-massage-clavicle-1536x1022.jpg"
				alt="Deep Tissue Reset"
			/>
			<div class="card-overlay"></div>
			<div class="card-info">
				<h3>Deep Tissue Reset</h3>
				<p class="description">
					Intense therapy designed to release chronic muscle tension and
					promote long-term recovery.
				</p>
				<p class="price">$120 / 90 min</p>
			</div>
		</div>

		<div class="service-card reveal">
			<img
				src="src/images/serviceimg2.jpg"
				alt="Aromatherapy Ritual"
			/>
			<div class="card-overlay"></div>
			<div class="card-info">
				<h3>Aromatherapy Ritual</h3>
				<p class="price">$95 / 60 min</p>
			</div>
		</div>

		<div class="service-pair">
			<div class="service-card reveal">
				<img
					src="src/images/image1.jpg"
					alt="Reflexology"
				/>
				<div class="card-overlay"></div>
				<div class="card-info">
					<h3>Reflexology</h3>
					<p class="price">$60 / 45 min</p>
				</div>
			</div>

			<div class="service-card reveal">
				<img
					src="https://iraspa.in/wp-content/uploads/2025/09/young-attractive-woman-having-massage-relaxing-spa-salon-2048x1367.jpg"
					alt="Facial Glow"
				/>
				<div class="card-overlay"></div>
				<div class="card-info">
					<h3>Facial Glow</h3>
					<p class="price">$85 / 50 min</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.services {
		background-color: var(--bg-color, #f9f9f9);
		padding: clamp(3rem, 8vw, 5rem) clamp(1.5rem, 5vw, 2.5rem);
	}

	.services-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		max-width: 1300px;
		margin: 0 auto 3rem auto;
		gap: 2rem;
		flex-wrap: wrap;
		
		@media (max-width: 768px) {
			flex-direction: column;
			align-items: flex-start;
			gap: 1.5rem;
		}
	}

	.services-label {
		display: block;
		font-family: "Poppins", sans-serif;
		font-size: clamp(0.75rem, 1.5vw, 0.9rem);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--accent-color, #cfa23c);
		margin-bottom: 0.75rem;
	}

	.services-header h2 {
		font-family: "Georgia", "Times New Roman", serif;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		color: var(--text-color, #1a1a1a);
		margin: 0;
		font-weight: 700;
		line-height: 1.2;
	}

	.view-all {
		font-family: "Poppins", sans-serif;
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 1.5px;
		color: var(--accent-color, #cfa23c);
		text-decoration: none;
		white-space: nowrap;
		transition: all 0.3s ease;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		
		&:hover {
			color: var(--accent-hover, #f0c96b);
			transform: translateX(4px);
		}
	}

	.services-grid {
		display: grid;
		grid-template-columns: 1.05fr 1fr;
		gap: 1.5rem;
		max-width: 1300px;
		margin: 0 auto;
		
		@media (max-width: 1024px) {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
		
		@media (max-width: 600px) {
			gap: 1rem;
		}
	}

	.service-card {
		position: relative;
		overflow: hidden;
		border-radius: 8px;
		min-height: clamp(200px, 50vw, 360px);
		cursor: pointer;
		
		@media (max-width: 768px) {
			min-height: clamp(180px, 60vw, 250px);
		}
	}

	.service-card.featured {
		grid-row: span 2;
		
		@media (max-width: 1024px) {
			grid-row: auto;
		}
	}

	.service-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.service-card:hover img {
		transform: scale(1.1);
	}

	.card-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to top,
			rgba(0, 0, 0, 0.9) 0%,
			rgba(0, 0, 0, 0.5) 40%,
			rgba(0, 0, 0, 0) 100%
		);
		z-index: 1;
	}

	.card-info {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: clamp(1.5rem, 3vw, 2rem);
		color: #ffffff;
		z-index: 2;
	}

	.card-info h3 {
		font-family: "Poppins", sans-serif;
		font-size: clamp(1.1rem, 2.5vw, 1.4rem);
		font-weight: 700;
		margin: 0 0 0.75rem 0;
		line-height: 1.2;
	}

	.card-info .description {
		font-family: "Poppins", sans-serif;
		font-size: 0.95rem;
		color: #d9d9d9;
		max-width: 320px;
		margin: 0 0 1rem 0;
		line-height: 1.6;
		
		@media (max-width: 768px) {
			font-size: 0.85rem;
		}
	}

	.card-info .price {
		font-family: "Poppins", sans-serif;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--accent-color, #cfa23c);
		margin: 0;
	}

	.service-pair {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		
		@media (max-width: 600px) {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}

	/* --- scroll reveal --- */
	.reveal {
		opacity: 0;
		transform: translateY(40px);
		transition: opacity 0.7s ease, transform 0.7s ease;
	}

	.reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.services-grid > .service-card:nth-child(1) {
		transition-delay: 0s;
	}
	.services-grid > .service-card:nth-child(2) {
		transition-delay: 0.1s;
	}
	.service-pair .service-card:nth-child(1) {
		transition-delay: 0.2s;
	}
	.service-pair .service-card:nth-child(2) {
		transition-delay: 0.3s;
	}

	@media (max-width: 900px) {
		.services-grid {
			grid-template-columns: 1fr;
		}
		.service-card.featured {
			grid-row: auto;
		}
		.service-pair {
			grid-template-columns: 1fr 1fr;
		}
		.services-header {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}
	}

	@media (max-width: 600px) {
		.service-pair {
			grid-template-columns: 1fr;
		}
		
		.services {
			padding: 2rem 1rem;
		}
	}
</style>

<script>
	const revealEls = document.querySelectorAll('.reveal');

	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			});
		},
		{ threshold: 0.15 }
	);

	revealEls.forEach((el) => observer.observe(el));
</script>