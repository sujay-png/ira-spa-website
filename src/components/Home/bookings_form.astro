---
// Luxury Minimalist Booking Pill
---

<section class="booking-bar">
	<div class="container">
		<form class="booking-pill">
			
			<div class="pill-section">
				<label for="pill-name">Full Name</label>
				<input type="text" id="pill-name" name="name" placeholder="John Doe" required />
			</div>

			<div class="pill-divider"></div>

			<div class="pill-section">
				<label for="pill-phone">Phone</label>
				<input type="tel" id="pill-phone" name="phone" placeholder="+91 00000 00000" required />
			</div>

			<div class="pill-divider"></div>

			<div class="pill-section">
				<label for="pill-service">Service</label>
				<div class="select-wrapper">
					<select id="pill-service" name="service" required>
						<option value="" disabled selected>Select therapy</option>
						<option value="massage">Body Massage</option>
						<option value="herbal">Herbal Therapy</option>
						<option value="polishing">Body Polishing</option>
						<option value="foot">Foot Spa</option>
						<option value="facial">Facial</option>
					</select>
					<!-- Hardcoded SVG dimensions to prevent blowout -->
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
				</div>
			</div>

			<div class="pill-divider"></div>

			<div class="pill-section">
				<label for="pill-location">Location</label>
				<div class="select-wrapper">
					<select id="pill-location" name="location" required>
						<option value="mangalore" selected>Mangalore</option>
						<option value="kalaburagi">Kalaburagi</option>
					</select>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
				</div>
			</div>

			<div class="pill-divider"></div>

			<div class="pill-section">
				<label for="pill-date">Date</label>
				<input type="date" id="pill-date" name="date" required />
			</div>

			<button type="button" class="pill-btn" onclick="window.location.href='/BookAnAppointment'">
				Reserve
			</button>
			
		</form>
	</div>
</section>

<style>
	.booking-bar {
		position: relative;
		z-index: 10;
		margin-top: clamp(-60px, -5vw, -40px);
		margin-bottom: 4rem;
		display: flex;
		justify-content: center;
	}

	/* The main solid pill container */
	.booking-pill {
		display: flex;
		align-items: center;
		background: #141414; /* Deep, solid charcoal */
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 100px; /* Fully rounded pill shape */
		padding: 0.5rem 0.5rem 0.5rem 2rem;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
		width: 100%;
		max-width: 1100px;
	}

	.pill-section {
		display: flex;
		flex-direction: column;
		justify-content: center;
		flex: 1;
		padding: 0.5rem 1rem;
	}

	.pill-section label {
		font-size: 0.65rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: rgba(255, 255, 255, 0.4);
		margin-bottom: 0.25rem;
	}

	.pill-section input,
	.pill-section select {
		background: transparent;
		border: none;
		color: #ffffff;
		font-size: 0.95rem;
		font-weight: 500;
		outline: none;
		padding: 0;
		width: 100%;
	}
	
	.pill-section input[type="date"] {
		color-scheme: dark;
	}

	.pill-section input::placeholder {
		color: rgba(255, 255, 255, 0.2);
	}

	/* Select styling */
	.select-wrapper {
		position: relative;
		display: flex;
		align-items: center;
	}

	.select-wrapper select {
		appearance: none;
		-webkit-appearance: none;
		cursor: pointer;
		padding-right: 1.5rem;
	}

	.select-wrapper select option {
		background: #1a1a1a;
		color: #fff;
	}

	.select-wrapper svg {
		position: absolute;
		right: 0;
		color: rgba(255, 255, 255, 0.5);
		pointer-events: none;
	}

	/* Clean, subtle vertical lines */
	.pill-divider {
		width: 1px;
		height: 40px;
		background: rgba(255, 255, 255, 0.1);
	}

	/* The CTA Button */
	.pill-btn {
		background: #dfb14a; /* Soft Gold */
		color: #000;
		border: none;
		border-radius: 100px;
		padding: 1rem 2.5rem;
		font-size: 0.9rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		cursor: pointer;
		transition: background 0.2s ease, transform 0.2s ease;
		margin-left: 1rem;
	}

	.pill-btn:hover {
		background: #f0c562;
		transform: scale(1.02);
	}

	/* Responsive Tablet & Mobile */
	@media (max-width: 950px) {
		.booking-pill {
			border-radius: 16px;
			flex-wrap: wrap;
			padding: 1.5rem;
			gap: 1.5rem;
		}

		.pill-divider {
			display: none;
		}

		.pill-section {
			flex: 1 1 calc(50% - 1.5rem);
			padding: 0;
		}

		.pill-btn {
			width: 100%;
			margin-left: 0;
			margin-top: 1rem;
		}
	}

	@media (max-width: 600px) {
		.pill-section {
			flex: 1 1 100%;
		}
	}
</style>