---
// Luxury Minimalist Booking Pill
---

<section class="booking-bar">
	<div class="container">
		<form class="booking-pill" id="home-booking-form">
			
			<div class="pill-section">
				<label for="pill-name">Full Name</label>
				<input type="text" id="pill-name" name="name" placeholder="John Doe" required />
			</div>

			<div class="pill-divider"></div>

			<div class="pill-section">
				<label for="pill-phone">Phone</label>
				<input type="tel" id="pill-phone" name="phone" placeholder="+91 00000 00000" required />
			</div>

			<div class="pill-divider"></div>

			<div class="pill-section">
				<label for="pill-service">Service</label>
				<div class="select-wrapper">
					<select id="pill-service" name="service" required>
						<option value="" disabled selected>Select therapy</option>
						<option value="massage">Body Massage</option>
						<option value="herbal">Herbal Therapy</option>
						<option value="polishing">Body Polishing</option>
						<option value="foot">Foot Spa</option>
						<option value="facial">Facial</option>
					</select>
					<!-- Hardcoded SVG dimensions to prevent blowout -->
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
				</div>
			</div>

			<div class="pill-divider"></div>

			<div class="pill-section">
				<label for="pill-location">Location</label>
				<div class="select-wrapper">
					<select id="pill-location" name="location" required>
						<option value="mangalore" selected>Mangalore</option>
						<option value="kalaburagi">Kalaburagi</option>
					</select>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
				</div>
			</div>

			<div class="pill-divider"></div>

			<div class="pill-section">
				<label for="pill-date">Date</label>
				<input type="date" id="pill-date" name="date" required />
			</div>

			<div class="pill-divider"></div>

			<div class="pill-section">
				<label for="pill-time">Time</label>
				<div class="select-wrapper">
					<select id="pill-time" name="time" required>
						<option value="" disabled selected>Select time</option>
						<option value="10:00">10:00 AM - 11:00 AM</option>
						<option value="11:00">11:00 AM - 12:00 PM</option>
						<option value="12:00">12:00 PM - 1:00 PM</option>
						<option value="1:00">1:00 PM - 2:00 PM</option>
						<option value="2:00">2:00 PM - 3:00 PM</option>
						<option value="3:00">3:00 PM - 4:00 PM</option>
						<option value="4:00">4:00 PM - 5:00 PM</option>
						<option value="5:00">5:00 PM - 6:00 PM</option>

					</select>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
				</div>
			</div>

			<button type="submit" class="pill-btn" id="home-submit-btn">
				Reserve
			</button>
			
		</form>
		<p id="home-form-message" style="display: none; text-align: center; width: 100%; margin-top: 1rem; color: #dfb14a; font-weight: bold; font-size: 0.9rem;"></p>
	</div>
</section>

<style>
	.booking-bar {
		position: relative;
		z-index: 10;
		margin-top: clamp(-60px, -5vw, -40px);
		margin-bottom: 4rem;
		display: flex;
		justify-content: center;
	}

	/* The main solid pill container */
	.booking-pill {
		display: flex;
		align-items: center;
		background: #141414; /* Deep, solid charcoal */
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 100px; /* Fully rounded pill shape */
		padding: 0.5rem 0.5rem 0.5rem 2rem;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
		width: 100%;
		max-width: 1100px;
	}

	.pill-section {
		display: flex;
		flex-direction: column;
		justify-content: center;
		flex: 1;
		padding: 0.5rem 1rem;
	}

	.pill-section label {
		font-size: 0.65rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: rgba(255, 255, 255, 0.4);
		margin-bottom: 0.25rem;
	}

	.pill-section input,
	.pill-section select {
		background: transparent;
		border: none;
		color: #ffffff;
		font-size: 0.95rem;
		font-weight: 500;
		outline: none;
		padding: 0;
		width: 100%;
	}
	
	.pill-section input[type="date"] {
		color-scheme: dark;
	}

	.pill-section input::placeholder {
		color: rgba(255, 255, 255, 0.2);
	}

	/* Select styling */
	.select-wrapper {
		position: relative;
		display: flex;
		align-items: center;
	}

	.select-wrapper select {
		appearance: none;
		-webkit-appearance: none;
		cursor: pointer;
		padding-right: 1.5rem;
	}

	.select-wrapper select option {
		background: #1a1a1a;
		color: #fff;
	}

	.select-wrapper svg {
		position: absolute;
		right: 0;
		color: rgba(255, 255, 255, 0.5);
		pointer-events: none;
	}

	/* Clean, subtle vertical lines */
	.pill-divider {
		width: 1px;
		height: 40px;
		background: rgba(255, 255, 255, 0.1);
	}

	/* The CTA Button */
	.pill-btn {
		background: #dfb14a; /* Soft Gold */
		color: #000;
		border: none;
		border-radius: 100px;
		padding: 1rem 2.5rem;
		font-size: 0.9rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		cursor: pointer;
		transition: background 0.2s ease, transform 0.2s ease;
		margin-left: 1rem;
	}

	.pill-btn:hover {
		background: #f0c562;
		transform: scale(1.02);
	}

	/* Responsive Tablet & Mobile */
	@media (max-width: 950px) {
		.booking-pill {
			border-radius: 16px;
			flex-wrap: wrap;
			padding: 1.5rem;
			gap: 1.5rem;
		}

		.pill-divider {
			display: none;
		}

		.pill-section {
			flex: 1 1 calc(50% - 1.5rem);
			padding: 0;
		}

		.pill-btn {
			width: 100%;
			margin-left: 0;
			margin-top: 1rem;
		}
	}

	@media (max-width: 600px) {
		.pill-section {
			flex: 1 1 100%;
		}
	}
</style>

<script>
    const form = document.getElementById('home-booking-form') as HTMLFormElement;
    const submitBtn = document.getElementById('home-submit-btn') as HTMLButtonElement;
    const formMessage = document.getElementById('home-form-message') as HTMLParagraphElement;
    
    if (form) {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            // Set loading state
            submitBtn.textContent = 'Reserving...';
            submitBtn.disabled = true;
            formMessage.style.display = 'none';

            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());

            try {
                const response = await fetch('/api/book', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (!response.ok || !result.success) {
                    throw new Error(result.error || 'Failed to submit booking');
                }

                // Success State
                form.reset();
                formMessage.style.display = 'block';
                formMessage.style.color = '#dfb14a';
                formMessage.textContent = 'Booking Successful! We will contact you shortly.';

            } catch (error: any) {
                // Error State
                console.error('Submission Error:', error.message);
                formMessage.style.display = 'block';
                formMessage.style.color = '#ff6b6b';
                formMessage.textContent = 'Something went wrong. Please try again.';
            } finally {
                // Reset Button UI
                submitBtn.textContent = 'Reserve';
                submitBtn.disabled = false;
            }
        });
    }
</script>