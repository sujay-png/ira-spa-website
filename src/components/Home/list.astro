---
import { Icon } from "astro-icon/components";

const benefitsLeft = [
	{ icon: "mdi:brain", label: "Relieves Stress and Anxiety" },
	{ icon: "mdi:water-check", label: "Improves Blood Circulation" },
	{ icon: "mdi:shield-account", label: "Boosts Immunity" },
	{ icon: "mdi:arrow-expand-all", label: "Reduces Muscle Tension and Pain" },
	{ icon: "mdi:sleep", label: "Improves Sleep Quality" },
	{ icon: "mdi:face-woman-shimmer", label: "Enhances Skin Texture and Glow" },
];

const benefitsRight = [
	{ icon: "mdi:water-outline", label: "Flushes Out Toxins" },
	{ icon: "mdi:emoticon-happy-outline", label: "Boosts Mood and Mental Clarity" },
	{ icon: "mdi:human-handsup", label: "Increases Flexibility and Joint Mobility" },
	{ icon: "mdi:meditation", label: "Reduces Signs of Fatigue and Burnout" },
	{ icon: "mdi:weather-sunny", label: "Improves Skin Tone and Brightness" },
	{ icon: "mdi:account-heart", label: "Promotes Overall Well-being and Self-care" },
];
---

<section class="benefits">
	<div class="container">
		<div class="section-heading">
			<span class="eyebrow">Why Ira Spa</span>
			<h2 class="benefits__title">The Benefits of Ritual</h2>
		</div>

		<div class="benefits__wrapper">
			<div class="benefits__column">
				{
					benefitsLeft.map((b) => (
						<div class="benefit-item">
							<Icon name={b.icon} width="26" height="26" />
							<p>{b.label}</p>
						</div>
					))
				}
			</div>

			<div class="benefits__column">
				{
					benefitsRight.map((b) => (
						<div class="benefit-item">
							<Icon name={b.icon} width="26" height="26" />
							<p>{b.label}</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.benefits {
		position: relative;
		padding-block: var(--space-xl);
		background-image:
			linear-gradient(rgba(11, 11, 10, 0.82), rgba(11, 11, 10, 0.9)),
			url(https://iraspa.in/wp-content/uploads/2025/04/image-home01-9F4N68H.jpg);
		background-size: cover;
		background-position: center;
	}

	.benefits__title {
		color: #fff;
	}

	.benefits__wrapper {
		margin-top: var(--space-xl);
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(1.5rem, 4vw, 3.5rem);
		max-width: 1000px;
		margin-inline: auto;
	}

	.benefits__column {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}

	.benefit-item {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
	}

	.benefit-item :global(svg) {
		color: var(--color-accent);
		flex-shrink: 0;
	}

	.benefit-item p {
		color: #f3efe7;
		font-size: 0.98rem;
		margin: 0;
	}

	@media (max-width: 760px) {
		.benefits__wrapper {
			grid-template-columns: 1fr;
		}
	}
</style>
