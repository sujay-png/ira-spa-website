---
import { Icon } from 'astro-icon/components';
---

<div class="imagecontent" id="benefits-section">
	<div class="benefits-wrapper">
		<div class="benefits-column left">
			<div class="benefit-item">
				<Icon name="mdi:brain" width="32" height="32" />
				<p>Relieves Stress and Anxiety</p>
			</div>
			<div class="benefit-item">
				<Icon name="mdi:water-check" width="32" height="32" />
				<p>Improves Blood Circulation</p>
			</div>
			<div class="benefit-item">
				<Icon name="mdi:shield-account" width="32" height="32" />
				<p>Boosts Immunity</p>
			</div>
			<div class="benefit-item">
				<Icon name="mdi:arrow-expand-all" width="32" height="32" />
				<p>Reduces Muscle Tension and Pain</p>
			</div>
			<div class="benefit-item">
				<Icon name="mdi:sleep" width="32" height="32" />
				<p>Improves Sleep Quality</p>
			</div>
			<div class="benefit-item">
				<Icon name="mdi:face-woman-shimmer" width="32" height="32" />
				<p>Enhances Skin Texture and Glow</p>
			</div>
		</div>

		<div class="benefits-column right">
			<div class="benefit-item">
				<Icon name="mdi:water-outline" width="32" height="32" />
				<p>Flushes Out Toxins</p>
			</div>
			<div class="benefit-item">
				<Icon name="mdi:emoticon-happy-outline" width="32" height="32" />
				<p>Boosts Mood and Mental Clarity</p>
			</div>
			<div class="benefit-item">
				<Icon name="mdi:human-handsup" width="32" height="32" />
				<p>Increases Flexibility and Joint Mobility</p>
			</div>
			<div class="benefit-item">
				<Icon name="mdi:meditation" width="32" height="32" />
				<p>Reduces Signs of Fatigue and Burnout</p>
			</div>
			<div class="benefit-item">
				<Icon name="mdi:weather-sunny" width="32" height="32" />
				<p>Improves Skin Tone and Brightness</p>
			</div>
			<div class="benefit-item">
				<Icon name="mdi:account-heart" width="32" height="32" />
				<p>Promotes Overall Well-being and Self-care</p>
			</div>
		</div>
	</div>
</div>

<style>
	.imagecontent {
		position: relative;
		width: 100%;
		height: 580px;
		background-image: url(https://iraspa.in/wp-content/uploads/2025/04/image-home01-9F4N68H.jpg);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		overflow: hidden;
		transition: opacity 0.1s linear, height 0.1s linear;
	}

	.imagecontent::before {
		content: "";
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.35);
	}

	.benefits-wrapper {
		position: relative;
		z-index: 1;
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: 100%;
		max-width: 1300px;
		margin: 0 auto;
		padding: 0 40px;
		box-sizing: border-box;
	}

	.benefits-column {
		display: flex;
		flex-direction: column;
		gap: 32px;
		width: 40%;
	}

	.benefit-item {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.benefit-item :global(svg) {
		color: #cfa23c;
		flex-shrink: 0;
	}

	.benefit-item p {
		font-family: "Poppins", sans-serif;
		font-size: 1em;
		font-weight: 500;
		color: #ffffff;
		margin: 0;
	}

	@media (max-width: 900px) {
		.imagecontent {
			height: auto;
			padding: 40px 0;
		}
		.benefits-wrapper {
			flex-direction: column;
			height: auto;
			gap: 32px;
		}
		.benefits-column {
			width: 100%;
		}
	}
</style>

<script>
	const section = document.getElementById('benefits-section');

	if (section) {
		const maxHeight = 580; // must match .imagecontent height in CSS
		const fadeDistance = 400; // how much scroll distance the fade takes to complete
		let ticking = false;
		let sectionTop = 0;

		function getSectionTop() {
			if (section) {
				sectionTop = section.offsetTop;
			}
		}

		function updateSection() {
			if (!section) return;
			const scrollY = window.scrollY;
			const scrolledPast = scrollY - sectionTop;

			if (scrolledPast > 0 && scrolledPast < fadeDistance) {
				const progress = scrolledPast / fadeDistance;
				const newHeight = maxHeight * (1 - progress);
				section.style.height = newHeight + 'px';
				section.style.opacity = String(1 - progress);
			} else if (scrolledPast >= fadeDistance) {
				section.style.height = '0px';
				section.style.opacity = '0';
			} else {
				section.style.height = maxHeight + 'px';
				section.style.opacity = '1';
			}
			ticking = false;
		}

		getSectionTop();
		window.addEventListener('resize', getSectionTop);

		window.addEventListener('scroll', () => {
			if (!ticking && section) {
				requestAnimationFrame(updateSection);
				ticking = true;
			}
		});
	}
</script>