---
import "flowbite/dist/flowbite.min.css";
---

<section class="faq-section">
  <div class="container">
    <div class="section-heading" style="margin-bottom: var(--space-xl); text-align: center;">
      <span class="eyebrow">Got Questions?</span>
      <h2>Frequently Asked Questions</h2>
    </div>

    <div id="accordion-card" data-accordion="collapse" class="w-full">
      <!-- Item 1 -->
      <h2 id="accordion-card-heading-1">
        <button
          type="button"
          class="flex items-center justify-between w-full p-5 font-medium rtl:text-right rounded-base shadow-xs border border-default gap-3 [&[aria-expanded='true']]:rounded-b-none [&[aria-expanded='true']]:shadow-none"
          data-accordion-target="#accordion-card-body-1"
          aria-expanded="true"
          aria-controls="accordion-card-body-1"
        >
          <span>What types of therapies and services does Ira Spa offer?</span>
          <svg data-accordion-icon class="w-5 h-5 rotate-180 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 15 7-7 7 7"/>
          </svg>
        </button>
      </h2>
      <div id="accordion-card-body-1" class="border border-t-0 border-default rounded-b-base shadow-xs" aria-labelledby="accordion-card-heading-1">
        <div class="p-5">
          <ul class="faq-grid-list">
            <li><span class="faq-dot"></span><span>Full Body Massages</span></li>
            <li><span class="faq-dot"></span><span>Specialized & Herbal Therapies</span></li>
            <li><span class="faq-dot"></span><span>Skincare & Grooming</span></li>
            <li><span class="faq-dot"></span><span>Targeted & Express Relief</span></li>
            <li><span class="faq-dot"></span><span>Mom-to-Be & Maternity Care</span></li>
          </ul>
        </div>
      </div>

      <!-- Item 2 -->
      <h2 id="accordion-card-heading-2" class="mt-4">
        <button
          type="button"
          class="flex items-center justify-between w-full p-5 font-medium rtl:text-right rounded-base shadow-xs border border-default gap-3 [&[aria-expanded='true']]:rounded-b-none [&[aria-expanded='true']]:shadow-none"
          data-accordion-target="#accordion-card-body-2"
          aria-expanded="false"
          aria-controls="accordion-card-body-2"
        >
          <span>Where are Ira Spa centers located, and what are the operational hours?</span>
          <svg data-accordion-icon class="w-5 h-5 rotate-180 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 15 7-7 7 7"/>
          </svg>
        </button>
      </h2>
      <div id="accordion-card-body-2" class="hidden border border-t-0 border-default rounded-b-base shadow-xs" aria-labelledby="accordion-card-heading-2">
        <div class="p-5">
          <div class="faq-info-card">
            <div class="faq-info-block">
              <strong class="faq-info-label">Mangaluru (Kodialbail):</strong>
              <p>#301, 3rd Floor, Lotus Paradise Elite, Opposite AJ Grand Hotel, Kodialbail, Mangaluru – 575003.</p>
            </div>
            <div class="faq-info-block mt-3">
              <strong class="faq-info-label">Operational Hours:</strong>
              <p>Monday to Sunday: 9:00 AM – 9:30 PM</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Item 3 -->
      <h2 id="accordion-card-heading-3" class="mt-4">
        <button
          type="button"
          class="flex items-center justify-between w-full p-5 font-medium rtl:text-right rounded-base shadow-xs border border-default gap-3 [&[aria-expanded='true']]:rounded-b-none [&[aria-expanded='true']]:shadow-none"
          data-accordion-target="#accordion-card-body-3"
          aria-expanded="false"
          aria-controls="accordion-card-body-3"
        >
          <span>How does a therapy session work at Ira Spa?</span>
          <svg data-accordion-icon class="w-5 h-5 rotate-180 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 15 7-7 7 7"/>
          </svg>
        </button>
      </h2>
      <div id="accordion-card-body-3" class="hidden border border-t-0 border-default rounded-b-base shadow-xs" aria-labelledby="accordion-card-heading-3">
        <div class="p-5">
          <div class="faq-steps">
            <div class="faq-step">
              <strong>Meeting & Consultation:</strong>
              <p>A warm check-in where therapists discuss your personal wellness goals, comfort level, and target areas of tension.</p>
            </div>
            <div class="faq-step">
              <strong>Treatment:</strong>
              <p>A customized session inside a private, serene room equipped with calming aromatherapy and soothing ambient music.</p>
            </div>
            <div class="faq-step">
              <strong>Finalizing & Aftercare:</strong>
              <p>Time to rehydrate, relax, review post-massage care tips for extended relief, and plan future visits.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Item 4 -->
      <h2 id="accordion-card-heading-4" class="mt-4">
        <button
          type="button"
          class="flex items-center justify-between w-full p-5 font-medium rtl:text-right rounded-base shadow-xs border border-default gap-3 [&[aria-expanded='true']]:rounded-b-none [&[aria-expanded='true']]:shadow-none"
          data-accordion-target="#accordion-card-body-4"
          aria-expanded="false"
          aria-controls="accordion-card-body-4"
        >
          <span>How long are the massage sessions, and how much do they cost?</span>
          <svg data-accordion-icon class="w-5 h-5 rotate-180 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 15 7-7 7 7"/>
          </svg>
        </button>
      </h2>
      <div id="accordion-card-body-4" class="hidden border border-t-0 border-default rounded-b-base shadow-xs" aria-labelledby="accordion-card-heading-4">
        <div class="p-5">
          <p class="mb-3 text-body">
            Sessions generally range from 30, 60, 90, to 120 minutes depending on the therapy chosen:
          </p>
          <div class="faq-pricing-grid">
            <div class="faq-pricing-card">
              <strong>Express & Targeted Sessions (30–45 mins):</strong>
              <p>Clean-ups, foot reflexology, and express massages start from ₹700 to ₹1,600.</p>
            </div>
            <div class="faq-pricing-card mt-3">
              <strong>Full Body Massages (60–120 mins):</strong>
              <p>Standard therapies like Swedish and Aroma start at ₹2,200 to ₹2,400 for 60 minutes, while specialized treatments (Deep Tissue, Balinese, Potli, or Tandem) range between ₹2,750 and ₹5,500 depending on duration.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Item 5 -->
      <h2 id="accordion-card-heading-5" class="mt-4">
        <button
          type="button"
          class="flex items-center justify-between w-full p-5 font-medium rtl:text-right rounded-base shadow-xs border border-default gap-3 [&[aria-expanded='true']]:rounded-b-none [&[aria-expanded='true']]:shadow-none"
          data-accordion-target="#accordion-card-body-5"
          aria-expanded="false"
          aria-controls="accordion-card-body-5"
        >
          <span>How do I book an appointment at Ira Spa?</span>
          <svg data-accordion-icon class="w-5 h-5 rotate-180 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 15 7-7 7 7"/>
          </svg>
        </button>
      </h2>
      <div id="accordion-card-body-5" class="hidden border border-t-0 border-default rounded-b-base shadow-xs" aria-labelledby="accordion-card-heading-5">
        <div class="p-5">
          <p class="mb-3 text-body">
            You can book directly through the website by choosing your preferred service, branch location Mangaluru, date, and time slot using the <a href="/book-an-appointment/" class="faq-link">online reservation form</a>.
          </p>
          <p class="text-body">
            Alternatively, you can call directly at <a href="tel:+918971667199" class="faq-link">+91 89716 67199</a> to reserve your session.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding-block: var(--space-2xl);
    position: relative;
    z-index: 1;
    width: 100%;
  }

  :global(#accordion-card h2) {
    font-size: var(--font-size-base);
    line-height: normal;
  }

  /* Flowbite component styling matching website design system */
  :global(#accordion-card button) {
    background-color: var(--color-surface, #171613);
    color: var(--color-text, #f3efe7);
    border-color: var(--color-border, rgba(255, 255, 255, 0.09));
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  :global(#accordion-card button:hover) {
    background-color: var(--color-surface-raised, #1d1b17);
    color: var(--color-accent-soft, #e8c877);
    border-color: var(--color-border-strong, rgba(255, 255, 255, 0.16));
  }

  :global(#accordion-card [id^="accordion-card-body"]) {
    background-color: var(--color-surface, #171613);
    border-color: var(--color-border, rgba(255, 255, 255, 0.09));
    font-size: var(--font-size-base);
  }

  :global(#accordion-card p),
  :global(#accordion-card li) {
    color: var(--color-text-muted, #b7b0a2);
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: 1.7;
  }

  :global(#accordion-card strong) {
    color: var(--color-text, #f3efe7);
    font-weight: 600;
  }

  :global(#accordion-card a),
  :global(#accordion-card .faq-link) {
    color: var(--color-accent, #cfa23c);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  :global(#accordion-card a:hover),
  :global(#accordion-card .faq-link:hover) {
    color: var(--color-accent-soft, #e8c877);
  }

  /* Attractive Content Layout */
  :global(#accordion-card .faq-grid-list) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.85rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  :global(#accordion-card .faq-grid-list li) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm, 6px);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  :global(#accordion-card .faq-dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent, #cfa23c);
    box-shadow: 0 0 8px rgba(207, 162, 60, 0.5);
    flex-shrink: 0;
  }

  :global(#accordion-card .faq-steps) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(#accordion-card .faq-step) {
    padding-left: 0.85rem;
    border-left: 2px solid var(--color-accent, #cfa23c);
  }

  :global(#accordion-card .faq-pricing-card) {
    padding-left: 0.85rem;
    border-left: 2px solid rgba(207, 162, 60, 0.4);
  }

  @media (max-width: 640px) {
    :global(#accordion-card button) {
      font-size: 0.95rem;
      padding: 1rem;
    }
    :global(#accordion-card [id^="accordion-card-body"] > div) {
      padding: 1rem;
    }
    :global(#accordion-card .faq-grid-list) {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { initAccordions } from "flowbite";

  initAccordions();
  document.addEventListener("astro:page-load", () => {
    initAccordions();
  });
</script>
