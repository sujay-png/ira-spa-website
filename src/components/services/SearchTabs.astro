---
// src/components/SearchableTabs.astro
---

<div class="tabs-container">
  <!-- Search Bar -->


  <!-- Tab Buttons -->
  <div role="tablist" class="tab-list">
    <button role="tab" aria-selected="true" id="tab-overview" class="tab-btn active">Overview</button>
    <button role="tab" aria-selected="false" id="tab-specs" class="tab-btn">Specifications</button>
    <button role="tab" aria-selected="false" id="tab-support" class="tab-btn">Support</button>
  </div>

  <!-- Tab Panels -->
  <div class="tab-panels">
    <div role="tabpanel" id="panel-overview" class="panel active">
      <p>Content for the Overview tab.</p>
    </div>
    <div role="tabpanel" id="panel-specs" class="panel hidden">
      <p>Content for the Specifications tab.</p>
    </div>
    <div role="tabpanel" id="panel-support" class="panel hidden">
      <p>Content for the Support tab.</p>
    </div>
  </div>
</div>

<script>
  const searchInput = document.getElementById('tab-search') as HTMLInputElement;
  const tabs = document.querySelectorAll<HTMLElement>('[role="tab"]');
  const panels = document.querySelectorAll<HTMLElement>('[role="tabpanel"]');

  // 1. Searching / Filtering Tabs
  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    
    tabs.forEach(tab => {
      const label = tab.textContent?.toLowerCase() || '';
      if (label.includes(query)) {
        tab.style.display = 'block';
      } else {
        tab.style.display = 'none';
      }
    });
  });

  // 2. Tab Switching Logic
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Remove active states
      tabs.forEach(t => {
        t.setAttribute('aria-selected', 'false');
        t.classList.remove('active');
      });
      panels.forEach(p => p.classList.remove('active'));

      // Set clicked active
      tab.setAttribute('aria-selected', 'true');
      tab.classList.add('active');
      
      const targetPanel = document.getElementById(`panel-${tab.id.split('-')[1]}`);
      targetPanel?.classList.add('active');
    });
  });
</script>

<style>
  .search-input { margin-bottom: 1rem; padding: 0.5rem; width: 100%; }
  .tab-list { display: flex; gap: 0.5rem; border-bottom: 1px solid #ccc; }
  .tab-btn { background: none; border: none; padding: 0.5rem 1rem; cursor: pointer; }
  .tab-btn.active { border-bottom: 2px solid blue; font-weight: bold; }
  .panel { padding: 1rem; }
  .panel.hidden { display: none; }
  .panel.active { display: block; }
</style>
