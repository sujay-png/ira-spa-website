---
interface Props {
	slug?: string;
	
	title: string;
	description: string;
	price60: string;
	price90: string;
	image: string;
	reverse?: boolean;
}

const { slug,title, description, price60, price90, image, reverse = false } = Astro.props;
---

<section class={`ritual ${reverse ? "ritual--reverse" : ""}`} id={slug}>
	<div class="container ritual__grid">
		<div class="ritual__media">
			<img src={image} alt={title} width="560" height="420" loading="lazy" />
		</div>

		<div class="ritual__content">
		
			<h2>{title}</h2>
			<p>{description}</p>

			<div class="ritual__prices">
				<div>
					<span>60 min</span>
					<strong>{price60}</strong>
				</div>
				<div>
					<span>90 min</span>
					<strong>{price90}</strong>
				</div>
			</div>

			<a href="/BookAnAppointment" class="btn-primary">Book This Service</a>
		</div>
	</div>
</section>

<style>
	.ritual {
		padding-block: var(--space-xl);
	}

	.ritual:not(:last-of-type) {
		border-bottom: 1px solid var(--color-border);
	}

	.ritual__grid {
		display: grid;
		grid-template-columns: 1.05fr 1fr;
		align-items: center;
		gap: clamp(2rem, 5vw, 4.5rem);
	}

	.ritual--reverse .ritual__grid {
		grid-template-columns: 1fr 1.05fr;
	}

	.ritual--reverse .ritual__media {
		order: 2;
	}

	.ritual__media img {
		width: 100%;
		height: clamp(260px, 30vw, 420px);
		object-fit: cover;
		border-radius: var(--radius-md);
	}

	.ritual__content h2 {
		margin: var(--space-2xs) 0 var(--space-sm);
	}

	.ritual__prices {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-md);
		margin: var(--space-md) 0;
		padding: var(--space-sm) 0;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
		max-width: 320px;
	}

	.ritual__prices span {
		display: block;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin-bottom: 0.4rem;
	}

	.ritual__prices strong {
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 500;
		color: var(--color-text);
	}

	@media (max-width: 800px) {
		.ritual__grid,
		.ritual--reverse .ritual__grid {
			grid-template-columns: 1fr;
		}
		.ritual--reverse .ritual__media {
			order: 0;
		}
	}
</style>
