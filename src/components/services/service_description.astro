---
 const { category, title, description, price60, price90, image } = Astro.props;
---

<section class="floating-service">
  <div class="service-image">
    <img src={image} alt={title} />
  </div>

  <div class="service-content">
    <span class="eyebrow">{category}</span>
    <h2>{title}</h2>
    <p>{description}</p>

    <div class="prices">
      <div>
        <span>60 MIN</span>
        <strong>{price60}</strong>
      </div>

      <div>
        <span>90 MIN</span>
        <strong>{price90}</strong>
      </div>
    </div>
  </div>
</section>
<style>
  .floating-service {
    min-height: 520px;
    padding: 70px 8%;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 64px;
    background: #0d0d0d;
    color: #f7f1e8;
  }

  .service-image {
    overflow: hidden;
    box-shadow: 16px 16px 0 rgba(202, 151, 48, 0.12);
    animation: float-image 4s ease-in-out infinite;
  }

  .service-image img {
    display: block;
    width: 100%;
    height: 300px;
    object-fit: cover;
  }

  .service-content {
    max-width: 420px;
    animation: float-content 4s ease-in-out infinite;
  }

  .eyebrow,
  .prices span,
  .service-link {
    color: #d9a52d;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
  }

  h2 {
    margin: 18px 0;
    color: #f7f1e8;
    font-family: Georgia, serif;
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    font-weight: 400;
    line-height: 1.05;
  }

  .service-content p {
    color: #d7c7a8;
    line-height: 1.7;
  }

  .prices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin: 32px 0;
    padding: 24px 0;
    border-top: 1px solid #242424;
    border-bottom: 1px solid #242424;
  }

  .prices div {
    display: grid;
    gap: 10px;
  }

  .prices strong {
    font-family: Georgia, serif;
    font-size: 1.35rem;
    font-weight: 400;
  }

  .service-link {
    display: inline-flex;
    gap: 14px;
    text-decoration: none;
  }

  .service-link span {
    font-size: 1.25rem;
  }

  @keyframes float-image {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  @keyframes float-content {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(10px); }
  }

  @media (max-width: 700px) {
    .floating-service {
      grid-template-columns: 1fr;
      gap: 35px;
      padding: 50px 7%;
    }

    .service-image img {
      height: 240px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-image,
    .service-content {
      animation: none;
    }
  }
</style>

