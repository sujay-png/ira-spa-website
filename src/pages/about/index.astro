---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import Aboutusstory from "../../components/About/Aboutusstory.astro";
import VisionMission from "../../components/About/vision_mission.astro";
import AboutContent from "../../components/About/AboutContent.astro";
import AboutGallery from "../../components/About/AboutGallery.astro";
import Footer from "../../components/Footer.astro";
import { getSEO } from "../../data/seo";

const seo = getSEO("/about/");
const bannerSrc = "/images/Aboutus_story-420.webp";
const bannerSrcSet = "/images/Aboutus_story-420.webp 420w, /images/Aboutus_story.webp 640w";
const bannerSizes = "(max-width: 640px) 100vw, 640px";
---

<Layout
	seo={seo}
	preloadImage={{
		src: bannerSrc,
		srcset: bannerSrcSet,
		sizes: bannerSizes,
		type: "image/webp",
	}}
>
	<section class="page-banner">
		<img
			src={bannerSrc}
			srcset={bannerSrcSet}
			sizes={bannerSizes}
			alt="The Story and Heritage of Ira Spa"
			class="page-banner__bg-image"
			fetchpriority="high"
			loading="eager"
			decoding="async"
			width="420"
			height="328"
		/>
		<div class="container">
			<span class="eyebrow">{seo.eyebrow}</span>
		<h1>The Story of <em class="italic-serif">Ira</em> Spa</h1>
<p>
  For over a decade, Ira Spa has brought restorative massage, natural healing
  and quiet luxury to Mangalore and Kalaburagi.
</p>
		</div>
	</section>

	<Aboutusstory />
	<VisionMission />
	<AboutContent />

	<section class="gallery-heading">
		<div class="container section-heading">
			<span class="eyebrow">Inside Ira Spa</span>
			<h2>Ira Spa Gallery</h2>
		</div>
	</section>
	<AboutGallery />

	<Footer />
</Layout>

<style>
	.gallery-heading {
		padding-top: var(--space-2xl);
		padding-bottom: var(--space-lg);
	}
</style>
