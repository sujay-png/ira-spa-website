---
import Layout from "../../layouts/Layout.astro";
import Aboutusstory from "../../components/About/Aboutusstory.astro";
import VisionMission from "../../components/About/vision_mission.astro";
import AboutContent from "../../components/About/AboutContent.astro";
import AboutGallery from "../../components/About/AboutGallery.astro";
import Footer from "../../components/Footer.astro";
import { getSEO } from "../../data/seo";

const seo = getSEO("/about/");
---

<Layout seo={seo}>
	<section class="page-banner" style={`background-image: url('${seo.image}');`}>
		<div class="container">
			<span class="eyebrow">{seo.eyebrow}</span>
		<h1>The Story of <em class="italic-serif">Ira</em> Spa</h1>
<p>
  For over a decade, Ira Spa has brought restorative massage, natural healing
  and quiet luxury to Mangalore and Kalaburagi.
</p>
		</div>
	</section>

	<Aboutusstory />
	<VisionMission />
	<AboutContent />

	<section class="gallery-heading">
		<div class="container section-heading">
			<span class="eyebrow">Inside Ira Spa</span>
			<h2>Ira Spa Gallery</h2>
		</div>
	</section>
	<AboutGallery />

	<Footer />
</Layout>

<style>
	.gallery-heading {
		padding-top: var(--space-2xl);
		padding-bottom: var(--space-lg);
	}
</style>
