---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import BlogReadNextCard from "../../components/blogs/BlogReadNextCard.astro";
import BlogBookingForm from "../../components/blogs/BlogBookingForm.astro";

import {
	getPostBySlug,
	getAllPosts,
	getFeaturedImage,
	getAuthorName,
	getPostCategories,
	formatDate,
	estimateReadTime,
	stripHtml,
} from "../../lib/wordpress";
import { getBlogSEO, sanitizeContentImagesAlt } from "../../data/seo";

// 1. Grab the slug directly from the URL (No getStaticPaths needed in SSR)
const { slug } = Astro.params;

// 2. Fetch the exact post dynamically
const post = slug ? await getPostBySlug(slug) : null;

// 3. If the post doesn't exist, safely trigger a 404
if (!post) {
	return new Response(null, {
		status: 404,
		statusText: "Not found",
	});
}

// 4. Fetch all posts to generate the "Read Next" section
const allPosts = await getAllPosts();

const image = getFeaturedImage(post);
const categories = getPostCategories(post);
const author = getAuthorName(post);
const readTime = estimateReadTime(post.content.rendered);
const description = stripHtml(post.excerpt.rendered).slice(0, 160);
const title = stripHtml(post.title.rendered);

let related = allPosts.filter(
	(p) =>
		p.id !== post.id &&
		getPostCategories(p).some((c) =>
			categories.some((pc) => pc.slug === c.slug),
		),
);

// Fallback to latest posts if fewer than 3 related category posts exist
if (related.length < 3) {
	const otherPosts = allPosts.filter(
		(p) => p.id !== post.id && !related.some((r) => r.id === p.id),
	);
	related = [...related, ...otherPosts].slice(0, 3);
} else {
	related = related.slice(0, 3);
}

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Article",
	headline: title,
	image: image.src,
	datePublished: post.date,
	dateModified: post.modified,
	author: { "@type": "Organization", name: author },
	publisher: { "@type": "Organization", name: "Ira Spa" },
	mainEntityOfPage: `https://iraspa.in/blogs/${post.slug}/`,
};

const seo = getBlogSEO({
	title,
	excerpt: description,
	slug: post.slug,
	featuredImage: { src: image.src, alt: title },
	categories,
});
---

<Layout seo={seo}>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<article class="post">
		<header
			class="post-header page-banner"
			style={`background-image: url('${image.src}')`}
		>
			<div class="container">
				{
					categories[0] && (
						<span class="eyebrow">{categories[0].name}</span>
					)
				}
				<h1>{title}</h1>
				<div class="post-header__meta">
					<span>{author}</span>
					<span class="dot">&bull;</span>
					<span>{formatDate(post.date)}</span>
					<span class="dot">&bull;</span>
					<span>{readTime}</span>
				</div>
			</div>
		</header>

		<div class="container post__layout">
			<div class="post__grid">
				<div class="post__main">
					<div class="prose" set:html={sanitizeContentImagesAlt(post.content.rendered, title)} />

					<div class="post__nav-back">
						<a href="/blogs/" class="link-arrow post__back">
							<span>&larr;</span> Back to The Serenity Feed
						</a>
					</div>
				</div>

				<aside class="post__sidebar" aria-label="Article Sidebar">
					{
						related.length > 0 && (
							<section class="post__read-next">
								<div class="read-next__header">
									<span class="sidebar-eyebrow">Explore More</span>
									<h3 class="sidebar-heading">Read Next</h3>
								</div>
								<div class="read-next__list">
									{related.map((p) => (
										<BlogReadNextCard post={p} />
									))}
								</div>
							</section>
						)
					}

					<div class="post__sidebar-form">
						<BlogBookingForm />
					</div>
				</aside>
			</div>
		</div>
	</article>

	<Footer />
</Layout>

<style>
	.post-header {
		min-height: 42vh;
	}

	.post-header__meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgba(243, 239, 231, 0.65);
	}

	.dot {
		opacity: 0.5;
	}

	/* Main Layout Container: Aligned with header container */
	.post__layout {
		padding-block: var(--space-2xl) var(--space-3xl);
	}

	.post__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 400px;
		gap: clamp(2rem, 4vw, 3.5rem);
		align-items: stretch;
	}

	/* Main Article Column */
	.post__main {
		min-width: 0;
	}

	/* Make sure blog content & photos fill their column beautifully */
	.post__main :global(.prose) {
		max-width: 100%;
	}

	.post__main :global(.prose img),
	.post__main :global(.prose figure),
	.post__main :global(.prose .elementor-widget-image img) {
		width: 100%;
		max-width: 100%;
		height: auto;
		border-radius: var(--radius-md, 12px);
		margin-block: var(--space-md);
		display: block;
	}

	.post__main :global(.prose .elementor-widget-container) {
		margin: 0;
		padding: 0;
	}

	/* Hide any stray unstyled elementor CTAs in prose */
	.post__main :global(.prose .elementor-widget-call-to-action),
	.post__main :global(.prose .elementor-cta),
	.post__main :global(.prose .elementor-button-wrapper) {
		display: none !important;
	}

	.post__nav-back {
		margin-top: var(--space-2xl);
		padding-top: var(--space-lg);
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.post__back {
		display: inline-flex;
	}

	/* Right Sidebar */
	.post__sidebar {
		display: flex;
		flex-direction: column;
		gap: 2.75rem;
		height: 100%;
		position: relative;
	}

	.read-next__header {
		margin-bottom: 1.25rem;
		padding-bottom: 0.65rem;
		border-bottom: 1px solid rgba(207, 162, 60, 0.2);
	}

	.sidebar-eyebrow {
		display: block;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-accent, #cfa23c);
		margin-bottom: 0.3rem;
	}

	.sidebar-heading {
		font-family: var(--font-display, serif);
		font-size: 1.4rem;
		font-weight: 500;
		color: var(--color-text, #f3efe7);
		margin: 0;
	}

	.read-next__list {
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
	}

	/* Sticky booking form container */
	.post__sidebar-form {
		position: -webkit-sticky;
		position: sticky;
		top: calc(var(--header-height, 84px) + 1.25rem);
		z-index: 20;
		align-self: start;
		width: 100%;
	}

	/* Responsive Breakpoints */
	@media (max-width: 1024px) {
		.post__grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.post__sidebar {
			margin-top: 1rem;
		}

		.post__sidebar-form {
			position: static;
			max-height: none;
			overflow-y: visible;
		}

		.read-next__list {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 1rem;
		}
	}

	@media (max-width: 640px) {
		.read-next__list {
			grid-template-columns: 1fr;
		}
	}
</style>
