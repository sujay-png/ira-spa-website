---
import Layout from "../../../../layouts/Layout.astro";
import Footer from "../../../../components/Footer.astro";
import PostGrid from "../../../../components/blogs/PostGrid.astro";
import { getAllPosts, getCategories, getPostCategories, POSTS_PER_PAGE } from "../../../../lib/wordpress";
import { getBlogCategorySEO } from "../../../../data/seo";

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=3600');

const { category } = Astro.params;
const categories = await getCategories();
const currentCat = categories.find((c) => c.slug === category);

if (!currentCat) {
	return Astro.redirect("/blogs/");
}

const allPosts = await getAllPosts();
const posts = allPosts.filter((p) => getPostCategories(p).some((c) => c.slug === category));
const pagePosts = posts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const categoryName = currentCat.name;
const seo = getBlogCategorySEO(categoryName, category || "blog");
---

<Layout seo={seo}>
	<section class="page-banner" style="background-image: url('/images/spa-treatment.webp');">
		<div class="container">
			<span class="eyebrow">Journal Category</span>
			<h1>{categoryName}</h1>
			<p>Articles filed under {categoryName.toLowerCase()}.</p>
		</div>
	</section>

	<PostGrid
		posts={pagePosts}
		categories={categories}
		activeCategorySlug={category}
		currentPage={1}
		totalPages={totalPages}
		basePath={`/blogs/category/${category}`}
	/>

	<Footer />
</Layout>
