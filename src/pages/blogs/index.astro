---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import JournalHero from "../../components/blogs/JournalHero.astro";
import PostGrid from "../../components/blogs/PostGrid.astro";
import { getAllPosts, getCategories, getFeaturedImage, POSTS_PER_PAGE } from "../../lib/wordpress";
import { getSEO } from "../../data/seo";
import { getImage } from "astro:assets";

Astro.response.headers.set('Cache-Control', 'public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800');

const [allPosts, categories] = await Promise.all([getAllPosts(), getCategories()]);

const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const featured = allPosts[0];
const pagePosts = allPosts.slice(0, POSTS_PER_PAGE);
const seo = getSEO("/blogs/");
const featuredImage = featured ? getFeaturedImage(featured) : null;
const heroImageUrl = featuredImage ? (featuredImage.large || featuredImage.src) : undefined;

let preloadConfig = undefined;
if (heroImageUrl) {
	if (heroImageUrl.startsWith("http")) {
		const optimizedPreload = await getImage({
			src: heroImageUrl,
			widths: [380, 600, 960, 1200],
			sizes: "100vw",
			width: 1200,
			height: 700,
			format: "webp",
			quality: 72,
		});
		preloadConfig = {
			src: optimizedPreload.src,
			srcset: optimizedPreload.srcSet.attribute,
			sizes: "100vw",
			type: "image/webp",
		};
	} else {
		preloadConfig = {
			src: heroImageUrl,
			srcset: featuredImage?.srcset,
			sizes: "100vw",
		};
	}
}
---

<Layout
	seo={seo}
	preloadImage={preloadConfig}
>
	{featured && <JournalHero post={featured} />}

	<PostGrid
		posts={pagePosts}
		categories={categories}
		currentPage={1}
		totalPages={totalPages}
		basePath="/blogs"
	/>

	<Footer />
</Layout>
