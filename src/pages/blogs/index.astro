---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import JournalHero from "../../components/blogs/JournalHero.astro";
import PostGrid from "../../components/blogs/PostGrid.astro";
import { getAllPosts, getCategories, POSTS_PER_PAGE } from "../../lib/wordpress";

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=3600');

const allPosts = await getAllPosts();
const categories = await getCategories();

const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const featured = allPosts[0];
const pagePosts = allPosts.slice(0, POSTS_PER_PAGE);
---

<Layout
	title="Ira Spa | Blogs and Articales"
	description="Read the latest wellness articles and spa tips from Ira Spa in Mangalore. Stay informed on massage benefits, self-care routines, skin treatments, and more."
>
	{featured && <JournalHero post={featured} />}

	<PostGrid
		posts={pagePosts}
		categories={categories}
		currentPage={1}
		totalPages={totalPages}
		basePath="/blogs"
	/>

	<Footer />
</Layout>
