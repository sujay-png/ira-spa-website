---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/Appointment/pageHero.astro";
import BookAppointment from "../../components/Appointment/BookAppointment.astro";
import WhatToExpect from "../../components/Appointment/whatToExpect.astro";
import Properritual from "../../components/Appointment/properritual.astro";
import Footer from "../../components/Footer.astro";
import { getSEO } from "../../data/seo";

const rawService = Astro.url.searchParams.get("service");
if (rawService && (rawService.includes(" ") || rawService.trim() !== rawService || rawService !== rawService.toLowerCase())) {
	const cleaned = rawService.trim().toLowerCase().replace(/\s+/g, "-");
	return Astro.redirect(`/book-an-appointment/?service=${encodeURIComponent(cleaned)}`, 301);
}

const seo = getSEO("/book-an-appointment/");
---

<Layout seo={seo}>
	<PageHero />
	<BookAppointment />
	<WhatToExpect />
	<Properritual />
	<Footer />
</Layout>
