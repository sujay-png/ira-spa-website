---
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import BookingsFormAstroComponent from "../components/Home/bookings_form.astro";
import Aboutspa from "../components/Home/Aboutspa.astro"
import HowItWorks from "../components/Home/HowItWorks.astro";
import Services from "../components/Home/Services-list.astro";
import MenuList from "../components/Home/MenuList.astro";
import Customerreview from "../components/Home/Customerreview.astro";
import "../style/global.scss";
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro"
---

<Layout>
	<div class="hero" id="hero-section">
		<div class="hero-text">
			<p class="tagline">
				Relax, Rejuvenate, and Restore Your Well-Being With Every Touch.
			</p>
			<h1>Ira Spa Beauty</h1>
			<Button text="Book Now" href="/BookAnAppointment/Appointment" />
		</div>
	</div>
	<div>
		<BookingsFormAstroComponent />
		<Aboutspa/>
		<HowItWorks/>
		<Services/>
		<MenuList/>
		<Customerreview/>
		<Footer/>

		
	</div>
</Layout>
<style>
	.hero {
		position: relative;
		width: 100%;
		min-height: 600px;
		height: 100vh;
		max-height: 900px;
		background-image: url("https://iraspa.in/wp-content/uploads/2026/06/attractive-african-woman-enjoying-face-massage-spa-salon.jpg-1-scaled.jpeg");
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		background-attachment: fixed;
		overflow: hidden;
		transition: opacity 0.1s linear, height 0.1s linear;
		margin-top: 60px;
		
		@media (max-width: 768px) {
			background-attachment: scroll;
			height: 500px;
			min-height: 500px;
			max-height: 600px;
			margin-top: 50px;
		}
		
		@media (max-width: 480px) {
			height: 400px;
			min-height: 400px;
			max-height: 500px;
			margin-top: 45px;
		}
	}

	.hero::before {
		content: "";
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.35);
		z-index: 1;
	}
	
	.hero::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to bottom,
			rgba(0, 0, 0, 0) 0%,
			rgba(0, 0, 0, 0.5) 60%,
			rgba(0, 0, 0, 0.9) 100%
		);
		pointer-events: none;
		z-index: 2;
	}

	.hero-text {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		z-index: 3;
		text-align: center;
		color: white;
		width: 100%;
		max-width: 800px;
		padding: 0 2rem;
		box-sizing: border-box;
	}

	.tagline {
		font-family: "Poppins", sans-serif;
		font-size: clamp(14px, 3vw, 20px);
		text-transform: uppercase;
		color: #ffffff;
		letter-spacing: 2px;
		font-weight: 500;
		margin-bottom: 1rem;
		animation: fadeInUp 0.8s ease 0.3s both;
	}

	.hero-text h1 {
		font-family: "Georgia", serif;
		font-size: clamp(48px, 8vw, 90px);
		color: #ffffff;
		margin-bottom: 1.5rem;
		letter-spacing: -2px;
		line-height: 1.1;
		animation: fadeInUp 0.8s ease 0.5s both;
		font-weight: 700;
	}
	
	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.book-btn {
		display: inline-block;
		background-color: #cfa23c;
		color: white;
		font-family: "Poppins", sans-serif;
		font-size: 0.9em;
		font-weight: 700;
		letter-spacing: 1px;
		text-transform: uppercase;
		padding: 12px 28px;
		border-radius: 2px;
		text-decoration: none;
		margin-top: 20px;
	}

	.book-btn:hover {
		background-color: #b88f32;
	}
</style>

<script>
	const hero = document.getElementById('hero-section') as HTMLElement | null;
	const maxHeight = 500; // must match the .hero height in CSS
	let ticking = false;

	function updateHero() {
		const scrollY = window.scrollY;

		if (!hero) {
			ticking = false;
			return;
		}

		if (scrollY > 0 && scrollY < maxHeight) {
			const progress = scrollY / maxHeight; // 0 to 1
			const newHeight = maxHeight * (1 - progress);
			hero.style.height = newHeight + 'px';
			hero.style.opacity = String(1 - progress);
		} else if (scrollY >= maxHeight) {
			hero.style.height = '0px';
			hero.style.opacity = '0';
		} else {
			hero.style.height = maxHeight + 'px';
			hero.style.opacity = '1';
		}
		ticking = false;
	}

	window.addEventListener('scroll', () => {
		if (!ticking) {
			requestAnimationFrame(updateHero);
			ticking = true;
		}
	});
</script>