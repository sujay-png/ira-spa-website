---
import Layout from "../layouts/Layout.astro";
import BookingsForm from "../components/Home/bookings_form.astro";
import Aboutspa from "../components/Home/Aboutspa.astro";
import TrustIndicators from "../components/Home/TrustIndicators.astro";
import HowItWorks from "../components/Home/HowItWorks.astro";
import Benefits from "../components/Home/list.astro";
import Services from "../components/Home/Services-list.astro";
import MenuList from "../components/Home/MenuList.astro";
import Customerreview from "../components/Home/Customerreview.astro";
import InstagramFeed from "../components/Home/InstagramFeed.astro";
import HomeBlogs from "../components/Home/HomeBlogs.astro";
import Footer from "../components/Footer.astro";
import heroImg from "../images/serviceimage1.webp";
---

<Layout
	image="src/images/logo.webp"
	title="Ira Spa | Luxury Massage & Wellness Spa in Mangalore & Kalaburgi"
	description="Relax, rejuvenate and restore at Ira Spa — premium massage therapy, herbal treatments and body rituals in Mangalore and Kalaburagi. Book your session online."
>
	<section class="hero" id="hero-section">
		<img
			src={heroImg.src}
			alt="Luxury Spa and Massage Treatment in Mangalore"
			fetchpriority="high"
			loading="eager"
			class="hero__bg-image"
		/>
		<div class="hero__scrim" aria-hidden="true"></div>
		<div class="hero__content">
			<span class="eyebrow hero__eyebrow">Mangalore &amp; Kalaburgi</span>
			<h1 class="hero__title">
				Luxury Spa Massage Therapies <br /><em>in Mangalore</em>
			</h1>
			<p class="hero__tagline">Ira Spa Beauty</p>
			<a href="/ourservice" class="btn-primary">Explore Services</a>
		</div>
	</section>

	<BookingsForm />
	<Aboutspa />
	<TrustIndicators />
	<HowItWorks />
	<Benefits />
	<Services />
	<MenuList />
	<Customerreview />
	<InstagramFeed />
	<HomeBlogs />
	<Footer />
</Layout>

<style>
	.hero {
		position: relative;
		width: 100%;
		height: 92vh;
		min-height: 560px;
		max-height: 920px;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.hero__bg-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
	}

	.hero__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to bottom,
			rgba(11, 11, 10, 0.55) 0%,
			rgba(11, 11, 10, 0.35) 35%,
			rgba(11, 11, 10, 0.92) 100%
		);
	}

	.hero__content {
		position: relative;
		z-index: 1;
		text-align: center;
		max-width: 760px;
		padding: 0 1.5rem;
	}

	.hero__eyebrow {
		color: var(--color-accent-soft);
		margin-bottom: var(--space-sm);
	}

	.hero__title {
		font-size: clamp(2.6rem, 3vw, 5.5rem);
		color: #fff;
		margin-bottom: var(--space-md);
		white-space: nowrap;

		em {
			font-style: italic;
			color: var(--color-accent-soft);
		}
	}

	.hero__tagline {
		font-family: var(--font-body);
		font-size: var(--font-size-lg);
		color: rgba(255, 255, 255, 0.82);
		max-width: 520px;
		margin: 0 auto var(--space-lg);
		line-height: 1.7;
	}

	@media (max-width: 768px) {
		.hero {
			height: 82vh;
			min-height: 460px;
		}
	}
</style>
