---

<Layout
	seo={seo}
	preloadImage={{
		src: heroPreload.src,
		srcset: heroPreload.srcSet.attribute,
		sizes: "100vw",
		type: "image/webp",
	}}
>
	<section class="hero" id="hero-section">
		<Image
			src={heroImg}
			alt="Luxury Spa and Massage Treatment in Mangalore"
			widths={[380, 580, 768, 1024, 1200]}
			sizes="100vw"
			width={1200}
			height={800}
			fetchpriority="high"
			loading="eager"
			decoding="async"
			class="hero__bg-image"
		/>
		<div class="hero__scrim" aria-hidden="true"></div>
		<div class="hero__content">
			<span class="eyebrow hero__eyebrow">Mangalore &amp; Kalaburgi</span>
			<h1 class="hero__title">
				Luxury Spa Massage Therapies <br /><em>in Mangalore</em>
			</h1>
			<p class="hero__tagline">Ira Spa Beauty</p>
			<a href="/ourservice/" class="btn-primary">Explore Services</a>
		</div>
	</section>

    <BookingsForm />
    <Aboutspa />
    <TrustIndicators />
    <HowItWorks />
    <Benefits />
    <Services />
    <MenuList />    
    <MomCareSection />
    <Customerreview />
    <Accordion />
    <InstagramFeed />
    <HomeBlogs />
    <Footer />
    <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
</Layout>

<style>
    .hero {
        position: relative;
        width: 100%;
        height: 92vh;
        min-height: 560px;
        max-height: 920px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .hero__bg-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
    }

    .hero__scrim {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            rgba(11, 11, 10, 0.55) 0%,
            rgba(11, 11, 10, 0.35) 35%,
            rgba(11, 11, 10, 0.92) 100%
        );
    }

    .hero__content {
        position: relative;
        z-index: 1;
        text-align: center;
        max-width: 760px;
        padding: 0 1.5rem;
    }

    .hero__eyebrow {
        color: var(--color-accent-soft);
        margin-bottom: var(--space-sm);
    }

    .hero__title {
        /* Allow normal wrapping on mobile */
        white-space: normal;
        /* Lower base min-size and responsive scaling */
        font-size: clamp(1.85rem, 5vw + 1rem, 4.5rem);
        line-height: 1.2;
        color: #fff;
        margin-bottom: var(--space-md);

        em {
            font-style: italic;
            color: var(--color-accent-soft);
        }
    }

    .hero__tagline {
        font-family: var(--font-body);
        font-size: var(--font-size-lg);
        color: rgba(255, 255, 255, 0.82);
        max-width: 520px;
        margin: 0 auto var(--space-lg);
        line-height: 1.7;
    }

    @media (max-width: 768px) {
        .hero {
            height: 82vh;
            min-height: 460px;
        }

        .hero__title {
            font-size: clamp(1.75rem, 6vw, 2.5rem);
        }
    }
</style>
