---
import Layout from "../layouts/Layout.astro";
import BookingsForm from "../components/Home/bookings_form.astro";
import Aboutspa from "../components/Home/Aboutspa.astro";
import HowItWorks from "../components/Home/HowItWorks.astro";
import Benefits from "../components/Home/list.astro";
import Services from "../components/Home/Services-list.astro";
import MenuList from "../components/Home/MenuList.astro";
import Customerreview from "../components/Home/Customerreview.astro";
import Footer from "../components/Footer.astro";
---

<Layout
	title="Ira Spa | Luxury Massage & Wellness Spa in Mangalore & Kalaburagi"
	description="Relax, rejuvenate and restore at Ira Spa — premium massage therapy, herbal treatments and body rituals in Mangalore and Kalaburagi. Book your session online."
>
	<section class="hero" id="hero-section">
		<div class="hero__scrim" aria-hidden="true"></div>
		<div class="hero__content">
			<span class="eyebrow hero__eyebrow">Mangalore &amp; Kalaburagi</span>
			<h1 class="hero__title">
				Relax, Rejuvenate<br /><em>&amp; Restore</em>
			</h1>
			<p class="hero__tagline">
				A sanctuary for the senses — curated massage therapy and holistic
				rituals designed to bring mind, body and spirit back into balance.
			</p>
			<a href="/BookAnAppointment" class="btn-primary">Book Your Ritual</a>
		</div>
	</section>

	<BookingsForm />
	<Aboutspa />
	<HowItWorks />
	<Benefits />
	<Services />
	<MenuList />
	<Customerreview />
	<Footer />
</Layout>

<style>
	.hero {
		position: relative;
		width: 100%;
		height: 92vh;
		min-height: 560px;
		max-height: 920px;
		background-image: url("https://iraspa.in/wp-content/uploads/2026/06/attractive-african-woman-enjoying-face-massage-spa-salon.jpg-1-scaled.jpeg");
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero__scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to bottom, rgba(11, 11, 10, 0.55) 0%, rgba(11, 11, 10, 0.35) 35%, rgba(11, 11, 10, 0.92) 100%);
	}

	.hero__content {
		position: relative;
		z-index: 1;
		text-align: center;
		max-width: 760px;
		padding: 0 1.5rem;
	}

	.hero__eyebrow {
		color: var(--color-accent-soft);
		margin-bottom: var(--space-sm);
	}

	.hero__title {
		font-size: clamp(2.6rem, 7vw, 5.5rem);
		color: #fff;
		margin-bottom: var(--space-md);

		em {
			font-style: italic;
			color: var(--color-accent-soft);
		}
	}

	.hero__tagline {
		font-family: var(--font-body);
		font-size: var(--font-size-lg);
		color: rgba(255, 255, 255, 0.82);
		max-width: 520px;
		margin: 0 auto var(--space-lg);
		line-height: 1.7;
	}

	@media (max-width: 768px) {
		.hero {
			height: 82vh;
			min-height: 460px;
		}
	}
</style>
