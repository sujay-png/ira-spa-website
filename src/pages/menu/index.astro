---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
	title="Menu | Ira Spa"
	description="Explore our range of wellness treatments, threading, facials, and clean ups at Ira Spa."
>
	<section class="page-banner" style="background-image: url('/images/spa-treatment.jpg');">
		<div class="container">
			<span class="eyebrow">Services</span>
		    <h1><em class="italic-serif">Ira</em> Spa Menu</h1>
		</div>
	</section>

	<section class="menu-page">
		<div class="container">
			<div class="menu-category">
				<h2 class="category-title">FACIAL / CLEAN UPS</h2>
				<ul class="menu-list">
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">WATERMELON</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹700</span>
						</div>
						<div class="menu-item-desc">30 minute sessions</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">STRAWBERRY</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹800</span>
						</div>
						<div class="menu-item-desc">30 Minute Sessions</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">HYDRA DEW (DRY & DEHYDRATED)</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹1000</span>
						</div>
						<div class="menu-item-desc">45 Minute Sessions</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">REJUVENATING (ALL SKIN TYPE)</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹1200</span>
						</div>
						<div class="menu-item-desc">45 Minute Sessions</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">HERBAL PEARL</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹2000</span>
						</div>
						<div class="menu-item-desc">45 Minute Sessions</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">DEEP PORE CLEANSING (OILY SKIN)</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹2400</span>
						</div>
						<div class="menu-item-desc">60 Minute Sessions</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">WHITENING FACIAL (DULL & UNEVEN SKIN TONE)</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹2500</span>
						</div>
						<div class="menu-item-desc">60 Minute Sessions</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">HERBAL GOLD</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹3500</span>
						</div>
						<div class="menu-item-desc">60 Minute Sessions</div>
					</li>
				</ul>
			</div>

			<div class="menu-category">
				<h2 class="category-title">QUICK THERAPY</h2>
				<ul class="menu-list">
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">FOOT REFLEXOLOGY</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹1200</span>
						</div>
						<div class="menu-item-desc">30 minute sessions</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">BACK (WITHOUT SHOWER)</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹1600</span>
						</div>
						<div class="menu-item-desc">30 Minute Sessions</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">HEAD, NECK & SHOULDER</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹1300</span>
						</div>
						<div class="menu-item-desc">30 Minute Sessions</div>
					</li>
				</ul>
			</div>

			<div class="menu-category">
				<h2 class="category-title">THREADING</h2>
				<ul class="menu-list">
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">THREADING</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹50</span>
						</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">UPPER LIP</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹30</span>
						</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">CHIN</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹20</span>
						</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">FULL FACE</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹150</span>
						</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">WARTS REMOVING</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹50</span>
						</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">WAXING HALF LEG</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹800</span>
						</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">HAND</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹600</span>
						</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">FACE</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹200</span>
						</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">DE TAN</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹200</span>
						</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">CLEAN UP (STARTING)</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹300</span>
						</div>
					</li>
					<li class="menu-item">
						<div class="menu-item-row">
							<span class="menu-item-name">CLEANUP + DETAN</span>
							<div class="menu-item-line"></div>
							<span class="menu-item-price">₹400</span>
						</div>
					</li>
				</ul>
			</div>

		</div>
	</section>

	<Footer />
</Layout>

<style>
	.menu-page {
		padding: var(--space-2xl) 0;
	}
	.menu-category {
		margin-bottom: 4rem;
		max-width: 800px;
		margin-left: auto;
		margin-right: auto;
	}
	.category-title {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		letter-spacing: var(--eyebrow-tracking);
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin-bottom: var(--space-lg);
		border-bottom: 1px solid var(--color-border);
		padding-bottom: var(--space-sm);
	}
	.menu-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.menu-item {
		margin-bottom: var(--space-md);
	}
	.menu-item-row {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		width: 100%;
	}
	.menu-item-name {
		font-family: var(--font-body);
		font-size: var(--font-size-base);
		color: var(--color-text);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		white-space: nowrap;
	}
	.menu-item-line {
		flex-grow: 1;
		height: 1px;
		background-color: var(--color-accent);
		opacity: 0.3;
	}
	.menu-item-price {
		font-family: var(--font-body);
		font-size: var(--font-size-base);
		color: var(--color-text);
		font-weight: 500;
		white-space: nowrap;
	}
	.menu-item-desc {
		font-family: var(--font-body);
		font-size: clamp(0.75rem, 0.2vw + 0.7rem, 0.85rem);
		color: var(--color-text-faint);
		margin-top: var(--space-3xs);
	}

	@media (max-width: 768px) {
		.menu-item-row {
			gap: var(--space-xs);
		}
		.menu-item-name,
		.menu-item-price {
			font-size: var(--font-size-sm);
		}
	}
</style>

