---
import Layout from "../../layouts/Layout.astro";
import ServiceType from "../../components/services/ServiceType.astro";
import ServiceDescription from "../../components/services/service_description.astro";
import MenuList from "../../components/Home/MenuList.astro";
import Footer from "../../components/Footer.astro";
import { serviceData } from "../../data/services";
import { getSEO } from "../../data/seo";
import { Image, getImage } from "astro:assets";
import bannerImg from "../../images/spa-treatment.webp";

const seo = getSEO("/ourservice/");

const bannerPreload = await getImage({
	src: bannerImg,
	widths: [493, 768, 1200],
	sizes: "100vw",
	width: 1200,
	height: 800,
	format: "webp",
});
---

<Layout
	seo={seo}
	preloadImage={{
		src: bannerPreload.src,
		srcset: bannerPreload.srcSet.attribute,
		sizes: "100vw",
		type: "image/webp",
	}}
>
	<section class="page-banner">
		<Image
			src={bannerImg}
			alt=""
			class="page-banner__bg-image"
			widths={[493, 768, 1200]}
			sizes="100vw"
			width={1200}
			height={800}
			format="webp"
			fetchpriority="high"
			loading="eager"
			decoding="async"
		/>
		<div class="container">
			<h1>{seo.pageTitle}</h1>
			<p>Ira Spa offers a range of massage and beauty spa therapy</p>
		</div>
	</section>

	<ServiceType />

	<div class="ritual-showcase">
		{
			Object.entries(serviceData).map(([slug, service], i) => (
				<ServiceDescription {...service} slug={slug} reverse={i % 2 === 1} />
			))
		}
	</div>

	<MenuList />
	<Footer />
</Layout>

<style>
	@media (max-width: 768px) {
		.page-banner {
			width: 100%;
			max-width: 100%;
			box-sizing: border-box;
			overflow: hidden;
		}

		.page-banner .container {
			width: 100%;
			max-width: 100%;
			padding-inline: 16px;
			box-sizing: border-box;
		}

		.page-banner h1 {
			width: 100%;
			max-width: 100%;
			font-size: clamp(1.75rem, 6.5vw, 2.25rem);
			word-wrap: break-word;
			overflow-wrap: break-word;
			box-sizing: border-box;
		}

		.page-banner p {
			width: 100%;
			max-width: 100%;
			font-size: 1rem;
			word-wrap: break-word;
			overflow-wrap: break-word;
			box-sizing: border-box;
		}
	}
</style>
