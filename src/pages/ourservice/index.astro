---
import Layout from "../../layouts/Layout.astro";
import ServiceType from "../../components/services/ServiceType.astro";
import ServiceDescription from "../../components/services/service_description.astro";
import MenuList from "../../components/Home/MenuList.astro";
import Footer from "../../components/Footer.astro";
import { serviceData } from "../../data/services";
---

<Layout
	title="Ira Spa | Spa Therapy Service in Mangalore"
	description="Discover a complete range of relaxation rituals at Ira Spa. From expert body massages and Thai therapies to refreshing facials and foot spas. Book your session."
>
	<section class="page-banner" style="background-image: url('/images/spa-treatment.jpg');">
		<div class="container">
			
			<h1>Best Spa Services</h1>
			<p>Ira Spa offers a range of massage and beauty spa therapy</p>
		</div>
	</section>

	<ServiceType />

	<div class="ritual-showcase">
		{
			Object.entries(serviceData).map(([slug, service], i) => (
				<ServiceDescription {...service} slug={slug} reverse={i % 2 === 1} />
			))
		}
	</div>

	<MenuList />
	<Footer />
</Layout>
