---
import Layout from "../../layouts/Layout.astro";
import ServiceType from "../../components/services/ServiceType.astro";
import ServiceDescription from "../../components/services/service_description.astro";
import MenuList from "../../components/Home/MenuList.astro";
import Footer from "../../components/Footer.astro";
import { serviceData } from "../../data/services";
import { getSEO } from "../../data/seo";

const seo = getSEO("/ourservice/");
---

<Layout seo={seo}>
	<section class="page-banner" style={`background-image: url('${seo.image}');`}>
		<div class="container">
			
			<h1>{seo.pageTitle}</h1>
			<p>Ira Spa offers a range of massage and beauty spa therapy</p>
		</div>
	</section>

	<ServiceType />

	<div class="ritual-showcase">
		{
			Object.entries(serviceData).map(([slug, service], i) => (
				<ServiceDescription {...service} slug={slug} reverse={i % 2 === 1} />
			))
		}
	</div>

	<MenuList />
	<Footer />
</Layout>
