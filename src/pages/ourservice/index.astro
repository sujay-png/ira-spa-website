---
import Layout from "../../layouts/Layout.astro";
import ServiceType from "../../components/services/ServiceType.astro";
import ServiceDescription from "../../components/services/service_description.astro";
import MenuList from "../../components/Home/MenuList.astro";
import Footer from "../../components/Footer.astro";
import { serviceData } from "../../data/services";
---

<Layout
	title="Rituals & Services | Ira Spa Massage Treatments"
	description="Explore Ira Spa's full menu of rituals — body massage, herbal therapy, body polishing and foot spa treatments in Mangalore and Kalaburagi, with transparent pricing."
>
	<section class="page-banner" style="background-image: url('/images/spa-treatment.jpg');">
		<div class="container">
			<span class="eyebrow">Curated Treatments</span>
			<h1>Our Rituals</h1>
			<p>A collection of somatic therapies designed to harmonize touch, scent and stillness.</p>
		</div>
	</section>

	<ServiceType />

	<div class="ritual-showcase">
		{
			Object.entries(serviceData).map(([slug, service], i) => (
				<ServiceDescription {...service} slug={slug} reverse={i % 2 === 1} />
			))
		}
	</div>

	<MenuList />
	<Footer />
</Layout>
