---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import "../../style/servicedetail.css";
import { getSEO } from "../../data/seo";

const seo = getSEO("/ourservice/lomi-lomi-massage/");

const treatments = [
    {
        slug: "lomi-lomi-massage",
        name: "Lomi Lomi Massage",
        category: "Hawaiian Ritual",
        description:
            "A traditional Hawaiian massage using long, flowing strokes to release deep muscle tension, improve circulation and bring calm to body and mind. This restorative therapy combines gentle stretches, rhythmic pressure and soothing aromatic oils for full-body renewal.",
        image: "/images/lomi-lomi.webp",
        alt: "Lomi Lomi massage therapy at Ira Spa",
        prices: [
            { label: "60 min", price: "₹3,000" },
            { label: "90 min", price: "₹4,500" },
        ],
    },
];
---

<Layout seo={seo}>
    <section
        class="page-banner"
        style={`background-image: url('/images/spa-salon.jpg');`}
    >
        <div class="container">
            <span class="eyebrow">Hawaiian Ritual</span>
            <h1>Lomi Lomi Massage in Mangalore & Kalaburagi</h1>
            <p>
                Experience authentic Hawaiian Lomi Lomi massage therapy. Flowing rhythmic strokes designed to soothe sore muscles, enhance energy flow and restore complete harmony.
            </p>
        </div>
    </section>

    <section class="treatments">
        <div class="container">
            {
                treatments.map((treatment, i) => (
                    <div
                        class={`treatment-row ${i % 2 === 1 ? "reverse" : ""}`}
                        id={treatment.slug}
                    >
                        <div class="treatment-image">
                            <img
                                src={treatment.image}
                                alt={treatment.alt || treatment.name}
                                width="600"
                                height="420"
                                loading="lazy"
                            />
                        </div>
                        <div class="treatment-content">
                            <span class="eyebrow">{treatment.category}</span>
                            <h2>{treatment.name}</h2>
                            <p class="description">{treatment.description}</p>

                            <div class="divider" />

                            <div class="price-row">
                                {treatment.prices.map((p) => (
                                    <div class="price-col">
                                        <span class="price-label">
                                            {p.label}
                                        </span>
                                        <span class="price-value">
                                            {p.price}
                                        </span>
                                    </div>
                                ))}
                            </div>

                            <div class="divider" />
                            <a
                                class="book-btn"
                                href={`/book-an-appointment/?service=${treatment.slug}`}
                            >
                                Book This Service
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <Footer />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Service",
      "name": "Ira Spa - Lomi Lomi Massage",
      "serviceType": "Lomi Lomi Massage",
      "description": "Authentic Hawaiian Lomi Lomi Massage in Mangalore and Kalaburagi.",
      "provider": {
        "@type": "DaySpa",
        "name": "Ira Spa"
      },
      "areaServed": ["Mangalore", "Kalaburagi"]
    }
    </script>
</Layout>
