---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import { quickMassageTreatments } from "../../data/quickmassage";
import "../../style/servicedetail.css";



const treatments = quickMassageTreatments;
---

<Layout
    title="Quick Massage | Ira Spa Rituals"
    description="Express rituals for relaxing and de-stressing — Foot Reflexology, Back, and Head, Neck & Shoulder massage."
    image="/images/spa-salon.jpg"
>
    <section class="page-banner" style={`background-image: url('/images/spa-salon.jpg');`}>
        <div class="container">
            <span class="eyebrow">Express Rituals</span>
            <h1>Quick Massage</h1>
            <p>
                A soothing massage using different kinds of essential oils for
                relaxing and de-stressing.
            </p>
        </div>
    </section>

    <section class="treatments">
        <div class="container">
            {treatments.map((treatment, i) => (
                <div class={`treatment-row ${i % 2 === 1 ? "reverse" : ""}`} id={treatment.slug}>
                    <div class="treatment-image">
                        <img src={treatment.image} alt={treatment.name} loading="lazy" />
                    </div>
                    <div class="treatment-content">
                        <span class="eyebrow">{treatment.category}</span>
                        <h2>{treatment.name}</h2>
                        {treatment.subtitle && (
                            <p class="treatment-subtitle">{treatment.subtitle}</p>
                        )}
                        {treatment.description && (
                            <p class="description">{treatment.description}</p>
                        )}

                        <div class="divider"></div>

                        <div class="price-row">
                            {treatment.prices.map((p) => (
                                <div class="price-col">
                                    <span class="price-label">{p.label}</span>
                                    <span class="price-value">{p.price}</span>
                                </div>
                            ))}
                        </div>

                        <div class="divider"></div>

                        <a class="book-btn" href={`/book?service=${treatment.slug}`}>
                            Book This Ritual
                        </a>
                    </div>
                </div>
            ))}
        </div>
    </section>

    <Footer />
</Layout>
