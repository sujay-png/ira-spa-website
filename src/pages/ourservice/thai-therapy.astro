---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import { thaiTherapyTreatments } from "../../data/ThaiTheraphy";
import "../../style/servicedetail.css";

const treatments = thaiTherapyTreatments;
---

<Layout
    title="Thai Therapy | Ira Spa Rituals"
    description="An ancient healing system combining acupressure, energy line work and assisted yoga postures — Traditional Thai Therapy and Bamboo Therapy."
    image="/images/spa-salon.jpg"
>
    <section class="page-banner" style={`background-image: url('/images/spa-salon.jpg');`}>
        <div class="container">
            <span class="eyebrow">Signature Therapies</span>
            <h1>Thai Therapy</h1>
            <p>
                An ancient healing system that combines broad and targeted
                acupressure, stimulation and manipulation of energy lines and
                assisted yoga postures.
            </p>
        </div>
    </section>

    <section class="treatments">
        <div class="container">
            {treatments.map((treatment, i) => (
                <div class={`treatment-row ${i % 2 === 1 ? "reverse" : ""}`} id={treatment.slug}>
                    <div class="treatment-image">
                        <img src={treatment.image} alt={treatment.name} loading="lazy" />
                    </div>
                    <div class="treatment-content">
                     
                        <h2>{treatment.name}</h2>
                        <p class="description">{treatment.description}</p>

                        <div class="divider"></div>

                        <div class="price-row">
                            {treatment.prices.map((p) => (
                                <div class="price-col">
                                    <span class="price-label">{p.label}</span>
                                    <span class="price-value">{p.price}</span>
                                </div>
                            ))}
                        </div>

                        <div class="divider"></div>

                        <a class="book-btn" href={`/book?service=${treatment.slug}`}>
                            Book This Service
                        </a>
                    </div>
                </div>
            ))}
        </div>
    </section>

    <Footer />
</Layout>
