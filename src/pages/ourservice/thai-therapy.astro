---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import { thaiTherapyTreatments } from "../../data/ThaiTheraphy";
import "../../style/servicedetail.css";
import { getSEO } from "../../data/seo";

const seo = getSEO("/ourservice/thai-therapy/");
const treatments = thaiTherapyTreatments;
---

<Layout seo={seo}>
    <section
        class="page-banner"
        style={`background-image: url('/images/spa-salon.webp');`}
    >
        <div class="container">
            <span class="eyebrow">Signature Therapies</span>
            <h1>Thai Therapy in Mangalore & Kalaburagi</h1>
            <p>
                An ancient healing system that combines broad and targeted
                acupressure, stimulation and manipulation of energy lines and
                assisted yoga postures.
            </p>
        </div>
    </section>

    <section class="treatments">
        <div class="container">
            {
                treatments.map((treatment, i) => (
                    <div
                        class={`treatment-row ${i % 2 === 1 ? "reverse" : ""}`}
                        id={treatment.slug}
                    >
                        <div class="treatment-image">
                            <img
                                src={treatment.image}
                                alt={treatment.name}
                                width="600"
                                height="420"
                                loading="lazy"
                            />
                        </div>
                        <div class="treatment-content">
                            <h2>{treatment.name}</h2>
                            <p class="description">{treatment.description}</p>

                            <div class="divider" />

                            <div class="price-row">
                                {treatment.prices.map((p) => (
                                    <div class="price-col">
                                        <span class="price-label">
                                            {p.label}
                                        </span>
                                        <span class="price-value">
                                            {p.price}
                                        </span>
                                    </div>
                                ))}
                            </div>

                            <div class="divider" />

                            <a
                                class="book-btn"
                                href={`/book-an-appointment/?service=${treatment.slug}`}
                            >
                                Book This Service
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <Footer />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Service",
      "serviceType": "Thai Therapy",
      "provider": {
        "@type": "DaySpa",
        "name": "Ira Spa"
      },
      "areaServed": ["Mangalore", "Kalaburagi"]
    }
    </script>
</Layout>
