---
import Layout from "../../layouts/Layout.astro";
import ServiceDescription from "../../components/services/service_description.astro";
import Footer from "../../components/Footer.astro";
import { serviceData } from "../../data/services";
import { getServiceSEO } from "../../data/seo";

export const prerender = true;
export function getStaticPaths() {
    // Optional safety check to prevent passing undefined to Object.keys
    if (!serviceData || typeof serviceData !== "object") {
        return [];
    }
    return Object.keys(serviceData).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const service = slug ? serviceData[slug as keyof typeof serviceData] : null;

if (!service) {
    return Astro.redirect("/ourservice/");
}

const seo = getServiceSEO(slug, service);
---

<Layout seo={seo}>
    <section class="page-banner" style={`background-image: url('${seo.image}');`}>
        <div class="container">
            <span class="eyebrow">{seo.eyebrow}</span>
            <h1>{seo.pageTitle}</h1>
            <p>{seo.seoDescription}</p>
        </div>
    </section>

    <ServiceDescription {...service} />
    <Footer />
</Layout>